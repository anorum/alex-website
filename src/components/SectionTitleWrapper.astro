---
const { standardTitle, rpgTitle } = Astro.props;
---

<div class="section-title-wrapper">
  <!-- Standard Title (visible by default) -->
  <div class="standard-title">
    <div class="flex items-center gap-3 mb-10">
      <div class="h-px flex-1 bg-accent-color opacity-30"></div>
      <h2 class="text-2xl sm:text-3xl font-bold whitespace-nowrap">{standardTitle}</h2>
      <div class="h-px flex-1 bg-accent-color opacity-30"></div>
    </div>
  </div>
  
  <!-- RPG Title (hidden by default) -->
  <div class="rpg-title hidden">
    <div class="flex items-center gap-3 mb-10">
      <div class="h-px flex-1 bg-accent-color opacity-30"></div>
      <h2 class="text-2xl sm:text-3xl font-bold whitespace-nowrap rpg-section-title">{rpgTitle}</h2>
      <div class="h-px flex-1 bg-accent-color opacity-30"></div>
    </div>
  </div>
</div>

<script>
  import { getTheme } from '../utils/theme-context';
  
  function updateSectionTitle() {
    const currentTheme = getTheme();
    const standardTitles = document.querySelectorAll('.standard-title');
    const rpgTitles = document.querySelectorAll('.rpg-title');
    
    if (currentTheme === 'rpg') {
      standardTitles.forEach(title => title.classList.add('hidden'));
      rpgTitles.forEach(title => title.classList.remove('hidden'));
    } else {
      standardTitles.forEach(title => title.classList.remove('hidden'));
      rpgTitles.forEach(title => title.classList.add('hidden'));
    }
  }
  
  // Run on initial load
  document.addEventListener('DOMContentLoaded', updateSectionTitle);
  
  // Run when theme changes
  document.addEventListener('astro:page-load', updateSectionTitle);
  
  // Listen for theme changes
  window.addEventListener('storage', (event) => {
    if (event.key === 'site-theme') {
      updateSectionTitle();
    }
  });
  
  // Custom event for theme changes
  document.addEventListener('themeChanged', updateSectionTitle);
</script>

<style>
  .hidden {
    display: none;
  }
  
  .rpg-section-title {
    font-family: var(--font-heading);
    text-shadow: 1px 1px 3px rgba(0, 0, 0, 0.2);
  }
</style>
