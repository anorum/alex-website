---
// Define interfaces for our data
interface Artist {
  name: string;
  genres?: string[];
  image_url?: string;
  imageUrl?: string;
  count?: number;
}

interface Track {
  name: string;
  artists: string[];
  image_url?: string;
  imageUrl?: string;
  artist?: string;
  count?: number;
}

interface Genre {
  genre: string;
  count: number;
}

interface FormattedGenre {
  name: string;
  count: number;
}

// Available time ranges for the dropdown
const timeRanges = [
  { value: 'short_term', label: '4 Weeks' },
  { value: 'medium_term', label: '6 Months' },
  { value: 'long_term', label: 'Year' }
];

// Define the API URL
const apiUrl = 'http://api.homelab/api/v1/spotify/data';

// Initialize loading state
let isLoading = true;
let hasError = false;
let errorMessage = '';

// Initialize variables
let topArtists: Artist[] = [];
let topTracks: Track[] = [];
let topGenres: Genre[] = [];
let formattedGenres: FormattedGenre[] = [];
let recentlyPlayed: any[] = [];
let mainstreamFactor = 0;

// Check if we have cached data in sessionStorage
let cachedData = null;
if (typeof window !== 'undefined' && window.sessionStorage) {
  const cached = sessionStorage.getItem('spotifyStatsCache');
  if (cached) {
    try {
      const { data, timestamp } = JSON.parse(cached);
      // Use cache if it's less than 15 minutes old
      if (Date.now() - timestamp < 15 * 60 * 1000) {
        cachedData = data;
        console.log('Using cached Spotify data');
      }
    } catch (e) {
      console.error('Error parsing cached Spotify data:', e);
    }
  }
}

try {
  if (cachedData) {
    // Use cached data
    const data = cachedData;
    
    // Process the data
    topArtists = data.top_artists || [];
    topTracks = data.top_tracks || [];
    topGenres = data.top_genres || [];
    recentlyPlayed = data.recently_played || [];
    mainstreamFactor = data.mainstream_factor || 0;
    
    isLoading = false;
  } else {
    // Fetch data from the API
    const response = await fetch(apiUrl);
    
    if (!response.ok) {
      throw new Error(`API request failed: ${response.status}`);
    }
    
    const data = await response.json();
    
    // Cache the data in sessionStorage
    if (typeof window !== 'undefined' && window.sessionStorage) {
      sessionStorage.setItem('spotifyStatsCache', JSON.stringify({
        data,
        timestamp: Date.now()
      }));
    }
    
    // Process the data
    topArtists = data.top_artists || [];
    topTracks = data.top_tracks || [];
    topGenres = data.top_genres || [];
    recentlyPlayed = data.recently_played || [];
    mainstreamFactor = data.mainstream_factor || 0;
    
    isLoading = false;
  }
  
  // Add count property for compatibility with existing UI
  topArtists = topArtists.map((artist, index) => ({
    ...artist,
    count: artist.count || 100 - (index * 10), // Use existing count or simulate popularity score
    imageUrl: artist.imageUrl || artist.image_url || 'https://via.placeholder.com/40' // Use image URL from API or placeholder
  }));
  
  topTracks = topTracks.map((track, index) => ({
    ...track,
    count: track.count || 100 - (index * 10), // Use existing count or simulate popularity score
    imageUrl: track.imageUrl || track.image_url || 'https://via.placeholder.com/40', // Use image URL from API or placeholder
    artist: track.artist || track.artists.join(', ') // Join multiple artists if not already joined
  }));
  
  // Format genres for UI
  if (topGenres && topGenres.length > 0) {
    formattedGenres = topGenres.map(genre => ({
      name: genre.genre.split(' ')
        .map(word => word.charAt(0).toUpperCase() + word.slice(1))
        .join(' '),
      count: genre.count
    }));
  } else {
    formattedGenres = [];
  }
} catch (error) {
  console.error('Error fetching Spotify data:', error);
  isLoading = false;
  hasError = true;
  errorMessage = error instanceof Error ? error.message : 'Unknown error';
}

---

<div class="spotify-stats-component p-6 bg-white rounded-lg border-l-4 border-green-600 shadow-md dark:bg-gray-800 dark:border-green-500">
  <!-- Component Header - Always visible -->
  <div class="flex items-center justify-between mb-6">
    <div class="flex items-center">
      <svg class="w-10 h-10 text-green-600 dark:text-green-400 me-4" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24">
        <path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10 10-4.5 10-10S17.5 2 12 2zm4.059 14.406c-.192.192-.41.288-.637.288s-.446-.096-.637-.288a.927.927 0 0 1 0-1.274c.341-.341.822-.446 1.254-.271.431.175.71.592.71 1.059 0 .246-.096.47-.29.663zm-3.46-1.494a.927.927 0 0 1 0-1.274.924.924 0 0 1 1.274 0c.351.351.351.923 0 1.274a.924.924 0 0 1-1.274 0zm-3.459 1.493c-.192.192-.41.288-.637.288s-.446-.096-.637-.288a.927.927 0 0 1 0-1.274c.341-.341.822-.446 1.254-.271.431.175.71.592.71 1.059 0 .246-.096.47-.29.663zm8.039-6.892c-1.967-1.25-4.374-1.554-6.427-1.554-2.121 0-4.5.304-6.427 1.554a.922.922 0 0 1-1.262-.304.922.922 0 0 1 .304-1.262c2.121-1.308 4.731-1.721 7.385-1.721s5.264.413 7.385 1.721c.446.275.579.854.304 1.262-.275.446-.854.579-1.262.304zm-1.2 3.056c-1.487-.937-3.397-1.167-5.173-1.167-1.776 0-3.686.23-5.173 1.167a.924.924 0 0 1-1.274-.304.924.924 0 0 1 .304-1.274c1.871-1.138 4.112-1.346 6.143-1.346s4.272.208 6.143 1.346c.446.275.579.828.304 1.274-.275.446-.828.579-1.274.304z"/>
      </svg>
      <h2 class="text-3xl font-bold text-gray-900 dark:text-white">Spotify Stats</h2>
    </div>
  </div>
  
  <!-- Error Message -->
  {hasError && (
    <div class="p-4 mb-6 text-sm text-red-800 rounded-lg bg-red-50 dark:bg-gray-800 dark:text-red-400 border border-red-300 dark:border-red-800">
      <div class="flex items-center">
        <svg class="flex-shrink-0 inline w-5 h-5 mr-3" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 20 20">
          <path d="M10 .5a9.5 9.5 0 1 0 9.5 9.5A9.51 9.51 0 0 0 10 .5ZM9.5 4a1.5 1.5 0 1 1 0 3 1.5 1.5 0 0 1 0-3ZM12 15H8a1 1 0 0 1 0-2h1v-3H8a1 1 0 0 1 0-2h2a1 1 0 0 1 1 1v4h1a1 1 0 0 1 0 2Z"/>
        </svg>
        <span class="font-medium">
          Error loading Spotify stats: {errorMessage}
        </span>
      </div>
    </div>
  )}
  
  <!-- Stats Grid - Always visible with skeletons when loading -->
  <div id="stats-grid" class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <!-- Top Artists -->
    <div class="p-4 bg-gray-50 rounded-lg dark:bg-gray-700">
      <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-4">Top Artists</h3>
      <div id="top-artists-container" class="space-y-3">
        {isLoading ? (
          // Skeleton loaders for artists
          Array(5).fill(0).map(() => (
            <div class="flex items-center justify-between py-2 border-b border-gray-200 dark:border-gray-600 last:border-0">
              <div class="flex items-center">
                <div class="w-6 h-6 bg-gray-200 dark:bg-gray-600 rounded animate-pulse"></div>
                <div class="w-10 h-10 rounded-full mx-3 bg-gray-200 dark:bg-gray-600 animate-pulse"></div>
                <div class="w-32 h-5 bg-gray-200 dark:bg-gray-600 rounded animate-pulse"></div>
              </div>
            </div>
          ))
        ) : topArtists && topArtists.length > 0 ? (
          topArtists.map((artist: any, index: number) => (
            <div class="flex items-center justify-between py-2 border-b border-gray-200 dark:border-gray-600 last:border-0">
              <div class="flex items-center">
                <span class="text-lg font-medium text-gray-500 dark:text-gray-400 w-6">{index + 1}</span>
                <div class="w-10 h-10 rounded-full mx-3 overflow-hidden">
                  {artist.imageUrl ? (
                    <img src={artist.imageUrl} alt={artist.name} class="w-full h-full object-cover" />
                  ) : (
                    <div class="w-full h-full bg-green-100 dark:bg-green-900 flex items-center justify-center text-green-600 dark:text-green-300">
                      <i class="fas fa-music"></i>
                    </div>
                  )}
                </div>
                <span class="font-medium text-gray-900 dark:text-white">{artist.name}</span>
              </div>
            </div>
          ))
        ) : (
          <p class="text-gray-500 dark:text-gray-400">No artist data available</p>
        )}
      </div>
    </div>
    
    <!-- Top Tracks -->
    <div class="p-4 bg-gray-50 rounded-lg dark:bg-gray-700">
      <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-4">Top Tracks</h3>
      <div id="top-tracks-container" class="space-y-3">
        {isLoading ? (
          // Skeleton loaders for tracks
          Array(5).fill(0).map(() => (
            <div class="flex items-center justify-between py-2 border-b border-gray-200 dark:border-gray-600 last:border-0">
              <div class="flex items-center">
                <div class="w-6 h-6 bg-gray-200 dark:bg-gray-600 rounded animate-pulse"></div>
                <div class="w-10 h-10 rounded mx-3 bg-gray-200 dark:bg-gray-600 animate-pulse"></div>
                <div>
                  <div class="w-32 h-5 bg-gray-200 dark:bg-gray-600 rounded animate-pulse mb-2"></div>
                  <div class="w-24 h-4 bg-gray-200 dark:bg-gray-600 rounded animate-pulse"></div>
                </div>
              </div>
            </div>
          ))
        ) : topTracks && topTracks.length > 0 ? (
          topTracks.map((track: any, index: number) => (
            <div class="flex items-center justify-between py-2 border-b border-gray-200 dark:border-gray-600 last:border-0">
              <div class="flex items-center">
                <span class="text-lg font-medium text-gray-500 dark:text-gray-400 w-6">{index + 1}</span>
                <div class="w-10 h-10 rounded mx-3 overflow-hidden">
                  {track.imageUrl ? (
                    <img src={track.imageUrl} alt={track.name} class="w-full h-full object-cover" />
                  ) : (
                    <div class="w-full h-full bg-green-100 dark:bg-green-900 flex items-center justify-center text-green-600 dark:text-green-300">
                      <i class="fas fa-music"></i>
                    </div>
                  )}
                </div>
                <div>
                  <p class="font-medium text-gray-900 dark:text-white">{track.name}</p>
                  <p class="text-sm text-gray-500 dark:text-gray-400">{track.artist}</p>
                </div>
              </div>
            </div>
          ))
        ) : (
          <p class="text-gray-500 dark:text-gray-400">No track data available</p>
        )}
      </div>
    </div>
    
    <!-- Recently Played -->
    <div class="p-4 bg-gray-50 rounded-lg dark:bg-gray-700">
      <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-4">Recently Played</h3>
      <div id="recently-played-container" class="space-y-3">
        {isLoading ? (
          // Skeleton loaders for recently played
          Array(5).fill(0).map(() => (
            <div class="flex items-center justify-between py-2 border-b border-gray-200 dark:border-gray-600 last:border-0">
              <div class="flex items-center">
                <div class="w-10 h-10 rounded mx-3 bg-gray-200 dark:bg-gray-600 animate-pulse"></div>
                <div>
                  <div class="w-32 h-5 bg-gray-200 dark:bg-gray-600 rounded animate-pulse mb-2"></div>
                  <div class="w-24 h-4 bg-gray-200 dark:bg-gray-600 rounded animate-pulse"></div>
                </div>
              </div>
              <div class="text-right">
                <div class="w-16 h-4 bg-gray-200 dark:bg-gray-600 rounded animate-pulse"></div>
              </div>
            </div>
          ))
        ) : recentlyPlayed && recentlyPlayed.length > 0 ? (
          recentlyPlayed.map((track: any, index: number) => (
            <div class="flex items-center justify-between py-2 border-b border-gray-200 dark:border-gray-600 last:border-0">
              <div class="flex items-center">
                <div class="w-10 h-10 rounded mx-3 bg-green-100 dark:bg-green-900 flex items-center justify-center text-green-600 dark:text-green-300">
                  <i class="fas fa-play"></i>
                </div>
                <div>
                  <p class="font-medium text-gray-900 dark:text-white">{track.name}</p>
                  <p class="text-sm text-gray-500 dark:text-gray-400">{track.artists.join(', ')}</p>
                </div>
              </div>
              <div class="text-right">
                <p class="text-sm text-gray-500 dark:text-gray-400">
                  {new Date(track.played_at).toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'})}
                </p>
              </div>
            </div>
          ))
        ) : (
          <p class="text-gray-500 dark:text-gray-400">No recently played data available</p>
        )}
      </div>
    </div>
    
    <!-- Top Genres -->
    <div class="p-4 bg-gray-50 rounded-lg dark:bg-gray-700">
      <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-4">Top Genres</h3>
      <div id="top-genres-container" class="space-y-3">
        {isLoading ? (
          // Skeleton loaders for genres
          Array(5).fill(0).map(() => (
            <div class="mb-3 last:mb-0">
              <div class="flex justify-between mb-1">
                <div class="w-32 h-5 bg-gray-200 dark:bg-gray-600 rounded animate-pulse"></div>
                <div class="w-10 h-5 bg-gray-200 dark:bg-gray-600 rounded animate-pulse"></div>
              </div>
              <div class="w-full bg-gray-200 rounded-full h-2.5 dark:bg-gray-700">
                <div class="bg-gray-300 dark:bg-gray-600 h-2.5 rounded-full animate-pulse" style={`width: ${Math.random() * 100}%`}></div>
              </div>
            </div>
          ))
        ) : formattedGenres && formattedGenres.length > 0 ? (
          formattedGenres.map((genre: FormattedGenre) => (
            <div class="mb-3 last:mb-0">
              <div class="flex justify-between mb-1">
                <span class="text-base font-medium text-gray-900 dark:text-white">{genre.name}</span>
                <span class="text-sm font-medium text-gray-500 dark:text-gray-400">{genre.count}</span>
              </div>
              <div class="w-full bg-gray-200 rounded-full h-2.5 dark:bg-gray-700">
                <div class="bg-green-600 h-2.5 rounded-full" style={`width: ${formattedGenres.length > 0 ? (genre.count / formattedGenres[0].count) * 100 : 0}%`}></div>
              </div>
            </div>
          ))
        ) : (
          <p class="text-gray-500 dark:text-gray-400">No genre data available</p>
        )}
      </div>
    </div>
    
    <!-- Mainstream Factor -->
    <div class="p-4 bg-gray-50 rounded-lg dark:bg-gray-700 md:col-span-2">
      <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-4">Mainstream Factor</h3>
      <div class="mb-3">
        {isLoading ? (
          // Skeleton loader for mainstream factor
          <>
            <div class="flex justify-between mb-1">
              <div class="w-64 h-5 bg-gray-200 dark:bg-gray-600 rounded animate-pulse"></div>
              <div class="w-16 h-5 bg-gray-200 dark:bg-gray-600 rounded animate-pulse"></div>
            </div>
            <div class="w-full bg-gray-200 rounded-full h-2.5 dark:bg-gray-700">
              <div class="bg-gray-300 dark:bg-gray-600 h-2.5 rounded-full animate-pulse" style="width: 50%"></div>
            </div>
            <div class="mt-2 w-full h-4 bg-gray-200 dark:bg-gray-600 rounded animate-pulse"></div>
          </>
        ) : mainstreamFactor > 0 ? (
          <>
            <div class="flex justify-between mb-1">
              <span class="text-base font-medium text-gray-900 dark:text-white">How mainstream is your music taste?</span>
              <span class="text-sm font-medium text-gray-500 dark:text-gray-400">{mainstreamFactor.toFixed(1)}%</span>
            </div>
            <div class="w-full bg-gray-200 rounded-full h-2.5 dark:bg-gray-700">
              <div class="bg-green-600 h-2.5 rounded-full" style={`width: ${mainstreamFactor}%`}></div>
            </div>
            <p class="mt-2 text-sm text-gray-500 dark:text-gray-400">
              {mainstreamFactor > 80 ? 'Your music taste is very mainstream!' : 
               mainstreamFactor > 60 ? 'You enjoy popular music with some unique picks.' : 
               mainstreamFactor > 40 ? 'Your music taste is balanced between mainstream and obscure.' : 
               mainstreamFactor > 20 ? 'You tend to enjoy music outside the mainstream.' : 
               'Your music taste is very unique and obscure!'}
            </p>
          </>
        ) : (
          <p class="text-gray-500 dark:text-gray-400">No mainstream factor data available</p>
        )}
      </div>
    </div>
  </div>
</div>
