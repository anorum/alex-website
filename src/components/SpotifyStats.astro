---
import { MusicalNoteIcon } from '@heroicons/react/24/outline';
import TopArtists from './spotify/TopArtists.jsx';
import TopTracks from './spotify/TopTracks.jsx';
import RecentlyPlayed from './spotify/RecentlyPlayed.jsx';
import GenreStats from './spotify/GenreStats.jsx';
import SpotifySummary from './spotify/SpotifySummary.jsx';
import MusicSummary from './spotify/MusicSummary.jsx';
import MusicArtistsGenres from './spotify/MusicArtistsGenres.jsx';
import Playlists from './spotify/Playlists.jsx';
---

<div class="relative">
  <div class="max-w-4xl mx-auto px-4">
    <div class="mb-6">
      <div class="flex items-center mb-4">
        <div class="w-10 h-10 flex items-center justify-center bg-purple-100 dark:bg-purple-900 rounded-full text-purple-600 dark:text-purple-400 me-4">
          <MusicalNoteIcon className="h-6 w-6" />
        </div>
        <div>
          <h2 class="text-2xl font-bold text-gray-900 dark:text-white">Music Stats</h2>
          <p class="text-gray-500 dark:text-gray-400 text-sm">Explore my musical journey from the last 6 months</p>
        </div>
      </div>
    </div>
  
  <div id="spotify-stats-content">
    <!-- Initial loading state - this will be shown immediately -->
    <div id="spotify-loading-indicator" class="flex flex-col items-center justify-center p-8">
      <div class="animate-spin rounded-full h-12 w-12 border-b-2 border-purple-500 mb-4"></div>
      <p class="text-gray-500 dark:text-gray-400">Loading music data...</p>
    </div>
    
    <!-- Error message container - initially hidden -->
    <div id="spotify-error-message" class="hidden p-4 mb-6 text-sm text-red-800 rounded-lg bg-red-50 dark:bg-gray-800 dark:text-red-400 border border-red-300 dark:border-red-800">
      <div class="flex items-center">
        <svg class="flex-shrink-0 inline w-5 h-5 mr-3" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 20 20">
          <path d="M10 .5a9.5 9.5 0 1 0 9.5 9.5A9.51 9.51 0 0 0 10 .5ZM9.5 4a1.5 1.5 0 1 1 0 3 1.5 1.5 0 0 1 0-3ZM12 15H8a1 1 0 0 1 0-2h1v-3H8a1 1 0 0 1 0-2h2a1 1 0 0 1 1 1v4h1a1 1 0 0 1 0 2Z"/>
        </svg>
        <span id="spotify-error-text" class="font-medium">Error loading music stats</span>
      </div>
    </div>
    
    <!-- Content container - initially hidden -->
    <div id="spotify-stats-container" class="hidden">
      <!-- Music Summary -->
      <div class="mb-8" id="music-summary">
          <MusicSummary client:only="react" summary={{}} />
      </div>
      
      <!-- Music Artists and Genres -->
      <div class="mb-8" id="music-artists-genres">
          <MusicArtistsGenres client:only="react" summary={{}} />
      </div>
      
      <!-- Recently Played -->
      <div class="mb-8" id="recently-played">
          <RecentlyPlayed client:only="react" recentlyPlayed={[]} />
      </div>
      
      <!-- Hidden components (kept for future use) -->
      <!-- 
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
        <div id="top-artists">
          <TopArtists client:only="react" topArtists={[]} />
        </div>
        <div id="top-tracks">
          <TopTracks client:only="react" topTracks={[]} />
        </div>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
        <div id="genre-stats">
          <GenreStats client:load genreStats={[]} />
        </div>
        <div id="playlists">
          <Playlists client:load playlists={[]} />
        </div>
      </div>
      -->
    </div>
  </div>
</div>

<!-- Custom CSS for Spotify stats -->
<style is:global>
  /* Custom styles for music stats */
  .spotify-card {
    background-color: var(--bubble-bg);
    border-radius: var(--radius-md);
    border: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow: var(--card-shadow);
    transition: transform 0.3s ease;
  }
  
  .spotify-card:hover {
    transform: translateY(-5px);
  }
  
  /* Style for artist and track images */
  .music-image {
    border-radius: var(--radius-sm);
    object-fit: cover;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    transition: transform 0.2s ease;
  }
  
  .music-image:hover {
    transform: scale(1.05);
  }
  
  /* Mobile-friendly adjustments */
  @media (max-width: 640px) {
    .music-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>

<script is:inline>
  // Initialize when the page loads
  document.addEventListener('astro:page-load', async function() {
    // Get DOM elements
    const loadingIndicator = document.getElementById('spotify-loading-indicator');
    const errorMessage = document.getElementById('spotify-error-message');
    const errorText = document.getElementById('spotify-error-text');
    const statsContainer = document.getElementById('spotify-stats-container');
    
    try {
      // Fetch data from the API
      const apiUrl = '/api/alexapi/api/v1/spotify/data';
      console.log('Fetching music data from:', apiUrl);
      
      const response = await fetch(apiUrl);
      
      if (!response.ok) {
        throw new Error(`API request failed: ${response.status}`);
      }
      
      const data = await response.json();
      
      console.log("Data from API:", data);
      
      // Create a custom event with all the data
      const spotifyDataEvent = new CustomEvent('spotify-data-ready', {
        detail: {
          topArtists: data.top_artists || [],
          topTracks: data.top_tracks || [],
          recentlyPlayed: data.recently_played || [],
          playlists: data.playlists || [],
          stats: data.stats || {}
        },
        bubbles: true
      });
      
      console.log("Dispatching event with data:", spotifyDataEvent.detail);
      
      // Dispatch the event to the document so all components can listen for it
      // Add a small delay to ensure components are mounted
      setTimeout(() => {
        console.log("Dispatching event after delay");
        document.dispatchEvent(spotifyDataEvent);
      }, 500);
      
      // Show the content and hide the loading indicator
      if (loadingIndicator) loadingIndicator.classList.add('hidden');
      if (statsContainer) statsContainer.classList.remove('hidden');
    } catch (error) {
      console.error('Error loading music stats:', error);
      
      // Show error message and hide loading indicator
      if (loadingIndicator) loadingIndicator.classList.add('hidden');
      if (errorMessage) {
        if (errorText) errorText.textContent = error instanceof Error ? error.message : 'Unknown error loading music stats';
        errorMessage.classList.remove('hidden');
      }
    }
  });
</script>
