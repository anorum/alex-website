---
interface Props {
  defaultYear?: string;
}

const { defaultYear = new Date().getFullYear().toString() } = Astro.props;

// Available years for the dropdown
const availableYears = ['2025', '2024', '2023', '2022', '2021'];

// Mock data for demonstration purposes
// In a real implementation, this would be fetched from an API
interface Artist {
  name: string;
  imageUrl: string;
  count: number;
}

interface Track {
  name: string;
  artist: string;
  imageUrl: string;
  count: number;
}

interface Genre {
  name: string;
  count: number;
}

interface ListeningTime {
  total: number;
  average: number;
  peak: {
    day: string;
    time: string;
  };
}

interface YearData {
  topArtists: Artist[];
  topTracks: Track[];
  topGenres: Genre[];
  listeningTime: ListeningTime;
}

interface MockDataType {
  [key: string]: YearData;
}

