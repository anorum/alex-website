---
// Import types
// Define interfaces for our data
interface Artist {
  name: string;
  imageUrl: string;
  count: number;
}

interface Track {
  name: string;
  artist: string;
  imageUrl: string;
  count: number;
}

interface Genre {
  name: string;
  count: number;
}

interface ListeningTime {
  total: number;
  average: number;
  peak: {
    day: string;
    time: string;
  };
}

interface SpotifyData {
  topArtists: Artist[];
  topTracks: Track[];
  topGenres: Genre[];
  listeningTime: ListeningTime;
}

// Available time ranges for the dropdown
const timeRanges = [
  { value: 'short_term', label: '4 Weeks' },
  { value: 'medium_term', label: '6 Months' },
  { value: 'long_term', label: 'Year' }
];

// Spotify API credentials from environment variables
const refreshToken = import.meta.env.SPOTIFY_REFRESH_TOKEN;
const clientId = import.meta.env.SPOTIFY_CLIENT_ID;
const clientSecret = import.meta.env.SPOTIFY_CLIENT_SECRET;

// Function to get a new access token using the refresh token
async function getAccessToken(): Promise<string | null> {
  try {
    const tokenResponse = await fetch('https://accounts.spotify.com/api/token', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/x-www-form-urlencoded',
        'Authorization': `Basic ${btoa(`${clientId}:${clientSecret}`)}`
      },
      body: new URLSearchParams({
        grant_type: 'refresh_token',
        refresh_token: refreshToken
      })
    });
    
    if (!tokenResponse.ok) {
      throw new Error(`Failed to refresh token: ${tokenResponse.status} ${tokenResponse.statusText}`);
    }
    
    const tokenData = await tokenResponse.json();
    return tokenData.access_token;
  } catch (error) {
    console.error('Error refreshing token:', error);
    return null;
  }
}

const accessToken = await getAccessToken();

async function fetchWebApi<T>(endpoint: string, method: string, body?: unknown): Promise<T> {
  const res = await fetch(`https://api.spotify.com/${endpoint}`, {
    headers: {
      Authorization: `Bearer ${accessToken}`,
    },
    method,
    body:JSON.stringify(body)
  });
  return await res.json();
}

async function getTopTracks(
  time_range: 'short_term' | 'medium_term' | 'long_term' = 'short_term',
  limit: number = 10
): Promise<Track[]> {
    const endpoint = `v1/me/top/tracks?time_range=${time_range}&limit=${limit}`;
    const response = await fetchWebApi<{ items: any[] }>(endpoint, 'GET');
    
    return response.items.map(item => ({
      name: item.name,
      artist: item.artists.map((artist: any) => artist.name).join(', '),
      imageUrl: item.album?.images?.[0]?.url || '',
      count: item.popularity || 0
    }));
}

async function getTopArtists(
  time_range: 'short_term' | 'medium_term' | 'long_term' = 'short_term',
  limit: number = 10
): Promise<Artist[]> {
    const endpoint = `v1/me/top/artists?time_range=${time_range}&limit=${limit}`;
    const response = await fetchWebApi<{ items: any[] }>(endpoint, 'GET');
    
    return response.items.map(item => ({
      name: item.name,
      imageUrl: item.images?.[0]?.url || '',
      count: item.popularity || 0
    }));
}

let topTracks = await getTopTracks()
let topArtists = await getTopArtists()

---

<div class="p-6 bg-white rounded-lg border-l-4 border-green-600 shadow-md dark:bg-gray-800 dark:border-green-500">
  <div class="flex items-center justify-between mb-6">
    <div class="flex items-center">
      <svg class="w-10 h-10 text-green-600 dark:text-green-400 me-4" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24">
        <path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10 10-4.5 10-10S17.5 2 12 2zm4.059 14.406c-.192.192-.41.288-.637.288s-.446-.096-.637-.288a.927.927 0 0 1 0-1.274c.341-.341.822-.446 1.254-.271.431.175.71.592.71 1.059 0 .246-.096.47-.29.663zm-3.46-1.494a.927.927 0 0 1 0-1.274.924.924 0 0 1 1.274 0c.351.351.351.923 0 1.274a.924.924 0 0 1-1.274 0zm-3.459 1.493c-.192.192-.41.288-.637.288s-.446-.096-.637-.288a.927.927 0 0 1 0-1.274c.341-.341.822-.446 1.254-.271.431.175.71.592.71 1.059 0 .246-.096.47-.29.663zm8.039-6.892c-1.967-1.25-4.374-1.554-6.427-1.554-2.121 0-4.5.304-6.427 1.554a.922.922 0 0 1-1.262-.304.922.922 0 0 1 .304-1.262c2.121-1.308 4.731-1.721 7.385-1.721s5.264.413 7.385 1.721c.446.275.579.854.304 1.262-.275.446-.854.579-1.262.304zm-1.2 3.056c-1.487-.937-3.397-1.167-5.173-1.167-1.776 0-3.686.23-5.173 1.167a.924.924 0 0 1-1.274-.304.924.924 0 0 1 .304-1.274c1.871-1.138 4.112-1.346 6.143-1.346s4.272.208 6.143 1.346c.446.275.579.828.304 1.274-.275.446-.828.579-1.274.304z"/>
      </svg>
      <h2 class="text-3xl font-bold text-gray-900 dark:text-white">Spotify Stats</h2>
    </div>
    
    <div class="flex items-center">
      <!-- Time Range Dropdown -->
      <div class="flex items-center">
        <span class="mr-2 text-gray-700 dark:text-gray-300 font-medium">Last:</span>
        <div class="relative">
          <select id="time-range-select" class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-green-500 focus:border-green-500 block w-full p-2.5 pr-8 appearance-none dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-green-500 dark:focus:border-green-500">
            {timeRanges.map(range => (
              <option value={range.value} selected={range.value === 'medium_term'}>{range.label}</option>
            ))}
          </select>
          <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-2 text-gray-700 dark:text-gray-300">
            <svg class="w-4 h-4 fill-current" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20">
              <path d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" fill-rule="evenodd"></path>
            </svg>
          </div>
        </div>
      </div>
    </div>
  </div>
  
  <!-- Loading Indicator -->
  <div id="loading-indicator" class="hidden p-4 mb-6 text-sm text-blue-800 rounded-lg bg-blue-50 dark:bg-gray-700 dark:text-blue-400">
    <div class="flex items-center">
      <svg class="animate-spin -ml-1 mr-3 h-5 w-5 text-blue-500" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
      </svg>
      <span>Loading Spotify data...</span>
    </div>
  </div>
  
  <!-- Error Message -->
  <div id="error-message" class="hidden p-4 mb-6 text-sm text-red-800 rounded-lg bg-red-50 dark:bg-gray-700 dark:text-red-400">
    <div class="flex items-center">
      <svg class="flex-shrink-0 inline w-4 h-4 mr-3" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 20 20">
        <path d="M10 .5a9.5 9.5 0 1 0 9.5 9.5A9.51 9.51 0 0 0 10 .5ZM9.5 4a1.5 1.5 0 1 1 0 3 1.5 1.5 0 0 1 0-3ZM12 15H8a1 1 0 0 1 0-2h1v-3H8a1 1 0 0 1 0-2h2a1 1 0 0 1 1 1v4h1a1 1 0 0 1 0 2Z"/>
      </svg>
      <span>Unable to fetch Spotify data. Please check your credentials.</span>
    </div>
  </div>
  
  <!-- Stats Grid -->
  <div id="stats-grid" class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <!-- Top Artists -->
    {topArtists && (
      <div class="p-4 bg-gray-50 rounded-lg dark:bg-gray-700">
        <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-4">Top Artists</h3>
        <div id="top-artists-container" class="space-y-3">
          {topArtists.map((artist, index) => (
            <div class="flex items-center justify-between py-2 border-b border-gray-200 dark:border-gray-600 last:border-0">
              <div class="flex items-center">
                <span class="text-lg font-medium text-gray-500 dark:text-gray-400 w-6">{index + 1}</span>
                <img src={artist.imageUrl} alt={artist.name} class="w-10 h-10 rounded-full mx-3" />
                <span class="font-medium text-gray-900 dark:text-white">{artist.name}</span>
              </div>
              <span class="text-sm text-gray-500 dark:text-gray-400">Popularity: {artist.count}</span>
            </div>
          ))}
        </div>
      </div>
    )}
    
    <!-- Top Tracks -->
    {topTracks && (
      <div class="p-4 bg-gray-50 rounded-lg dark:bg-gray-700">
        <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-4">Top Tracks</h3>
        <div id="top-tracks-container" class="space-y-3">
          {topTracks.map((track, index) => (
            <div class="flex items-center justify-between py-2 border-b border-gray-200 dark:border-gray-600 last:border-0">
              <div class="flex items-center">
                <span class="text-lg font-medium text-gray-500 dark:text-gray-400 w-6">{index + 1}</span>
                <img src={track.imageUrl} alt={track.name} class="w-10 h-10 rounded mx-3" />
                <div>
                  <p class="font-medium text-gray-900 dark:text-white">{track.name}</p>
                  <p class="text-sm text-gray-500 dark:text-gray-400">{track.artist}</p>
                </div>
              </div>
              <span class="text-sm text-gray-500 dark:text-gray-400">Popularity: {track.count}</span>
            </div>
          ))}
        </div>
      </div>
    )}
    
    <!-- Placeholder for additional stats that can be added later -->
  </div>
</div>

<script>
  // Simple client-side script to fetch and update data when dropdown changes
  document.addEventListener('DOMContentLoaded', function() {
    const timeRangeSelect = document.getElementById('time-range-select') as HTMLSelectElement;
    const loadingIndicator = document.getElementById('loading-indicator');
    const errorMessage = document.getElementById('error-message');
    const statsGrid = document.getElementById('stats-grid');
    
    // Function to fetch data based on selected time range
    async function fetchDataForTimeRange(selectedTimeRange: string) {
      console.log(`Time range changed to: ${selectedTimeRange}`);
      
      // Show loading state
      if (loadingIndicator) loadingIndicator.classList.remove('hidden');
      if (errorMessage) errorMessage.classList.add('hidden');
      if (statsGrid) statsGrid.classList.add('opacity-50');
      
      try {
        // Call our API endpoint
        console.log(`Calling API with timeRange=${selectedTimeRange}`);
        const response = await fetch(`/api/spotify-stats.json?timeRange=${encodeURIComponent(selectedTimeRange)}`);
        
        if (!response.ok) {
          throw new Error(`API request failed: ${response.status}`);
        }
        
        const data = await response.json();
        console.log('Data received from API:', data);
        
        // Update the UI with the new data
        console.log('Updating artists with:', data.topArtists);
        updateTopArtists(data.topArtists);
        
        console.log('Updating tracks with:', data.topTracks);
        updateTopTracks(data.topTracks);
        
        // Hide loading indicator
        if (loadingIndicator) loadingIndicator.classList.add('hidden');
        if (statsGrid) statsGrid.classList.remove('opacity-50');
      } catch (error) {
        console.error('Error fetching data:', error);
        
        // Show error message
        if (loadingIndicator) loadingIndicator.classList.add('hidden');
        if (errorMessage) errorMessage.classList.remove('hidden');
        if (statsGrid) statsGrid.classList.remove('opacity-50');
      }
    }
    
    if (timeRangeSelect) {
      // Trigger fetch on page load with the default selected value
      fetchDataForTimeRange(timeRangeSelect.value);
      
      // Add change event listener
      timeRangeSelect.addEventListener('change', function() {
        fetchDataForTimeRange(this.value);
      });
    }
  });
  
  // Simple functions to update the UI
  function updateTopArtists(artists: any[]) {
    const container = document.getElementById('top-artists-container');
    if (!container) return;
    
    let html = '';
    artists.forEach((artist: any, index: number) => {
      html += `
        <div class="flex items-center justify-between py-2 border-b border-gray-200 dark:border-gray-600 last:border-0">
          <div class="flex items-center">
            <span class="text-lg font-medium text-gray-500 dark:text-gray-400 w-6">${index + 1}</span>
            <img src="${artist.imageUrl}" alt="${artist.name}" class="w-10 h-10 rounded-full mx-3" />
            <span class="font-medium text-gray-900 dark:text-white">${artist.name}</span>
          </div>
          <span class="text-sm text-gray-500 dark:text-gray-400">Popularity: ${artist.count}</span>
        </div>
      `;
    });
    
    container.innerHTML = html;
  }
  
  function updateTopTracks(tracks: any[]) {
    const container = document.getElementById('top-tracks-container');
    if (!container) return;
    
    let html = '';
    tracks.forEach((track: any, index: number) => {
      html += `
        <div class="flex items-center justify-between py-2 border-b border-gray-200 dark:border-gray-600 last:border-0">
          <div class="flex items-center">
            <span class="text-lg font-medium text-gray-500 dark:text-gray-400 w-6">${index + 1}</span>
            <img src="${track.imageUrl}" alt="${track.name}" class="w-10 h-10 rounded mx-3" />
            <div>
              <p class="font-medium text-gray-900 dark:text-white">${track.name}</p>
              <p class="text-sm text-gray-500 dark:text-gray-400">${track.artist}</p>
            </div>
          </div>
          <span class="text-sm text-gray-500 dark:text-gray-400">Popularity: ${track.count}</span>
        </div>
      `;
    });
    
    container.innerHTML = html;
  }
</script>
