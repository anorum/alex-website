---

<div class="p-6 bg-white rounded-lg border-l-4 border-green-600 shadow-md dark:bg-gray-800 dark:border-green-500">
  <div class="flex items-center justify-between mb-6">
    <div class="flex items-center">
      <svg class="w-10 h-10 text-green-600 dark:text-green-400 me-4" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24">
        <path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10 10-4.5 10-10S17.5 2 12 2zm4.059 14.406c-.192.192-.41.288-.637.288s-.446-.096-.637-.288a.927.927 0 0 1 0-1.274c.341-.341.822-.446 1.254-.271.431.175.71.592.71 1.059 0 .246-.096.47-.29.663zm-3.46-1.494a.927.927 0 0 1 0-1.274.924.924 0 0 1 1.274 0c.351.351.351.923 0 1.274a.924.924 0 0 1-1.274 0zm-3.459 1.493c-.192.192-.41.288-.637.288s-.446-.096-.637-.288a.927.927 0 0 1 0-1.274c.341-.341.822-.446 1.254-.271.431.175.71.592.71 1.059 0 .246-.096.47-.29.663zm8.039-6.892c-1.967-1.25-4.374-1.554-6.427-1.554-2.121 0-4.5.304-6.427 1.554a.922.922 0 0 1-1.262-.304.922.922 0 0 1 .304-1.262c2.121-1.308 4.731-1.721 7.385-1.721s5.264.413 7.385 1.721c.446.275.579.854.304 1.262-.275.446-.854.579-1.262.304zm-1.2 3.056c-1.487-.937-3.397-1.167-5.173-1.167-1.776 0-3.686.23-5.173 1.167a.924.924 0 0 1-1.274-.304.924.924 0 0 1 .304-1.274c1.871-1.138 4.112-1.346 6.143-1.346s4.272.208 6.143 1.346c.446.275.579.828.304 1.274-.275.446-.828.579-1.274.304z"/>
      </svg>
      <h2 class="text-3xl font-bold text-gray-900 dark:text-white">Spotify Stats</h2>
    </div>
    
    <!-- Year Dropdown -->
    <div class="relative">
      <select id="year-select" class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-green-500 focus:border-green-500 block w-full p-2.5 pr-8 appearance-none dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-green-500 dark:focus:border-green-500">
        {availableYears.map(year => (
          <option value={year} selected={year === selectedYearDefault}>{year}</option>
        ))}
      </select>
    </div>
  </div>
  
  <!-- Stats Grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <!-- Top Artists -->
    <div class="p-4 bg-gray-50 rounded-lg dark:bg-gray-700">
      <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-4">Top Artists</h3>
      <div id="top-artists-container" class="space-y-3">
        {Object.keys(mockData).map(year => (
          <div class={`year-data ${year === selectedYearDefault ? '' : 'hidden'}`} data-year={year}>
            {mockData[year].topArtists.map((artist, index) => (
              <div class="flex items-center justify-between py-2 border-b border-gray-200 dark:border-gray-600 last:border-0">
                <div class="flex items-center">
                  <span class="text-lg font-medium text-gray-500 dark:text-gray-400 w-6">{index + 1}</span>
                  <img src={artist.imageUrl} alt={artist.name} class="w-10 h-10 rounded-full mx-3" />
                  <span class="font-medium text-gray-900 dark:text-white">{artist.name}</span>
                </div>
                <span class="text-sm text-gray-500 dark:text-gray-400">{artist.count} plays</span>
              </div>
            ))}
          </div>
        ))}
      </div>
    </div>
    
    <!-- Top Tracks -->
    <div class="p-4 bg-gray-50 rounded-lg dark:bg-gray-700">
      <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-4">Top Tracks</h3>
      <div id="top-tracks-container" class="space-y-3">
        {Object.keys(mockData).map(year => (
          <div class={`year-data ${year === selectedYearDefault ? '' : 'hidden'}`} data-year={year}>
            {mockData[year].topTracks.map((track, index) => (
              <div class="flex items-center justify-between py-2 border-b border-gray-200 dark:border-gray-600 last:border-0">
                <div class="flex items-center">
                  <span class="text-lg font-medium text-gray-500 dark:text-gray-400 w-6">{index + 1}</span>
                  <img src={track.imageUrl} alt={track.name} class="w-10 h-10 rounded mx-3" />
                  <div>
                    <p class="font-medium text-gray-900 dark:text-white">{track.name}</p>
                    <p class="text-sm text-gray-500 dark:text-gray-400">{track.artist}</p>
                  </div>
                </div>
                <span class="text-sm text-gray-500 dark:text-gray-400">{track.count} plays</span>
              </div>
            ))}
          </div>
        ))}
      </div>
    </div>
    
    <!-- Listening Time -->
    <div class="p-4 bg-gray-50 rounded-lg dark:bg-gray-700">
      <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-4">Listening Time</h3>
      <div id="listening-time-container">
        {Object.keys(mockData).map(year => (
          <div class={`year-data ${year === selectedYearDefault ? '' : 'hidden'}`} data-year={year}>
            <div class="grid grid-cols-2 gap-4">
              <div class="text-center p-4 bg-white rounded-lg shadow dark:bg-gray-800">
                <p class="text-sm text-gray-500 dark:text-gray-400">Total Hours</p>
                <p class="text-2xl font-bold text-gray-900 dark:text-white">{Math.round(mockData[year].listeningTime.total / 60)}</p>
              </div>
              <div class="text-center p-4 bg-white rounded-lg shadow dark:bg-gray-800">
                <p class="text-sm text-gray-500 dark:text-gray-400">Daily Average</p>
                <p class="text-2xl font-bold text-gray-900 dark:text-white">{mockData[year].listeningTime.average} min</p>
              </div>
            </div>
            <div class="mt-4 p-4 bg-white rounded-lg shadow dark:bg-gray-800">
              <p class="text-sm text-gray-500 dark:text-gray-400">Peak Listening Time</p>
              <p class="text-lg font-medium text-gray-900 dark:text-white">
                {mockData[year].listeningTime.peak.day}s, {mockData[year].listeningTime.peak.time}
              </p>
            </div>
          </div>
        ))}
      </div>
    </div>
    
    <!-- Top Genres -->
    <div class="p-4 bg-gray-50 rounded-lg dark:bg-gray-700">
      <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-4">Top Genres</h3>
      <div id="top-genres-container">
        {Object.keys(mockData).map(year => (
          <div class={`year-data ${year === selectedYearDefault ? '' : 'hidden'}`} data-year={year}>
            {mockData[year].topGenres.map((genre, index) => (
              <div class="mb-3 last:mb-0">
                <div class="flex justify-between mb-1">
                  <span class="text-base font-medium text-gray-900 dark:text-white">{genre.name}</span>
                  <span class="text-sm font-medium text-gray-500 dark:text-gray-400">{genre.count} tracks</span>
                </div>
                <div class="w-full bg-gray-200 rounded-full h-2.5 dark:bg-gray-700">
                  <div class="bg-green-600 h-2.5 rounded-full" style={`width: ${(genre.count / mockData[year].topGenres[0].count) * 100}%`}></div>
                </div>
              </div>
            ))}
          </div>
        ))}
      </div>
    </div>
  </div>
</div>

<script>
  // Handle year selection change
  document.addEventListener('DOMContentLoaded', function() {
    const yearSelect = document.getElementById('year-select');
    const yearData = document.querySelectorAll('.year-data');
    
    if (yearSelect) {
      yearSelect.addEventListener('change', function(this: HTMLSelectElement) {
        const selectedYear = this.value;
        
        // Hide all year data
        yearData.forEach(el => {
          el.classList.add('hidden');
        });
        
        // Show selected year data
        const selectedYearData = document.querySelectorAll(`[data-year="${selectedYear}"]`);
        selectedYearData.forEach(el => {
          el.classList.remove('hidden');
        });
      });
    }
  });
</script>
