---
import { experience } from '../data/experience';
---

<div class="relative w-full pt-2 pb-8 px-4 sm:px-6">
  <!-- Vertical timeline line -->
  <div class="absolute left-[1.35rem] sm:left-[1.6rem] top-4 bottom-8 w-px opacity-20" style="background-color: var(--accent-color);"></div>

  <div class="space-y-5">
    {experience.map((item, i) => (
      <div
        class="reveal-item group relative pl-10 sm:pl-12"
        style={`--reveal-delay: ${i * 120}ms;`}
      >
        {/* Timeline dot */}
        <div
          class="absolute left-[0.85rem] sm:left-[1.1rem] top-7 w-2.5 h-2.5 rounded-full ring-2 z-10"
          style={`background-color: var(--accent-color); ring-color: var(--bg-color, var(--color-cream));`}
        ></div>

        {/* Card */}
        <div
          class={`rounded-xl p-5 sm:p-6 border transition-all duration-200 hover:-translate-y-0.5 ${item.isCurrent ? 'border-l-[3px]' : ''}`}
          style={`background-color: var(--bubble-bg); border-color: var(--border-color); box-shadow: var(--card-shadow); ${item.isCurrent ? `border-left-color: var(--accent-color);` : ''}`}
        >
          <div class="flex items-start gap-3 mb-3">
            <div class="w-9 h-9 rounded-md bg-white p-1.5 shadow-sm flex items-center justify-center shrink-0">
              <img src={item.logo.src} alt={item.company + ' logo'} class="object-contain max-w-full max-h-full" />
            </div>
            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-2 flex-wrap">
                <h3 class="text-base font-bold leading-tight" style="font-family: var(--font-heading); color: var(--text-color);">{item.role}</h3>
                {item.isPromotion && (
                  <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium" style="background-color: color-mix(in srgb, var(--accent-color) 12%, transparent); color: var(--accent-color);">
                    Promoted
                  </span>
                )}
              </div>
              <p class="text-sm mt-0.5" style="color: var(--text-secondary);">{item.company} &middot; {item.period}</p>
            </div>
          </div>

          <p class="text-sm leading-relaxed mb-3" style="color: var(--text-secondary);">
            {item.description}
          </p>

          {item.achievements?.length > 0 && (
            <ul class="space-y-1.5">
              {item.achievements.map((ach) => (
                <li class="flex items-start gap-2 text-sm" style="color: var(--text-tertiary);">
                  <span class="mt-1.5 w-1 h-1 rounded-full shrink-0" style="background-color: var(--accent-color);"></span>
                  {ach}
                </li>
              ))}
            </ul>
          )}
        </div>
      </div>
    ))}
  </div>
</div>
