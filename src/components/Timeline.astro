---
import legalZoomLogo from '../assets/logos/LegalZoomlogo.webp';
import newRelicLogo from '../assets/logos/newreliclogo.svg';
import oracleLogo from '../assets/logos/oraclelogo.png';

const timeline = [
  {
    company: "LegalZoom",
    logo: legalZoomLogo,
    role: "Group Manager, Data Platform Engineering",
    period: "2023 – Present",
    year: "2023",
    description: "Leading roadmap, architecture, and delivery for LegalZoom's modern data platform. Managing team focused on Snowflake, Airflow on Kubernetes, dbt, Vault, and self-service tooling.",
    achievements: ["Drove governance initiatives including DSR automation", "Designed Snowflake access model", "Implemented self-service data platform"],
    isPromotion: true
  },
  {
    company: "LegalZoom",
    logo: legalZoomLogo,
    role: "Principal Data Engineer",
    period: "2021 – 2023",
    year: "2021",
    description: "Rebuilt the data platform with modern architecture. Introduced Airflow on Kubernetes, Terraform-managed Snowflake/Postgres, and defined GitOps workflows.",
    achievements: ["Modernized data infrastructure", "Implemented Terraform IaC", "Established data platform standards"],
    isPromotion: false
  },
  {
    company: "New Relic",
    logo: newRelicLogo,
    role: "Senior Data Engineer → Lead Data Analyst",
    period: "2018 – 2021",
    year: "2018",
    description: "Led roadmap and development of New Relic's core data engineering platform. Architected key features including blue/green deployments, testing, orchestration, and self-service tooling. Introduced and implemented dbt.",
    achievements: ["Implemented dbt for data transformation", "Optimized analytics pipelines", "Developed Spark pipelines for multiple data sources"],
    isPromotion: false
  },
  {
    company: "Oracle",
    logo: oracleLogo,
    role: "Senior Business Analyst",
    period: "2013 – 2018",
    year: "2013",
    description: "Partnered with R&D, manufacturing, supply chain, and marketing to implement enterprise solutions. Executed on-prem to cloud migration for Oracle's Worldwide SCM systems.",
    achievements: ["Re-engineered forecasting pipelines (4hrs→20min)", "Built predictive manufacturing applications", "Optimized headcount and factory utilization"],
    isPromotion: false
  }
];

// Generate unique IDs for tooltips
const tooltipIds = timeline.map((_, index) => `timeline-tooltip-${index}`);
---

<div class="relative w-full pt-6 pb-12 px-4 sm:px-6 space-y-8">
  {[...timeline].map((item) => (
    <div class="bg-white/5 dark:bg-white/10 backdrop-blur-md rounded-xl p-5 shadow-md border border-[var(--border-color)] relative">
      <div class="absolute left-[-1.25rem] top-6 w-2 h-2 bg-accent-color rounded-full hidden sm:block"></div>
      <div class="flex items-center gap-3 mb-3">
        <div class="w-9 h-9 rounded-md bg-white p-1 shadow-sm flex items-center justify-center">
          <img src={item.logo.src} alt={item.company + ' logo'} class="object-contain max-w-full max-h-full" />
        </div>
        <div>
          <h3 class="text-base font-bold text-[var(--text-primary)] leading-tight">{item.role}</h3>
          <p class="text-xs text-[var(--text-secondary)]">{item.company}</p>
        </div>
      </div>
      <p class="text-xs text-[var(--text-secondary)] mb-2">
        <span class="font-semibold text-[var(--text-primary)]">Years Active:</span> {item.period}
      </p>
      <p class="text-xs text-[var(--text-secondary)] mb-4">
        <span class="font-semibold text-[var(--text-primary)]">Summary:</span> {item.description}
      </p>
      {item.achievements?.length > 0 && (
        <div>
          <p class="text-xs font-semibold text-[var(--text-primary)] mb-1">Notable Contributions:</p>
          <ul class="list-disc list-inside space-y-1 text-xs text-[var(--text-tertiary)]">
            {item.achievements.map((ach) => (
              <li>{ach}</li>
            ))}
          </ul>
        </div>
      )}
    </div>
  ))}
</div>

<style>
  .timeline-wrapper {
    position: relative;
    overflow: hidden;
    border-radius: 0.75rem;
  }

  /* Responsive adjustments */
  @media (max-width: 640px) {
    .timeline-wrapper {
      padding-left: 0;
      padding-right: 0;
    }
  }
</style>
