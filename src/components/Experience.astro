---
import SectionHeader from './SectionHeader.astro';
import { experience } from '../data/experience';
---

<section class="section-pad" id="experience" style="border-top: var(--rule);">
  <div class="max-w-6xl mx-auto px-5 sm:px-8">
    <SectionHeader number="02" title="Experience" />

    <div class="mt-4 sm:mt-6">
      {experience.map((item, i) => (
        <details class="xp reveal-item" open={item.defaultOpen}>
          <summary>
            <span class="xp-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <span class="xp-heading">
              <span class="xp-role">{item.role}</span>
              <span class="xp-meta">{item.company} · {item.period}</span>
            </span>
            <span class="xp-toggle" aria-hidden="true"></span>
          </summary>
          <div class="xp-body">
            <p class="xp-desc">{item.description}</p>
            <ul class="xp-chips" role="list">
              {item.achievements.map((a) => (
                <li class="xp-chip">{a}</li>
              ))}
            </ul>
          </div>
        </details>
      ))}
    </div>

    <p class="xp-edu reveal-item">
      University of Oregon, Information Systems and Operations Management
    </p>
  </div>
</section>

<style>
  .xp {
    border-bottom: 1px solid var(--hairline-color);
  }

  .xp summary {
    display: flex;
    align-items: baseline;
    gap: 1.25rem;
    padding: 1.25rem 0;
    cursor: pointer;
    list-style: none;
    position: relative;
  }

  /* Accent rule slides in from the left edge on hover */
  .xp summary::before {
    content: '';
    position: absolute;
    left: -1.25rem;
    top: 25%;
    bottom: 25%;
    width: 3px;
    background-color: var(--accent-color);
    transform: scaleY(0);
    transform-origin: top;
    transition: transform var(--duration-normal) var(--ease-out);
  }

  .xp summary:hover::before,
  .xp[open] summary::before {
    transform: scaleY(1);
  }

  @media (prefers-reduced-motion: reduce) {
    .xp summary::before {
      transition: none;
    }
  }

  .xp summary::-webkit-details-marker {
    display: none;
  }

  .xp-num {
    font-family: var(--font-heading);
    font-weight: 900;
    font-size: 1.625rem;
    line-height: 1;
    color: var(--accent-color);
    flex-shrink: 0;
  }

  .xp-heading {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    min-width: 0;
  }

  .xp-role {
    font-family: var(--font-heading);
    font-weight: 900;
    font-size: clamp(1rem, 2.6vw, 1.375rem);
    line-height: 1.15;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    color: var(--text-color);
    transition: color var(--duration-fast) var(--ease-out);
  }

  .xp summary:hover .xp-role {
    color: var(--accent-text);
  }

  .xp-meta {
    font-family: var(--font-body);
    font-size: 0.8125rem;
    color: var(--text-secondary);
  }

  .xp-toggle {
    flex-shrink: 0;
    align-self: center;
    font-family: var(--font-mono);
    font-size: 1.125rem;
    font-weight: 500;
    color: var(--accent-text);
  }

  .xp-toggle::before {
    content: '+';
  }

  .xp[open] .xp-toggle::before {
    content: '−';
  }

  .xp-body {
    padding: 0 0 1.5rem calc(1.625rem + 1.25rem);
  }

  @media (max-width: 540px) {
    .xp-body {
      padding-left: 0;
    }
  }

  .xp-edu {
    margin-top: 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-tertiary);
  }

  .xp-desc {
    font-family: var(--font-body);
    font-size: 0.875rem;
    line-height: 1.65;
    color: var(--text-secondary);
    max-width: 34rem;
  }

  .xp-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1rem;
    padding: 0;
  }

  .xp-chip {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent-text);
    border: 1px solid color-mix(in srgb, var(--accent-text) 45%, transparent);
    padding: 0.375rem 0.625rem;
    list-style: none;
  }

  /* Smooth open where supported, skipped under reduced motion */
  @supports (interpolate-size: allow-keywords) {
    @media (prefers-reduced-motion: no-preference) {
      .xp::details-content {
        block-size: 0;
        overflow-y: clip;
        transition: content-visibility var(--duration-slow) allow-discrete,
          block-size var(--duration-slow) var(--ease-out);
        interpolate-size: allow-keywords;
      }
      .xp[open]::details-content {
        block-size: auto;
      }
    }
  }
</style>
