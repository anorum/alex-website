---
import RPGContainer from './rpg/RPGContainer.astro';
---

<!-- Standard Content (visible by default) -->
<div class="standard-content">
  <slot />
</div>

<!-- RPG Content (hidden by default) -->
<div class="rpg-content hidden">
  <RPGContainer />
</div>

<script is:inline>
  document.addEventListener('DOMContentLoaded', function() {
    updateRPGContent();
  });
  
  document.addEventListener('astro:page-load', function() {
    updateRPGContent();
  });
  
  function updateRPGContent() {
    const currentTheme = localStorage.getItem('site-theme') || 'standard';
    const standardContent = document.querySelector('.standard-content');
    const rpgContent = document.querySelector('.rpg-content');
    
    console.log('RPGWrapper - Current theme:', currentTheme);
    
    if (currentTheme === 'rpg') {
      standardContent?.classList.add('hidden');
      rpgContent?.classList.remove('hidden');
      console.log('RPGWrapper - Showing RPG content');
    } else {
      standardContent?.classList.remove('hidden');
      rpgContent?.classList.add('hidden');
      console.log('RPGWrapper - Showing standard content');
    }
  }
  
  // Listen for theme changes
  window.addEventListener('storage', function(event) {
    if (event.key === 'site-theme') {
      updateRPGContent();
    }
  });
  
  // Custom event for theme changes
  document.addEventListener('themeChanged', function() {
    console.log('RPGWrapper - themeChanged event received');
    updateRPGContent();
  });
</script>

<style>
  .hidden {
    display: none;
  }
</style>
