---
import RPGContainer from './rpg/RPGContainer.astro';
---

<!-- Standard Content (visible by default) -->
<div class="standard-content">
  <slot />
</div>

<!-- RPG Content (hidden by default) -->
<div class="rpg-content hidden">
  <RPGContainer />
</div>

<script is:inline>
  document.addEventListener('DOMContentLoaded', updateRPGContent);
  
  function updateRPGContent() {
    const currentTheme = localStorage.getItem('site-theme') || 'standard';
    const standardContent = document.querySelector('.standard-content');
    const rpgContent = document.querySelector('.rpg-content');
    
    if (currentTheme === 'rpg') {
      standardContent?.classList.add('hidden');
      rpgContent?.classList.remove('hidden');
    } else {
      standardContent?.classList.remove('hidden');
      rpgContent?.classList.add('hidden');
    }
  }
  
  window.addEventListener('storage', event => {
    if (event.key === 'site-theme') updateRPGContent();
  });
  
  document.addEventListener('themeChanged', updateRPGContent);
</script>

<style>
  .hidden {
    display: none;
  }
</style>
