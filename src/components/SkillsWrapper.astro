---
import SkillsGroup from './SkillsGroup.astro';
import SkillsRPG from './rpg/SkillsRPG.astro';
---

<!-- Standard Skills (visible by default) -->
<div class="standard-skills">
  <div class="max-w-4xl mx-auto px-4">
    <div class="flex items-center gap-3 mb-10">
      <div class="h-px flex-1 bg-accent-color opacity-30"></div>
      <h2 class="text-2xl sm:text-3xl font-bold whitespace-nowrap">Core Skills</h2>
      <div class="h-px flex-1 bg-accent-color opacity-30"></div>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-16">
      <!-- Data Engineering Skills -->
      <div class="skills-category">
        <h3 class="text-lg font-semibold text-[var(--text-secondary)] mb-3">Data Engineering</h3>
        <SkillsGroup 
          title="Data Platforms & Processing" 
          skills={["Snowflake", "BigQuery", "Redshift", "Databricks", "Airflow", "dbt", "Spark", "Kafka"]}
          colorScheme="blue"
        />
      </div>
      
      <!-- Infrastructure Skills -->
      <div class="skills-category">
        <h3 class="text-lg font-semibold text-[var(--text-secondary)] mb-3">Infrastructure</h3>
        <SkillsGroup 
          title="Cloud & DevOps" 
          skills={["AWS", "GCP", "Terraform", "Kubernetes"]}
          colorScheme="green"
        />
        
        <div class="h-4"></div>
        
        <SkillsGroup 
          title="Monitoring & Reliability" 
          skills={["Datadog", "Prometheus", "Grafana", "SLOs"]}
          colorScheme="green"
        />
      </div>
      
      <!-- Leadership Skills -->
      <div class="skills-category md:col-span-2 mt-12">
        <h3 class="text-lg font-semibold text-[var(--text-secondary)] mb-4">Leadership & Strategy</h3>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <SkillsGroup 
            title="Team Leadership" 
            skills={["Engineering Management", "Mentoring", "Technical Roadmaps", "Cross-team Collaboration"]}
            colorScheme="purple"
          />
          
          <SkillsGroup 
            title="Strategic Planning" 
            skills={["System Design", "Technical Strategy", "Process Optimization", "Stakeholder Management"]}
            colorScheme="purple"
          />
        </div>
      </div>
    </div>
    
    <!-- Interactive skills visualization -->
    <div class="mt-12 p-6 rounded-xl bg-bubble-bg border border-border-color">
      <h3 class="text-xl font-semibold mb-4">My Engineering Philosophy</h3>
      
      <ul class="space-y-4 text-muted">
        <li>🧰 A great system isn't just well-designed — it's usable, intuitive, and easy to hand off.</li>
        <li>🚦 Good platforms enable self-sufficiency. They guide teams toward best practices without requiring constant involvement.</li>
        <li>🪄 Make the right path easy, the wrong path hard — but never block flexibility where it's needed.</li>
        <li>📦 Simplicity beats technical novelty. Solve the real problem, not the most interesting one.</li>
        <li>📚 Clear documentation, practical playbooks, and reusable patterns scale more than heroics.</li>
      </ul>
    </div>
  </div>
</div>

<!-- RPG Skills (hidden by default) -->
<div class="rpg-skills hidden">
  <SkillsRPG />
</div>

<script>
  import { getTheme } from '../utils/theme-context';
  
  function updateSkills() {
    const currentTheme = getTheme();
    const standardSkills = document.querySelector('.standard-skills');
    const rpgSkills = document.querySelector('.rpg-skills');
    
    if (currentTheme === 'rpg') {
      standardSkills?.classList.add('hidden');
      rpgSkills?.classList.remove('hidden');
    } else {
      standardSkills?.classList.remove('hidden');
      rpgSkills?.classList.add('hidden');
    }
  }
  
  // Run on initial load
  document.addEventListener('DOMContentLoaded', updateSkills);
  
  // Run when theme changes
  document.addEventListener('astro:page-load', updateSkills);
  
  // Listen for theme changes
  window.addEventListener('storage', (event) => {
    if (event.key === 'site-theme') {
      updateSkills();
    }
  });
  
  // Custom event for theme changes
  document.addEventListener('themeChanged', updateSkills);
</script>

<style>
  .hidden {
    display: none;
  }
</style>
