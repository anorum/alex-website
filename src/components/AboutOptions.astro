---
import { Image } from 'astro:assets';
import meImage from '../assets/me.jpeg';
---

<div class="py-12">
  <div class="text-center mb-10">
    <h2 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white mb-4">Choose Your Experience</h2>
    <p class="text-lg text-gray-600 dark:text-gray-400 max-w-3xl mx-auto">
      Learn about Alex in the way that works best for you
    </p>
  </div>

  <div class="grid lg:grid-cols-2 gap-8">
    <!-- Read About Alex Option -->
    <div class="bg-gradient-to-r from-blue-50 to-indigo-50 dark:from-blue-900/30 dark:to-indigo-900/30 rounded-xl overflow-hidden shadow-lg">
      <!-- Image at the top for all screen sizes -->
      <div class="relative h-64 overflow-hidden">
        <Image 
          src={meImage} 
          alt="Alex Norum" 
          class="object-cover w-full h-full"
          width={600}
          height={400}
        />
        <div class="absolute inset-0 bg-gradient-to-t from-blue-900/60 to-transparent"></div>
      </div>
      
      <!-- Content below image -->
      <div class="p-8">
        <div class="flex items-center mb-4">
          <div class="w-12 h-12 rounded-full bg-blue-100 dark:bg-blue-800 flex items-center justify-center mr-4">
            <svg class="w-6 h-6 text-blue-600 dark:text-blue-300" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
            </svg>
          </div>
          <h2 class="text-2xl font-bold text-gray-900 dark:text-white">Read About Alex</h2>
        </div>
        
        <p class="text-lg text-gray-600 dark:text-gray-300 mb-6">
          Explore Alex's professional background, skills, and interests through a traditional reading experience. Learn about his work history, technical expertise, and personal projects.
        </p>
        
        <ul class="space-y-3 mb-8">
          <li class="flex items-start">
            <svg class="w-5 h-5 mr-2 text-blue-500 mt-1 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            <span class="text-gray-600 dark:text-gray-300">Professional background and work history</span>
          </li>
          <li class="flex items-start">
            <svg class="w-5 h-5 mr-2 text-blue-500 mt-1 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            <span class="text-gray-600 dark:text-gray-300">Technical skills and expertise</span>
          </li>
          <li class="flex items-start">
            <svg class="w-5 h-5 mr-2 text-blue-500 mt-1 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            <span class="text-gray-600 dark:text-gray-300">Education and personal interests</span>
          </li>
        </ul>
        
        <button id="show-traditional-content" class="inline-flex items-center px-6 py-3 bg-blue-600 hover:bg-blue-700 text-white font-medium rounded-lg transition-colors">
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
          </svg>
          View Traditional Content
        </button>
      </div>
    </div>

    <!-- Chat with Mara Option -->
    <div class="bg-gradient-to-r from-purple-50 to-blue-50 dark:from-purple-900/30 dark:to-blue-900/30 rounded-xl overflow-hidden shadow-lg">
      <!-- Image at the top for all screen sizes with chat bubbles -->
      <div class="relative h-64 overflow-hidden bg-gradient-to-r from-purple-600 to-blue-700">
        <div class="absolute top-0 left-0 w-full h-full opacity-10">
          <svg width="100%" height="100%" viewBox="0 0 100 100" preserveAspectRatio="none">
            <pattern id="pattern-circles" x="0" y="0" width="20" height="20" patternUnits="userSpaceOnUse" patternContentUnits="userSpaceOnUse">
              <circle id="pattern-circle" cx="10" cy="10" r="2" fill="#ffffff"></circle>
            </pattern>
            <rect x="0" y="0" width="100%" height="100%" fill="url(#pattern-circles)"></rect>
          </svg>
        </div>
        
        <!-- Chat bubbles in the image section -->
        <div class="absolute inset-0 flex items-center justify-center">
          <div class="relative z-10 max-w-xs">
            <div class="flex items-center justify-center">
              <!-- Mara logo -->
              <div class="relative">
                <img src="/mara_logo.png" alt="Mara" class="w-28 h-28 rounded-full border-4 border-white shadow-lg mb-4" />
                
                <!-- Chat bubbles -->
                <div class="mt-4">
                  <div class="bg-white dark:bg-gray-800 rounded-lg p-3 shadow-md mb-3 transform -rotate-1">
                    <p class="text-sm text-gray-700 dark:text-gray-300">What projects has Alex worked on?</p>
                  </div>
                  
                  <div class="bg-blue-100 dark:bg-blue-900 rounded-lg p-3 shadow-md ml-8 mb-3 transform rotate-1">
                    <p class="text-sm text-gray-800 dark:text-gray-200">Alex has led data platform engineering at LegalZoom...</p>
                  </div>
                  
                  <div class="bg-white dark:bg-gray-800 rounded-lg p-3 shadow-md mb-3 transform -rotate-2">
                    <p class="text-sm text-gray-700 dark:text-gray-300">What technologies does Alex specialize in?</p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
        
        <div class="absolute inset-0 bg-gradient-to-t from-purple-900/60 to-transparent"></div>
      </div>
      
      <!-- Content below image -->
      <div class="p-8">
        <div class="flex items-center mb-4">
          <img src="/mara_logo.png" alt="Mara" class="w-16 h-16 rounded-full border-4 border-white shadow-lg mr-4" />
          <h2 class="text-2xl font-bold text-gray-900 dark:text-white">Chat with Mara</h2>
        </div>
        
        <p class="text-lg text-gray-600 dark:text-gray-300 mb-6">
          Have questions about Alex? Chat with Mara, an AI assistant modeled after Alex's Australian Labradoodle. Mara has been trained on Alex's data and can help answer your questions instantly.
        </p>
        
        
        <ul class="space-y-3 mb-8">
          <li class="flex items-start">
            <svg class="w-5 h-5 mr-2 text-purple-500 mt-1 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            <span class="text-gray-600 dark:text-gray-300">Ask questions about Alex's experience and skills</span>
          </li>
          <li class="flex items-start">
            <svg class="w-5 h-5 mr-2 text-purple-500 mt-1 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            <span class="text-gray-600 dark:text-gray-300">Get personalized responses to your questions</span>
          </li>
        </ul>
        
        <button id="open-mara-chat" class="inline-flex items-center px-6 py-3 bg-gradient-to-r from-purple-600 to-blue-500 hover:from-purple-700 hover:to-blue-600 text-white font-medium rounded-lg transition-colors">
          <img src="/mara_logo.png" alt="" class="w-5 h-5 mr-2 rounded-full" />
          Chat with Mara
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('astro:page-load', () => {
    // Handle "Chat with Mara" button click
    const openMaraButton = document.getElementById('open-mara-chat');
    if (openMaraButton) {
      openMaraButton.addEventListener('click', () => {
        // Dispatch a custom event to open the integrated chat panel
        document.dispatchEvent(new CustomEvent('open-fullscreen-chatbot'));
      });
    }

    // Handle "View Traditional Content" button click
    const showTraditionalButton = document.getElementById('show-traditional-content');
    const traditionalContent = document.getElementById('traditional-content');
    const optionsSection = document.getElementById('options-section');
    
    if (showTraditionalButton && traditionalContent && optionsSection) {
      showTraditionalButton.addEventListener('click', () => {
        // Hide options section
        optionsSection.classList.add('hidden');
        
        // Show traditional content with a smooth animation
        traditionalContent.classList.remove('hidden');
        traditionalContent.classList.add('animate-fade-in');
        
        // Scroll to the content with smooth behavior
        traditionalContent.scrollIntoView({ behavior: 'smooth' });
      });
    }
  });
</script>

<style>
  .animate-fade-in {
    animation: fadeIn 0.5s ease-in-out;
  }
  
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>
