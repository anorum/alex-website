---
interface Props {
  degree: string;
  institution: string;
  startYear: string;
  endYear?: string;
  location?: string;
  description?: string;
  gpa?: string;
  honors?: string[];
}

const { 
  degree, 
  institution, 
  startYear, 
  endYear = "Present", 
  location,
  description,
  gpa,
  honors = []
} = Astro.props;

// Format the year range
const yearRange = `${startYear} - ${endYear}`;
---

<div class="bg-gray-50 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg p-6 mb-4">
  <h3 class="text-lg font-semibold text-gray-900 dark:text-white">{degree}</h3>
  <p class="text-base text-gray-500 dark:text-gray-400">{institution}</p>
  <p class="text-sm text-gray-500 dark:text-gray-400">{yearRange}</p>
  
  {location && 
    <div class="mt-2 text-sm font-normal text-gray-500 dark:text-gray-400">
      <svg class="w-4 h-4 inline-block mr-1" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
        <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"></path>
      </svg>
      {location}
    </div>
  }
  
  {gpa && 
    <div class="mt-2 text-sm font-normal text-gray-500 dark:text-gray-400">
      <span class="font-medium">GPA:</span> {gpa}
    </div>
  }
  
  {description && 
    <p class="mt-3 text-base text-gray-500 dark:text-gray-400">{description}</p>
  }
  
  {honors.length > 0 && 
    <div class="mt-3">
      <p class="text-sm font-medium text-gray-700 dark:text-gray-300">Honors & Awards:</p>
      <ul class="list-disc list-inside text-sm text-gray-500 dark:text-gray-400 mt-1">
        {honors.map(honor => (
          <li>{honor}</li>
        ))}
      </ul>
    </div>
  }
  
  <slot />
</div>
