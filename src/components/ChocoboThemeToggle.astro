---
import chocoboIcon from '../assets/cocoboicon.png';
---

<div class="chocobo-theme-toggle" id="chocobo-container">
  <button id="chocobo-toggle-btn" aria-label="Toggle RPG Theme">
    <img src={chocoboIcon.src} alt="Chocobo" class="chocobo-icon" />
  </button>
  <div id="chocobo-tooltip" class="tooltip">Wark?</div>
</div>

<div id="ff-achievement" class="achievement">
  <div class="achievement-content">
    <img src={chocoboIcon.src} alt="Chocobo" class="achievement-icon" />
    <div class="achievement-text">
      <h3>Achievement Unlocked!</h3>
      <p>Final Fantasy Mode Activated</p>
    </div>
  </div>
</div>

<script is:inline>
  (function() {
    function init() {
      var btn = document.getElementById('chocobo-toggle-btn');
      var container = document.getElementById('chocobo-container');
      if (!btn || !container) return;

      var theme = localStorage.getItem('site-theme') || 'standard';
      if (theme === 'rpg') btn.classList.add('active');

      btn.addEventListener('click', function() {
        var current = localStorage.getItem('site-theme') || 'standard';
        var next = current === 'rpg' ? 'standard' : 'rpg';

        document.documentElement.classList.forEach(function(c) {
          if (c.startsWith('theme-')) document.documentElement.classList.remove(c);
        });
        document.documentElement.classList.add('theme-' + next);
        localStorage.setItem('site-theme', next);
        document.dispatchEvent(new CustomEvent('theme:change', { detail: { theme: next } }));
        window.scrollTo(0, 0);

        if (next === 'rpg') {
          btn.classList.add('active');
          playSound(0.3);
          if (!localStorage.getItem('ff-mode-unlocked')) {
            localStorage.setItem('ff-mode-unlocked', 'true');
            showAchievement();
          }
        } else {
          btn.classList.remove('active');
        }
      });

      container.addEventListener('mouseenter', function() { container.classList.add('hover'); });
      container.addEventListener('mouseleave', function() { container.classList.remove('hover'); });
    }

    function playSound(vol) {
      try {
        var a = new Audio('data:audio/wav;base64,');
        a.volume = vol;
        a.play().catch(function(){});
      } catch(e) {}
    }

    function showAchievement() {
      var el = document.getElementById('ff-achievement');
      if (!el) return;
      el.classList.add('visible');
      setTimeout(function() { el.classList.remove('visible'); }, 5000);
    }

    document.addEventListener('DOMContentLoaded', init);
  })();
</script>

<style>
  .chocobo-theme-toggle {
    position: fixed;
    left: 1rem;
    bottom: 1rem;
    z-index: 1001;
    transform: translateX(-70%);
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .chocobo-theme-toggle.hover { transform: translateX(0); }

  #chocobo-toggle-btn {
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background-color: rgba(255, 255, 255, 0.1);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
    animation: gentleFloat 3s ease-in-out infinite;
    transition: box-shadow 0.2s ease;
  }
  #chocobo-toggle-btn:hover { box-shadow: 0 3px 12px rgba(0, 0, 0, 0.12); }

  @keyframes gentleFloat {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-3px); }
  }

  .chocobo-icon {
    width: 32px;
    height: 32px;
    object-fit: contain;
    transition: filter 0.3s ease;
  }
  #chocobo-toggle-btn.active .chocobo-icon {
    filter: drop-shadow(0 0 5px rgba(255, 215, 0, 0.5));
  }

  .tooltip {
    position: absolute;
    top: -30px;
    left: 0;
    background-color: rgba(0, 0, 0, 0.75);
    color: white;
    padding: 4px 8px;
    border-radius: 4px;
    font-size: 11px;
    font-family: 'Press Start 2P', monospace;
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s ease;
  }
  .chocobo-theme-toggle.hover .tooltip { opacity: 1; }

  .achievement {
    position: fixed;
    top: 20px;
    left: 50%;
    transform: translateX(-50%) translateY(-120px);
    background-color: rgba(0, 0, 0, 0.88);
    border: 2px solid #ffcc00;
    border-radius: 8px;
    padding: 12px 16px;
    z-index: 2000;
    transition: transform 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3);
    width: 280px;
    pointer-events: none;
  }
  .achievement.visible { transform: translateX(-50%) translateY(0); }

  .achievement-content { display: flex; align-items: center; gap: 12px; }
  .achievement-icon {
    width: 32px;
    height: 32px;
    filter: drop-shadow(0 0 5px rgba(255, 215, 0, 0.7));
  }
  .achievement-text { color: white; font-family: 'Press Start 2P', monospace; }
  .achievement-text h3 { margin: 0 0 4px; font-size: 0.7rem; color: #ffcc00; }
  .achievement-text p { margin: 0; font-size: 0.6rem; }

  @media (max-width: 768px) {
    .chocobo-theme-toggle { left: 0.5rem; bottom: 0.5rem; }
    #chocobo-toggle-btn { width: 36px; height: 36px; }
    .chocobo-icon { width: 28px; height: 28px; }
  }
</style>
