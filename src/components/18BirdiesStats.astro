---
// Import the date utility
import { formatDate } from '../utils/date';

// Define interfaces for our data
interface GolfRound {
  id: string;
  timestamp: string;
  date: string;
  club: string;
  club_id: string;
  score: number;
  strokes: number;
  hole_strokes: number[];
  stats: {
    aces: number;
    double_eagle_or_better: number;
    eagles: number;
    birdies: number;
    pars: number;
    bogeys: number;
    double_bogey_or_worse: number;
    fairway_lefts: number;
    fairway_middles: number;
    fairway_rights: number;
    fairway_hole_count: number;
    gir: number;
    gir_hole_count: number;
    [key: string]: number;
  };
  holes_played: number;
}

interface GolfClub {
  club_id: string;
  name: string;
}

interface CumulativeStats {
  total_birdies: number;
  total_pars: number;
  total_bogeys: number;
  total_eagles: number;
  total_aces: number;
  total_double_bogey_or_worse: number;
  total_fairways_missed_left: number;
  total_fairways_missed_right: number;
  total_fairways_hit: number;
  total_gir: number;
  total_rounds: number;
  total_holes_played: number;
  average_score: number;
  [key: string]: number | string | null;
}

interface GolfData {
  cumulative_stats: CumulativeStats;
  rounds: GolfRound[];
  clubs: GolfClub[];
}

interface ProcessedRound {
  id: string;
  date: Date;
  courseName: string;
  score: number;
  strokes: number;
  stats: {
    [key: string]: number;
  };
}

interface CourseCount {
  name: string;
  count: number;
}

interface YearlyData {
  year: number;
  count: number;
}

interface YearlyScoreData {
  year: number;
  averageScore: number;
}

interface YearlyHandicapData {
  year: number;
  handicap: number;
}

// Define the API URL
const apiUrl = '/api/golf-stats.json';

// Initialize loading state
let isLoading = true;
let hasError = false;
let errorMessage = '';

// Initialize variables
let golfData: GolfData | null = null;
let roundsData: GolfRound[] = [];
let clubsData: GolfClub[] = [];
let totalRounds = 0;
let recentRounds: ProcessedRound[] = [];
let handicapIndex = 0;
let mostPlayedCourses: CourseCount[] = [];
let yearlyReading: YearlyData[] = [];
let yearlyScores: YearlyScoreData[] = [];
let yearlyHandicaps: YearlyHandicapData[] = [];
let statsTotal = {
  aces: 0,
  eagles: 0,
  birdies: 0,
  pars: 0,
  bogeys: 0,
  doubleBogeyOrWorse: 0,
  fairwayHits: 0,
  fairwayAttempts: 0,
  girHits: 0,
  girAttempts: 0
};
let fairwayPercentage = 0;
let girPercentage = 0;

// Check if we have cached data in sessionStorage
let cachedData = null;
if (typeof window !== 'undefined' && window.sessionStorage) {
  const cached = sessionStorage.getItem('golfStatsCache');
  if (cached) {
    try {
      const { data, timestamp } = JSON.parse(cached);
      // Use cache if it's less than 15 minutes old
      if (Date.now() - timestamp < 15 * 60 * 1000) {
        cachedData = data;
        console.log('Using cached Golf data');
      }
    } catch (e) {
      console.error('Error parsing cached Golf data:', e);
    }
  }
}

try {
  if (cachedData) {
    // Use cached data
    golfData = cachedData;
    
    // Process the data
    if (golfData) {
      // Get rounds data
      roundsData = golfData.rounds || [];
      
      // Get clubs data
      clubsData = golfData.clubs || [];
      
      // Get total rounds count
      totalRounds = golfData.cumulative_stats?.total_rounds || 0;
      
      // Get recent rounds (last 5 with valid scores)
      recentRounds = roundsData
        .filter((round) => round.strokes > 0)
        .slice(0, 5)
        .map((round) => {
          const club = clubsData.find((club) => club.club_id === round.club_id);
          return {
            id: round.id,
            date: new Date(parseInt(round.timestamp)),
            courseName: club ? club.name : 'Unknown Course',
            score: round.score,
            strokes: round.strokes,
            stats: round.stats
          };
        });
      
      // Get handicap index
      handicapIndex = golfData.cumulative_stats?.average_score || 0;
      
      // Calculate most played courses
      const courseCounts: Record<string, number> = {};
      roundsData.forEach((round) => {
        const club = clubsData.find((club) => club.club_id === round.club_id);
        if (club && club.name) {
          courseCounts[club.name] = (courseCounts[club.name] || 0) + 1;
        }
      });
      
      mostPlayedCourses = Object.entries(courseCounts)
        .map(([name, count]): CourseCount => ({ name, count }))
        .sort((a, b) => b.count - a.count)
        .slice(0, 5);
      
      // Calculate rounds by year
      const roundsByYear: Record<number, number> = {};
      const scoresByYear: Record<number, number> = {};
      const scoreCountByYear: Record<number, number> = {};
      const handicapByYear: Record<number, number> = {};
      
      roundsData.forEach((round) => {
        if (round.timestamp) {
          const date = new Date(parseInt(round.timestamp));
          const year = date.getFullYear();
          
          // Count rounds per year
          roundsByYear[year] = (roundsByYear[year] || 0) + 1;
          
          // Sum scores per year (for calculating average)
          if (round.score !== undefined) {
            scoresByYear[year] = (scoresByYear[year] || 0) + round.score;
            scoreCountByYear[year] = (scoreCountByYear[year] || 0) + 1;
          }
        }
      });
      
      // Create yearly stats arrays
      yearlyReading = Object.entries(roundsByYear)
        .map(([year, count]) => ({ year: parseInt(year), count: count as number }))
        .sort((a, b) => b.year - a.year); // Sort descending by year (newest first)
      
      yearlyScores = Object.entries(scoresByYear)
        .map(([year, totalScore]) => {
          const count = scoreCountByYear[parseInt(year)] || 0;
          const averageScore = count > 0 ? parseFloat((totalScore / count).toFixed(1)) : 0;
          return { year: parseInt(year), averageScore };
        })
        .sort((a, b) => b.year - a.year); // Sort descending by year (newest first)
      
      yearlyHandicaps = Object.entries(handicapByYear)
        .map(([year, handicap]) => ({ year: parseInt(year), handicap: handicap }))
        .sort((a, b) => b.year - a.year); // Sort descending by year (newest first)
      
      // Calculate overall stats
      if (golfData.cumulative_stats) {
        statsTotal = {
          aces: golfData.cumulative_stats.total_aces || 0,
          eagles: golfData.cumulative_stats.total_eagles || 0,
          birdies: golfData.cumulative_stats.total_birdies || 0,
          pars: golfData.cumulative_stats.total_pars || 0,
          bogeys: golfData.cumulative_stats.total_bogeys || 0,
          doubleBogeyOrWorse: golfData.cumulative_stats.total_double_bogey_or_worse || 0,
          fairwayHits: golfData.cumulative_stats.total_fairways_hit || 0,
          fairwayAttempts: golfData.cumulative_stats.total_fairways_hit + 
                          golfData.cumulative_stats.total_fairways_missed_left + 
                          golfData.cumulative_stats.total_fairways_missed_right || 0,
          girHits: golfData.cumulative_stats.total_gir || 0,
          girAttempts: golfData.cumulative_stats.total_holes_played || 0
        };
      }
      
      // Calculate percentages
      fairwayPercentage = statsTotal.fairwayAttempts > 0 
        ? Math.round((statsTotal.fairwayHits / statsTotal.fairwayAttempts) * 100) 
        : 0;
      
      girPercentage = statsTotal.girAttempts > 0 
        ? Math.round((statsTotal.girHits / statsTotal.girAttempts) * 100) 
        : 0;
    }
    
    isLoading = false;
  } else {
    // Fetch data from the API
    // For now, we'll use a local JSON file since the API endpoint might not exist
    // In a real application, you would fetch from the actual API
    try {
      // Try to fetch from the API endpoint
      const response = await fetch(apiUrl);
      
      if (!response.ok) {
        throw new Error(`API request failed: ${response.status}`);
      }
      
      golfData = await response.json();
      
      // Cache the data in sessionStorage
      if (typeof window !== 'undefined' && window.sessionStorage) {
        sessionStorage.setItem('golfStatsCache', JSON.stringify({
          data: golfData,
          timestamp: Date.now()
        }));
      }
      
      // Process the data (same as above)
      if (golfData) {
        // Get rounds data
        roundsData = golfData.rounds || [];
        
        // Get clubs data
        clubsData = golfData.clubs || [];
        
        // Get total rounds count
        totalRounds = golfData.cumulative_stats?.total_rounds || 0;
        
        // Get recent rounds (last 5 with valid scores)
        recentRounds = roundsData
          .filter((round) => round.strokes > 0)
          .slice(0, 5)
          .map((round) => {
            const club = clubsData.find((club) => club.club_id === round.club_id);
            return {
              id: round.id,
              date: new Date(parseInt(round.timestamp)),
              courseName: club ? club.name : 'Unknown Course',
              score: round.score,
              strokes: round.strokes,
              stats: round.stats
            };
          });
        
        // Get handicap index
        handicapIndex = golfData.cumulative_stats?.average_score || 0;
        
        // Calculate most played courses
        const courseCounts: Record<string, number> = {};
        roundsData.forEach((round) => {
          const club = clubsData.find((club) => club.club_id === round.club_id);
          if (club && club.name) {
            courseCounts[club.name] = (courseCounts[club.name] || 0) + 1;
          }
        });
        
        mostPlayedCourses = Object.entries(courseCounts)
          .map(([name, count]): CourseCount => ({ name, count }))
          .sort((a, b) => b.count - a.count)
          .slice(0, 5);
        
        // Calculate rounds by year
        const roundsByYear: Record<number, number> = {};
        const scoresByYear: Record<number, number> = {};
        const scoreCountByYear: Record<number, number> = {};
        const handicapByYear: Record<number, number> = {};
        
        roundsData.forEach((round) => {
          if (round.timestamp) {
            const date = new Date(parseInt(round.timestamp));
            const year = date.getFullYear();
            
            // Count rounds per year
            roundsByYear[year] = (roundsByYear[year] || 0) + 1;
            
            // Sum scores per year (for calculating average)
            if (round.score !== undefined) {
              scoresByYear[year] = (scoresByYear[year] || 0) + round.score;
              scoreCountByYear[year] = (scoreCountByYear[year] || 0) + 1;
            }
          }
        });
        
        // Create yearly stats arrays
        yearlyReading = Object.entries(roundsByYear)
          .map(([year, count]) => ({ year: parseInt(year), count: count as number }))
          .sort((a, b) => b.year - a.year); // Sort descending by year (newest first)
        
        yearlyScores = Object.entries(scoresByYear)
          .map(([year, totalScore]) => {
            const count = scoreCountByYear[parseInt(year)] || 0;
            const averageScore = count > 0 ? parseFloat((totalScore / count).toFixed(1)) : 0;
            return { year: parseInt(year), averageScore };
          })
          .sort((a, b) => b.year - a.year); // Sort descending by year (newest first)
        
        yearlyHandicaps = Object.entries(handicapByYear)
          .map(([year, handicap]) => ({ year: parseInt(year), handicap: handicap }))
          .sort((a, b) => b.year - a.year); // Sort descending by year (newest first)
        
        // Calculate overall stats
        if (golfData.cumulative_stats) {
          statsTotal = {
            aces: golfData.cumulative_stats.total_aces || 0,
            eagles: golfData.cumulative_stats.total_eagles || 0,
            birdies: golfData.cumulative_stats.total_birdies || 0,
            pars: golfData.cumulative_stats.total_pars || 0,
            bogeys: golfData.cumulative_stats.total_bogeys || 0,
            doubleBogeyOrWorse: golfData.cumulative_stats.total_double_bogey_or_worse || 0,
            fairwayHits: golfData.cumulative_stats.total_fairways_hit || 0,
            fairwayAttempts: golfData.cumulative_stats.total_fairways_hit + 
                            golfData.cumulative_stats.total_fairways_missed_left + 
                            golfData.cumulative_stats.total_fairways_missed_right || 0,
            girHits: golfData.cumulative_stats.total_gir || 0,
            girAttempts: golfData.cumulative_stats.total_holes_played || 0
          };
        }
        
        // Calculate percentages
        fairwayPercentage = statsTotal.fairwayAttempts > 0 
          ? Math.round((statsTotal.fairwayHits / statsTotal.fairwayAttempts) * 100) 
          : 0;
        
        girPercentage = statsTotal.girAttempts > 0 
          ? Math.round((statsTotal.girHits / statsTotal.girAttempts) * 100) 
          : 0;
      }
      
      isLoading = false;
    } catch (error) {
      // If API fetch fails, try to use the local JSON file
      console.error('Error fetching golf data from API:', error);
      
      // For demo purposes, we'll use mock data
      // In a real application, you might want to show an error message
      isLoading = false;
      hasError = true;
      errorMessage = error instanceof Error ? error.message : 'Unknown error';
    }
  }
} catch (error) {
  console.error('Error processing golf data:', error);
  isLoading = false;
  hasError = true;
  errorMessage = error instanceof Error ? error.message : 'Unknown error';
}

// Helper function to get golf icon
function getGolfIcon(type: string): string {
  switch (type.toLowerCase()) {
    case 'ace':
      return `<i class="fas fa-certificate"></i>`;
    case 'eagle':
      return `<i class="fas fa-eagle"></i>`;
    case 'birdie':
      return `<i class="fas fa-dove"></i>`;
    case 'par':
      return `<i class="fas fa-equals"></i>`;
    case 'bogey':
      return `<i class="fas fa-plus"></i>`;
    case 'double':
      return `<i class="fas fa-plus-circle"></i>`;
    case 'fairway':
      return `<i class="fas fa-road"></i>`;
    case 'gir':
      return `<i class="fas fa-flag"></i>`;
    case 'golf':
      return `<i class="fas fa-golf-ball"></i>`;
    default:
      return `<i class="fas fa-golf-ball"></i>`;
  }
}
---

<div class="p-6 bg-white rounded-lg border-l-4 border-blue-500 shadow-md dark:bg-gray-800 dark:border-blue-400">
  <!-- Loading Indicator -->
  {isLoading && (
    <div class="flex items-center justify-center p-8">
      <div class="animate-spin rounded-full h-12 w-12 border-b-2 border-blue-500"></div>
    </div>
  )}
  
  <!-- Error Message -->
  {hasError && (
    <div class="p-4 mb-6 text-sm text-red-800 rounded-lg bg-red-50 dark:bg-gray-800 dark:text-red-400 border border-red-300 dark:border-red-800">
      <div class="flex items-center">
        <svg class="flex-shrink-0 inline w-5 h-5 mr-3" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 20 20">
          <path d="M10 .5a9.5 9.5 0 1 0 9.5 9.5A9.51 9.51 0 0 0 10 .5ZM9.5 4a1.5 1.5 0 1 1 0 3 1.5 1.5 0 0 1 0-3ZM12 15H8a1 1 0 0 1 0-2h1v-3H8a1 1 0 0 1 0-2h2a1 1 0 0 1 1 1v4h1a1 1 0 0 1 0 2Z"/>
        </svg>
        <span class="font-medium">
          Error loading golf stats: {errorMessage}
        </span>
      </div>
    </div>
  )}
  
  {!isLoading && !hasError && (
    <>
      <div class="flex items-center mb-6">
        <div class="w-10 h-10 flex items-center justify-center text-blue-500 dark:text-blue-400 me-4">
          <i class="fas fa-golf-ball text-3xl"></i>
        </div>
        <h2 class="text-3xl font-bold text-gray-900 dark:text-white">18Birdies Stats</h2>
      </div>
      
      <!-- Summary Stats -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
        <div class="p-4 bg-gray-50 rounded-lg dark:bg-gray-700 flex flex-col items-center justify-center">
          <span class="text-sm text-gray-500 dark:text-gray-400">Handicap</span>
          <span class="text-2xl font-bold text-gray-900 dark:text-white">{handicapIndex}</span>
        </div>
        <div class="p-4 bg-gray-50 rounded-lg dark:bg-gray-700 flex flex-col items-center justify-center">
          <span class="text-sm text-gray-500 dark:text-gray-400">Total Rounds</span>
          <span class="text-2xl font-bold text-gray-900 dark:text-white">{totalRounds}</span>
        </div>
        <div class="p-4 bg-gray-50 rounded-lg dark:bg-gray-700 flex flex-col items-center justify-center">
          <span class="text-sm text-gray-500 dark:text-gray-400">Fairways Hit</span>
          <span class="text-2xl font-bold text-gray-900 dark:text-white">{fairwayPercentage}%</span>
        </div>
        <div class="p-4 bg-gray-50 rounded-lg dark:bg-gray-700 flex flex-col items-center justify-center">
          <span class="text-sm text-gray-500 dark:text-gray-400">GIR</span>
          <span class="text-2xl font-bold text-gray-900 dark:text-white">{girPercentage}%</span>
        </div>
      </div>
      
      <!-- Stats Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- Recent Rounds -->
        <div class="p-4 bg-gray-50 rounded-lg dark:bg-gray-700">
          <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-4">Recent Rounds</h3>
          <div class="space-y-3">
            {recentRounds.map((round: ProcessedRound, index: number) => (
              <div class="flex items-center justify-between py-2 border-b border-gray-200 dark:border-gray-600 last:border-0">
                <div class="flex items-center">
                  <span class="text-lg font-medium text-gray-500 dark:text-gray-400 w-6">{index + 1}</span>
                  <div class="w-10 h-10 rounded-full mx-3 bg-blue-100 dark:bg-blue-900 flex items-center justify-center text-blue-500 dark:text-blue-300">
                    <Fragment set:html={getGolfIcon('golf')} />
                  </div>
                  <div>
                    <p class="font-medium text-gray-900 dark:text-white">{round.courseName}</p>
                    <p class="text-sm text-gray-500 dark:text-gray-400">{formatDate(round.date)}</p>
                  </div>
                </div>
                <div class="text-right">
                  <p class="font-medium text-gray-900 dark:text-white">{round.score > 0 ? `+${round.score}` : round.score}</p>
                  <p class="text-sm text-gray-500 dark:text-gray-400">{round.strokes} strokes</p>
                </div>
              </div>
            ))}
          </div>
        </div>
        
        <!-- Most Played Courses -->
        <div class="p-4 bg-gray-50 rounded-lg dark:bg-gray-700">
          <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-4">Most Played Courses</h3>
          <div class="space-y-3">
            {mostPlayedCourses.map((course: CourseCount) => (
              <div class="mb-3 last:mb-0">
                <div class="flex justify-between mb-1">
                  <span class="text-base font-medium text-gray-900 dark:text-white">{course.name}</span>
                  <span class="text-sm font-medium text-gray-500 dark:text-gray-400">{course.count} rounds</span>
                </div>
                <div class="w-full bg-gray-200 rounded-full h-2.5 dark:bg-gray-700">
                  <div class="bg-blue-500 h-2.5 rounded-full" style={`width: ${mostPlayedCourses.length > 0 && mostPlayedCourses[0] ? (course.count / mostPlayedCourses[0].count) * 100 : 0}%`}></div>
                </div>
              </div>
            ))}
          </div>
        </div>
        
        <!-- Shot Distribution -->
        <div class="p-4 bg-gray-50 rounded-lg dark:bg-gray-700">
          <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-4">Shot Distribution</h3>
          <div class="space-y-3">
            <div class="flex items-center justify-between py-2 border-b border-gray-200 dark:border-gray-600">
              <div class="flex items-center">
                <div class="w-8 h-8 rounded-full mr-3 bg-yellow-100 dark:bg-yellow-900 flex items-center justify-center text-yellow-600 dark:text-yellow-300">
                  <Fragment set:html={getGolfIcon('eagle')} />
                </div>
                <span class="font-medium text-gray-900 dark:text-white">Eagles or Better</span>
              </div>
              <span class="text-gray-500 dark:text-gray-400">{statsTotal.eagles + statsTotal.aces}</span>
            </div>
            <div class="flex items-center justify-between py-2 border-b border-gray-200 dark:border-gray-600">
              <div class="flex items-center">
                <div class="w-8 h-8 rounded-full mr-3 bg-red-100 dark:bg-red-900 flex items-center justify-center text-red-600 dark:text-red-300">
                  <Fragment set:html={getGolfIcon('birdie')} />
                </div>
                <span class="font-medium text-gray-900 dark:text-white">Birdies</span>
              </div>
              <span class="text-gray-500 dark:text-gray-400">{statsTotal.birdies}</span>
            </div>
            <div class="flex items-center justify-between py-2 border-b border-gray-200 dark:border-gray-600">
              <div class="flex items-center">
                <div class="w-8 h-8 rounded-full mr-3 bg-blue-100 dark:bg-blue-900 flex items-center justify-center text-blue-500 dark:text-blue-300">
                  <Fragment set:html={getGolfIcon('par')} />
                </div>
                <span class="font-medium text-gray-900 dark:text-white">Pars</span>
              </div>
              <span class="text-gray-500 dark:text-gray-400">{statsTotal.pars}</span>
            </div>
            <div class="flex items-center justify-between py-2 border-b border-gray-200 dark:border-gray-600">
              <div class="flex items-center">
                <div class="w-8 h-8 rounded-full mr-3 bg-gray-100 dark:bg-gray-700 flex items-center justify-center text-gray-600 dark:text-gray-300">
                  <Fragment set:html={getGolfIcon('bogey')} />
                </div>
                <span class="font-medium text-gray-900 dark:text-white">Bogeys</span>
              </div>
              <span class="text-gray-500 dark:text-gray-400">{statsTotal.bogeys}</span>
            </div>
            <div class="flex items-center justify-between py-2">
              <div class="flex items-center">
                <div class="w-8 h-8 rounded-full mr-3 bg-gray-200 dark:bg-gray-600 flex items-center justify-center text-gray-700 dark:text-gray-400">
                  <Fragment set:html={getGolfIcon('double')} />
                </div>
                <span class="font-medium text-gray-900 dark:text-white">Double Bogey+</span>
              </div>
              <span class="text-gray-500 dark:text-gray-400">{statsTotal.doubleBogeyOrWorse}</span>
            </div>
          </div>
        </div>
        
        <!-- Accuracy Stats -->
        <div class="p-4 bg-gray-50 rounded-lg dark:bg-gray-700">
          <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-4">Accuracy Stats</h3>
          <div class="space-y-6">
            <div>
              <div class="flex justify-between mb-1">
                <span class="text-base font-medium text-gray-900 dark:text-white">Fairways Hit</span>
                <span class="text-sm font-medium text-gray-500 dark:text-gray-400">
                  {statsTotal.fairwayHits} / {statsTotal.fairwayAttempts} ({fairwayPercentage}%)
                </span>
              </div>
              <div class="w-full bg-gray-200 rounded-full h-2.5 dark:bg-gray-700">
                <div class="bg-blue-500 h-2.5 rounded-full" style={`width: ${fairwayPercentage}%`}></div>
              </div>
            </div>
            
            <div>
              <div class="flex justify-between mb-1">
                <span class="text-base font-medium text-gray-900 dark:text-white">Greens in Regulation</span>
                <span class="text-sm font-medium text-gray-500 dark:text-gray-400">
                  {statsTotal.girHits} / {statsTotal.girAttempts} ({girPercentage}%)
                </span>
              </div>
              <div class="w-full bg-gray-200 rounded-full h-2.5 dark:bg-gray-700">
                <div class="bg-blue-500 h-2.5 rounded-full" style={`width: ${girPercentage}%`}></div>
              </div>
            </div>
            
            <div class="pt-4 border-t border-gray-200 dark:border-gray-600">
              <p class="text-sm text-gray-500 dark:text-gray-400">
                <span class="font-medium">Scoring Breakdown:</span> 
                {statsTotal.aces > 0 ? `${statsTotal.aces} Aces, ` : ''}
                {statsTotal.eagles > 0 ? `${statsTotal.eagles} Eagles, ` : ''}
                {statsTotal.birdies} Birdies, 
                {statsTotal.pars} Pars, 
                {statsTotal.bogeys} Bogeys, 
                {statsTotal.doubleBogeyOrWorse} Double Bogey+
              </p>
            </div>
          </div>
        </div>
      </div>
      
      <!-- Yearly Stats -->
      {yearlyReading.length > 0 && (
        <div class="mt-6 p-4 bg-gray-50 rounded-lg dark:bg-gray-700 md:col-span-2">
          <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-4">Rounds Played by Year</h3>
          <div class="space-y-3">
            {yearlyReading.map((yearData: YearlyData) => (
              <div class="mb-3 last:mb-0">
                <div class="flex justify-between mb-1">
                  <span class="text-base font-medium text-gray-900 dark:text-white">{yearData.year}</span>
                  <span class="text-sm font-medium text-gray-500 dark:text-gray-400">
                    {yearData.count} rounds
                  </span>
                </div>
                <div class="w-full bg-gray-200 rounded-full h-2.5 dark:bg-gray-700">
                  <div class="bg-blue-500 h-2.5 rounded-full" style={`width: ${(yearData.count / Math.max(...yearlyReading.map(y => y.count))) * 100}%`}></div>
                </div>
              </div>
            ))}
          </div>
        </div>
      )}
      
      <!-- Handicap by Year -->
      {yearlyHandicaps && yearlyHandicaps.length > 0 && (
        <div class="mt-6 p-4 bg-gray-50 rounded-lg dark:bg-gray-700 md:col-span-2">
          <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-4">Handicap by Year</h3>
          <div class="space-y-3">
            {yearlyHandicaps.map((yearData: YearlyHandicapData) => (
              <div class="mb-3 last:mb-0">
                <div class="flex justify-between mb-1">
                  <span class="text-base font-medium text-gray-900 dark:text-white">{yearData.year}</span>
                  <span class="text-sm font-medium text-gray-500 dark:text-gray-400">
                    {yearData.handicap}
                  </span>
                </div>
                <div class="w-full bg-gray-200 rounded-full h-2.5 dark:bg-gray-700">
                  <div class="bg-blue-500 h-2.5 rounded-full" style={`width: ${(Math.min(Math.max(yearData.handicap, 0), 30) / 30) * 100}%`}></div>
                </div>
              </div>
            ))}
          </div>
        </div>
      )}
      
      <!-- Average Score by Year -->
      {yearlyScores && yearlyScores.length > 0 && (
        <div class="mt-6 p-4 bg-gray-50 rounded-lg dark:bg-gray-700 md:col-span-2">
          <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-4">Average Score Over Par by Year</h3>
          <div class="space-y-3">
            {yearlyScores.map((yearData: YearlyScoreData) => (
              <div class="mb-3 last:mb-0">
                <div class="flex justify-between mb-1">
                  <span class="text-base font-medium text-gray-900 dark:text-white">{yearData.year}</span>
                  <span class="text-sm font-medium text-gray-500 dark:text-gray-400">
                    {yearData.averageScore > 0 ? `+${yearData.averageScore}` : yearData.averageScore}
                  </span>
                </div>
                <div class="w-full bg-gray-200 rounded-full h-2.5 dark:bg-gray-700">
                  <div class="bg-blue-500 h-2.5 rounded-full" style={`width: ${(Math.min(Math.max(yearData.averageScore, 0), 30) / 30) * 100}%`}></div>
                </div>
              </div>
            ))}
          </div>
        </div>
      )}
    </>
  )}
</div>
