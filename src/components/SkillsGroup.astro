---
interface Props {
  title: string;
  skills: string[];
  colorScheme?: 'blue' | 'green' | 'purple' | 'yellow' | 'red' | 'gray' | string;
}

const { title, skills, colorScheme = 'blue' } = Astro.props;

// Define color schemes for different skill categories
const colorSchemes = {
  blue: {
    bg: 'bg-blue-100',
    text: 'text-blue-800',
    darkBg: 'dark:bg-blue-900',
    darkText: 'dark:text-blue-300'
  },
  green: {
    bg: 'bg-green-100',
    text: 'text-green-800',
    darkBg: 'dark:bg-green-900',
    darkText: 'dark:text-green-300'
  },
  purple: {
    bg: 'bg-purple-100',
    text: 'text-purple-800',
    darkBg: 'dark:bg-purple-900',
    darkText: 'dark:text-purple-300'
  },
  yellow: {
    bg: 'bg-yellow-100',
    text: 'text-yellow-800',
    darkBg: 'dark:bg-yellow-900',
    darkText: 'dark:text-yellow-300'
  },
  red: {
    bg: 'bg-red-100',
    text: 'text-red-800',
    darkBg: 'dark:bg-red-900',
    darkText: 'dark:text-red-300'
  },
  gray: {
    bg: 'bg-gray-100',
    text: 'text-gray-800',
    darkBg: 'dark:bg-gray-700',
    darkText: 'dark:text-gray-300'
  }
};

// Get colors from the colorScheme, defaulting to blue if not found
const colors = colorSchemes[colorScheme as keyof typeof colorSchemes] || colorSchemes.blue;
---

<div class="bg-gray-50 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg p-4">
  <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-2">{title}</h3>
  <div class="flex flex-wrap gap-2">
    {skills.map(skill => (
      <span class={`${colors.bg} ${colors.text} text-xs font-medium px-2.5 py-0.5 rounded ${colors.darkBg} ${colors.darkText}`}>
        {skill}
      </span>
    ))}
  </div>
  <slot />
</div>
