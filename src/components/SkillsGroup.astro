---
interface Props {
  title: string;
  skills: string[];
  colorScheme?: 'blue' | 'green' | 'purple' | 'yellow' | 'red' | 'gray' | string;
}

const { title, skills, colorScheme = 'blue' } = Astro.props;

// Enhanced color schemes for different skill categories
const colorSchemes = {
  blue: {
    bg: 'bg-blue-100',
    text: 'text-blue-800',
    darkBg: 'dark:bg-blue-900/70',
    darkText: 'dark:text-blue-300',
    skillBg: 'bg-blue-50',
    skillText: 'text-blue-700',
    darkSkillBg: 'dark:bg-blue-800/30',
    darkSkillText: 'dark:text-blue-200',
    skillBorder: 'border-blue-200',
    darkSkillBorder: 'dark:border-blue-700/50',
    hoverBg: 'hover:bg-blue-100',
    darkHoverBg: 'dark:hover:bg-blue-800/50'
  },
  green: {
    bg: 'bg-green-100',
    text: 'text-green-800',
    darkBg: 'dark:bg-green-900/70',
    darkText: 'dark:text-green-300',
    skillBg: 'bg-green-50',
    skillText: 'text-green-700',
    darkSkillBg: 'dark:bg-green-800/30',
    darkSkillText: 'dark:text-green-200',
    skillBorder: 'border-green-200',
    darkSkillBorder: 'dark:border-green-700/50',
    hoverBg: 'hover:bg-green-100',
    darkHoverBg: 'dark:hover:bg-green-800/50'
  },
  purple: {
    bg: 'bg-purple-100',
    text: 'text-purple-800',
    darkBg: 'dark:bg-purple-900/70',
    darkText: 'dark:text-purple-300',
    skillBg: 'bg-purple-50',
    skillText: 'text-purple-700',
    darkSkillBg: 'dark:bg-purple-800/30',
    darkSkillText: 'dark:text-purple-200',
    skillBorder: 'border-purple-200',
    darkSkillBorder: 'dark:border-purple-700/50',
    hoverBg: 'hover:bg-purple-100',
    darkHoverBg: 'dark:hover:bg-purple-800/50'
  },
  yellow: {
    bg: 'bg-yellow-100',
    text: 'text-yellow-800',
    darkBg: 'dark:bg-yellow-900/70',
    darkText: 'dark:text-yellow-300',
    skillBg: 'bg-yellow-50',
    skillText: 'text-yellow-700',
    darkSkillBg: 'dark:bg-yellow-800/30',
    darkSkillText: 'dark:text-yellow-200',
    skillBorder: 'border-yellow-200',
    darkSkillBorder: 'dark:border-yellow-700/50',
    hoverBg: 'hover:bg-yellow-100',
    darkHoverBg: 'dark:hover:bg-yellow-800/50'
  },
  red: {
    bg: 'bg-red-100',
    text: 'text-red-800',
    darkBg: 'dark:bg-red-900/70',
    darkText: 'dark:text-red-300',
    skillBg: 'bg-red-50',
    skillText: 'text-red-700',
    darkSkillBg: 'dark:bg-red-800/30',
    darkSkillText: 'dark:text-red-200',
    skillBorder: 'border-red-200',
    darkSkillBorder: 'dark:border-red-700/50',
    hoverBg: 'hover:bg-red-100',
    darkHoverBg: 'dark:hover:bg-red-800/50'
  },
  gray: {
    bg: 'bg-gray-100',
    text: 'text-gray-800',
    darkBg: 'dark:bg-gray-800/70',
    darkText: 'dark:text-gray-300',
    skillBg: 'bg-gray-50',
    skillText: 'text-gray-700',
    darkSkillBg: 'dark:bg-gray-700/30',
    darkSkillText: 'dark:text-gray-200',
    skillBorder: 'border-gray-200',
    darkSkillBorder: 'dark:border-gray-600/50',
    hoverBg: 'hover:bg-gray-100',
    darkHoverBg: 'dark:hover:bg-gray-700/50'
  }
};

// Get colors from the colorScheme, defaulting to blue if not found
const colors = colorSchemes[colorScheme as keyof typeof colorSchemes] || colorSchemes.blue;

// Generate a unique ID for this skills group
const groupId = `skills-group-${Math.random().toString(36).substring(2, 9)}`;
---

<div id={groupId} class="skills-group relative group animate-fade-in-up mb-6 sm:mb-8 p-4 sm:p-5 rounded-xl bg-gradient-to-br from-white/30 to-black/5 dark:from-white/5 dark:to-black/10 ring-1 ring-inset ring-black/5 dark:ring-white/10 shadow-md hover:shadow-lg transition-all duration-300 border border-white/10">
  <!-- Subtle background pattern -->
  <div class="absolute inset-0 bg-gradient-to-br from-transparent to-black/5 dark:to-white/5 rounded-xl opacity-20 pointer-events-none"></div>
  
  <!-- Header with icon and title -->
  <div class="flex items-center mb-4">
    <div class={`w-7 h-7 rounded-md ${colors.bg} ${colors.darkBg} flex items-center justify-center mr-3 shadow-sm transform transition-transform group-hover:scale-110 duration-300`}>
      <svg xmlns="http://www.w3.org/2000/svg" class={`h-4 w-4 ${colors.text} ${colors.darkText}`} fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
      </svg>
    </div>
    <div class="text-md sm:text-base font-semibold tracking-wide text-[var(--text-secondary)] uppercase">{title}</div>
  </div>

  <!-- Skills grid with improved styling and flexible layout -->
  <div class="skills-grid mt-3 flex flex-wrap gap-2">
    {skills.map((skill, index) => (
      <div 
        class={`skill-item text-[11px] font-semibold px-3 py-1.5 rounded-lg tracking-tight uppercase 
        ${colors.skillBg} ${colors.skillText} ${colors.darkSkillBg} ${colors.darkSkillText}
        border border-white/10 backdrop-blur-sm
        hover:ring-1 hover:ring-accent-color/50
        transition-all duration-200 transform hover:-translate-y-[1px] hover:shadow-md cursor-default
        animate-fade-in`}
        style={`animation-delay: ${index * 50}ms;`}
      >
        {skill}
      </div>
    ))}
  </div>
  
  <!-- Slot for additional content -->
  <slot />
</div>

<style>
  .skills-group {
    position: relative;
    overflow: hidden;
  }
  
  .skills-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 0.625rem;
    align-items: center;
  }
  
  .skill-item {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    white-space: nowrap;
    text-overflow: ellipsis;
    overflow: hidden;
    flex: 0 0 auto;
  }
  

  @media (max-width: 640px) {
    .skills-grid {
      gap: 0.5rem;
    }
  }
  
  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(5px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  
  .animate-fade-in {
    animation: fadeIn 0.5s ease-out forwards;
    opacity: 0;
  }
</style>

<script define:vars={{ groupId }}>
  // Add hover effect to skills items
  document.addEventListener('DOMContentLoaded', () => {
    const skillsGroup = document.getElementById(groupId);
    if (skillsGroup) {
      const skillItems = skillsGroup.querySelectorAll('.skill-item');
      
      skillItems.forEach(item => {
        item.addEventListener('mouseenter', () => {
          item.classList.add('scale-105');
        });
        
        item.addEventListener('mouseleave', () => {
          item.classList.remove('scale-105');
        });
      });
    }
  });
</script>
