---
import { FlagIcon } from '@heroicons/react/24/outline';
import GolfSummary from './golf/GolfSummary';
---

<div class="stats-card p-0.5 sm:p-2 md:p-4">
  <div class="mb-6">
    <div class="flex items-center mb-4">
      <div class="w-10 h-10 flex items-center justify-center bg-green-100 dark:bg-green-900 rounded-full text-green-600 dark:text-green-400 me-4">
        <FlagIcon className="h-6 w-6" />
      </div>
      <div>
        <h2 class="text-2xl font-bold text-gray-900 dark:text-white">Golf Stats</h2>
        <p class="text-gray-500 dark:text-gray-400 text-sm">Track my golf performance and progress</p>
      </div>
    </div>
  </div>
  
  <div id="golf-stats-content">
    <!-- Initial loading state -->
    <div id="golf-loading-indicator" class="flex flex-col items-center justify-center p-8">
      <div class="animate-spin rounded-full h-12 w-12 border-b-2 border-green-500 mb-4"></div>
      <p class="text-gray-500 dark:text-gray-400">Loading golf data...</p>
    </div>
    
    <!-- Error message container - initially hidden -->
    <div id="golf-error-message" class="hidden p-4 mb-6 text-sm text-red-800 rounded-lg bg-red-50 dark:bg-gray-800 dark:text-red-400 border border-red-300 dark:border-red-800">
      <div class="flex items-center">
        <svg class="flex-shrink-0 inline w-5 h-5 mr-3" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 20 20">
          <path d="M10 .5a9.5 9.5 0 1 0 9.5 9.5A9.51 9.51 0 0 0 10 .5ZM9.5 4a1.5 1.5 0 1 1 0 3 1.5 1.5 0 0 1 0-3ZM12 15H8a1 1 0 0 1 0-2h1v-3H8a1 1 0 0 1 0-2h2a1 1 0 0 1 1 1v4h1a1 1 0 0 1 0 2Z"/>
        </svg>
        <span id="golf-error-text" class="font-medium">Error loading golf stats</span>
      </div>
    </div>
    
    <!-- Content container - initially hidden -->
    <div id="golf-stats-container" class="hidden">
      <!-- Golf Summary -->
      <div class="mb-8" id="golf-summary">
        <GolfSummary client:only="react" summary={{}} />
      </div>
    </div>
  </div>
</div>

<script is:inline>
  // Initialize when the page loads
  document.addEventListener('astro:page-load', async function() {
    // Get DOM elements
    const loadingIndicator = document.getElementById('golf-loading-indicator');
    const errorMessage = document.getElementById('golf-error-message');
    const errorText = document.getElementById('golf-error-text');
    const statsContainer = document.getElementById('golf-stats-container');
    
    try {
      // Fetch data from the API
      const apiUrl = '/api/alexapi/api/v1/golf';
      console.log('Fetching golf data from:', apiUrl);
      
      const response = await fetch(apiUrl);
      
      if (!response.ok) {
        throw new Error(`API request failed: ${response.status}`);
      }
      
      const data = await response.json();
      
      console.log("Data from API:", data);
      
      // Create a custom event with all the data
      const golfDataEvent = new CustomEvent('golf-data-ready', {
        detail: {
          stats: data.cumulative_stats || {}
        },
        bubbles: true
      });
      
      console.log("Dispatching event with data:", golfDataEvent.detail);
      
      // Dispatch the event to the document so all components can listen for it
      // Add a small delay to ensure components are mounted
      setTimeout(() => {
        console.log("Dispatching event after delay");
        document.dispatchEvent(golfDataEvent);
      }, 500);
      
      // Show the content and hide the loading indicator
      if (loadingIndicator) loadingIndicator.classList.add('hidden');
      if (statsContainer) statsContainer.classList.remove('hidden');
    } catch (error) {
      console.error('Error loading golf stats:', error);
      
      // Show error message and hide loading indicator
      if (loadingIndicator) loadingIndicator.classList.add('hidden');
      if (errorMessage) {
        if (errorText) errorText.textContent = error instanceof Error ? error.message : 'Unknown error loading golf stats';
        errorMessage.classList.remove('hidden');
      }
    }
  });
</script>
