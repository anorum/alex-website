---
interface Props {
  title: string;
  company?: string;
  startDate: string;
  endDate?: string;
  description: string;
  isCurrent?: boolean;
  location?: string;
  skills?: string[];
}

const { 
  title, 
  company, 
  startDate, 
  endDate = "Present", 
  description, 
  isCurrent = false,
  location,
  skills = []
} = Astro.props;

// Format the date range
const dateRange = `${startDate} - ${endDate}`;
---

<li class="mb-10 ms-6">            
  <span class="absolute flex items-center justify-center w-6 h-6 bg-blue-100 rounded-full -start-3 ring-8 ring-white dark:ring-gray-900 dark:bg-blue-900">
    <svg class="w-2.5 h-2.5 text-blue-800 dark:text-blue-300" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 20 20">
      <path d="M20 4a2 2 0 0 0-2-2h-2V1a1 1 0 0 0-2 0v1h-3V1a1 1 0 0 0-2 0v1H6V1a1 1 0 0 0-2 0v1H2a2 2 0 0 0-2 2v2h20V4ZM0 18a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V8H0v10Zm5-8h10a1 1 0 0 1 0 2H5a1 1 0 0 1 0-2Z"/>
    </svg>
  </span>
  <div>
    <h3 class="flex items-center mb-1 text-lg font-semibold text-gray-900 dark:text-white">
      {title} {company && <span class="ml-1">at {company}</span>}
      {isCurrent && 
        <span class="bg-blue-100 text-blue-800 text-sm font-medium me-2 px-2.5 py-0.5 rounded dark:bg-blue-900 dark:text-blue-300 ms-3">
          Current
        </span>
      }
    </h3>
    <time class="block mb-2 text-sm font-normal leading-none text-gray-400 dark:text-gray-500">{dateRange}</time>
    {location && 
      <div class="mb-2 text-sm font-normal leading-none text-gray-400 dark:text-gray-500">
        <svg class="w-4 h-4 inline-block mr-1" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
          <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"></path>
        </svg>
        {location}
      </div>
    }
    <p class="mb-4 text-base font-normal text-gray-500 dark:text-gray-400">{description}</p>
    
    {skills.length > 0 && 
      <div class="flex flex-wrap gap-2 mb-2">
        {skills.map(skill => (
          <span class="bg-gray-100 text-gray-800 text-xs font-medium px-2.5 py-0.5 rounded dark:bg-gray-700 dark:text-gray-300">
            {skill}
          </span>
        ))}
      </div>
    }
    
    <slot />
  </div>
</li>
