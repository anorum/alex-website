---
---

<div class="mb-12 bg-gradient-to-r from-blue-50 to-purple-50 dark:from-blue-900/30 dark:to-purple-900/30 rounded-xl overflow-hidden shadow-lg">
  <div class="grid md:grid-cols-2">
    <!-- Left side: Image and description -->
    <div class="p-8 flex flex-col justify-center">
      <div class="flex items-center mb-4">
        <img src="/mara_logo.png" alt="Mara" class="w-16 h-16 rounded-full border-4 border-white shadow-lg mr-4" />
        <h2 class="text-2xl font-bold text-gray-900 dark:text-white">Meet Mara</h2>
      </div>
      
      <p class="text-lg text-gray-600 dark:text-gray-300 mb-6">
        Have questions about Alex? Chat with Mara, an AI assistant modeled after Alex's Australian Labradoodle. Mara has been trained on Alex's data and can help answer your questions instantly.
      </p>
      
      <ul class="space-y-3 mb-8">
        <li class="flex items-start">
          <svg class="w-5 h-5 mr-2 text-purple-500 mt-1 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          <span class="text-gray-600 dark:text-gray-300">Get immediate answers about Alex's experience and skills</span>
        </li>
        <li class="flex items-start">
          <svg class="w-5 h-5 mr-2 text-purple-500 mt-1 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          <span class="text-gray-600 dark:text-gray-300">Learn about projects and technical expertise</span>
        </li>
        <li class="flex items-start">
          <svg class="w-5 h-5 mr-2 text-purple-500 mt-1 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          <span class="text-gray-600 dark:text-gray-300">Discover personal recommendations and insights</span>
        </li>
      </ul>
      
      <button id="open-mara-chat-contact" class="inline-flex items-center px-6 py-3 bg-gradient-to-r from-purple-600 to-blue-500 hover:from-purple-700 hover:to-blue-600 text-white font-medium rounded-lg transition-colors">
        <img src="/mara_logo.png" alt="" class="w-5 h-5 mr-2 rounded-full" />
        Start Chatting with Mara
      </button>
    </div>
    
    <!-- Right side: Decorative chat bubbles -->
    <div class="bg-gradient-to-br from-blue-600 to-purple-700 p-8 flex items-center justify-center relative overflow-hidden">
      <div class="absolute top-0 left-0 w-full h-full opacity-10">
        <svg width="100%" height="100%" viewBox="0 0 100 100" preserveAspectRatio="none">
          <pattern id="pattern-circles" x="0" y="0" width="20" height="20" patternUnits="userSpaceOnUse" patternContentUnits="userSpaceOnUse">
            <circle id="pattern-circle" cx="10" cy="10" r="2" fill="#ffffff"></circle>
          </pattern>
          <rect x="0" y="0" width="100%" height="100%" fill="url(#pattern-circles)"></rect>
        </svg>
      </div>
      
      <div class="relative z-10 max-w-xs">
        <!-- Chat bubbles -->
        <div class="bg-white dark:bg-gray-800 rounded-lg p-4 shadow-lg mb-4 transform -rotate-2">
          <p class="text-gray-700 dark:text-gray-300">What projects has Alex worked on?</p>
        </div>
        
        <div class="bg-blue-100 dark:bg-blue-900 rounded-lg p-4 shadow-lg ml-6 mb-4 transform rotate-1">
          <p class="text-gray-800 dark:text-gray-200">Alex has led data platform engineering at LegalZoom, focusing on Snowflake, Airflow, and Terraform...</p>
        </div>
        
        <div class="bg-white dark:bg-gray-800 rounded-lg p-4 shadow-lg mb-4 transform -rotate-1">
          <p class="text-gray-700 dark:text-gray-300">What technologies does Alex specialize in?</p>
        </div>
        
        <div class="bg-blue-100 dark:bg-blue-900 rounded-lg p-4 shadow-lg ml-6 transform rotate-2">
          <p class="text-gray-800 dark:text-gray-200">Alex specializes in data engineering with Python, Snowflake, AWS, and Kubernetes...</p>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('astro:page-load', () => {
    // Handle "Chat with Mara" button click
    const openMaraButton = document.getElementById('open-mara-chat-contact');
    if (openMaraButton) {
      openMaraButton.addEventListener('click', () => {
        // Dispatch a custom event to open the integrated chat panel
        document.dispatchEvent(new CustomEvent('open-fullscreen-chatbot'));
      });
    }
  });
</script>
