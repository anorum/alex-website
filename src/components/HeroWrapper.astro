---
import HeroRPG from './rpg/HeroRPG.astro';
import meImage from '../assets/me.jpeg';
---

<!-- Standard Hero (visible by default) -->
<div class="standard-hero">
  <div class="relative z-10">
    <div class="max-w-4xl mx-auto px-4 flex flex-col-reverse lg:flex-row items-center gap-12">
      <!-- Text Content -->
      <div class="lg:w-3/5 space-y-6">
        <div class="space-y-2">
          <span class="inline-block text-sm font-semibold px-3 py-1 rounded-full bg-secondary-color dark:bg-secondary-color/80 text-sm dark:text-white">Hello there 👋</span>
          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight leading-tight">
            I'm <span class="relative inline-block">
              <span class="relative z-10">Alex Norum</span>
              <span class="absolute bottom-2 left-0 w-full h-3 bg-secondary-color opacity-30"></span>
            </span>
          </h1>
        </div>
        
        <p class="text-lg sm:text-xl text-muted max-w-xl leading-relaxed">
          I build platforms and tools that help data teams get their work done without a bunch of friction. I like things that are simple, reliable, and maybe even a little fun to use.
        </p>
        
        <div class="flex flex-col sm:flex-row gap-4 sm:items-center">
          <p class="text-base text-muted">
            Based in Portland. Building at LegalZoom. Formerly New Relic and Oracle.
          </p>
          <span class="hidden sm:block h-1 w-1 bg-accent-color rounded-full"></span>
          <p class="text-base text-muted italic">Always learning, always iterating.</p>
        </div>
        
        <div class="pt-4 flex flex-wrap gap-3">
          <a href="#contact" class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-accent-color dark:bg-accent-color/90 text-md dark:text-white hover:bg-opacity-90 dark:hover:bg-opacity-100 transition-all">
            <span>Get in touch</span>
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
          </a>
        </div>
      </div>
      
      <!-- Profile Image -->
      <div class="lg:w-2/5 flex justify-center">
        <div class="relative">
          <!-- Decorative elements around image -->
          <div class="absolute -top-4 -right-4 w-24 h-24 border-2 border-secondary-color rounded-full"></div>
          <div class="absolute -bottom-4 -left-4 w-16 h-16 border-2 border-accent-color rounded-full"></div>
          
          <!-- Main image with fancy border -->
          <div class="relative z-10 rounded-2xl overflow-hidden border-4 border-white dark:border-gray-800 shadow-2xl transform hover:rotate-2 transition-transform duration-300">
            <img 
              src={meImage.src} 
              alt="Alex Norum" 
              class="w-64 sm:w-80 object-cover"
              loading="eager"
            />
            
            <!-- Overlay gradient -->
            <div class="absolute inset-0 bg-gradient-to-t from-black/30 to-transparent"></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- RPG Hero (hidden by default) -->
<div class="rpg-hero hidden">
  <HeroRPG />
</div>

<script is:inline>
  document.addEventListener('DOMContentLoaded', function() {
    updateHero();
  });
  
  document.addEventListener('astro:page-load', function() {
    updateHero();
  });
  
  function updateHero() {
    const currentTheme = localStorage.getItem('site-theme') || 'standard';
    const standardHero = document.querySelector('.standard-hero');
    const rpgHero = document.querySelector('.rpg-hero');
    
    console.log('HeroWrapper - Current theme:', currentTheme);
    
    if (currentTheme === 'rpg') {
      standardHero?.classList.add('hidden');
      rpgHero?.classList.remove('hidden');
      console.log('HeroWrapper - Showing RPG hero');
    } else {
      standardHero?.classList.remove('hidden');
      rpgHero?.classList.add('hidden');
      console.log('HeroWrapper - Showing standard hero');
    }
  }
  
  // Listen for theme changes
  window.addEventListener('storage', function(event) {
    if (event.key === 'site-theme') {
      updateHero();
    }
  });
  
  // Custom event for theme changes
  document.addEventListener('themeChanged', function() {
    console.log('HeroWrapper - themeChanged event received');
    updateHero();
  });
</script>

<style>
  .hidden {
    display: none;
  }
</style>
