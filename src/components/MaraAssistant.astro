---
---

<div class="mara-assistant-container">
  <!-- Decorative elements -->
  <div class="mara-decorative-circle mara-decorative-circle-1"></div>
  <div class="mara-decorative-circle mara-decorative-circle-2"></div>
  <div class="mara-decorative-circle mara-decorative-circle-3"></div>
  
  <div class="mara-assistant-content">
    <div class="mara-avatar-container">
      <div class="mara-avatar-glow"></div>
      <img src="/mara_logo.png" alt="Mara" class="mara-avatar" />
      <div class="mara-status-indicator"></div>
    </div>
    <div class="mara-info">
      <div class="mara-title-container">
        <h3>Chat with Mara</h3>
        <span class="mara-badge">AI Assistant</span>
      </div>
      <p>Hi! I'm Mara, Alex's AI assistant (and virtual Labradoodle). Ask me anything about Alex's work, skills, or interests!</p>
      <button id="chat-with-mara" class="mara-chat-button">
        <span>Start chatting</span>
        <i class="fas fa-arrow-right"></i>
      </button>
    </div>
  </div>
</div>

<script>
  document.addEventListener('astro:page-load', () => {
    const chatButton = document.getElementById('chat-with-mara');
    if (chatButton) {
      chatButton.addEventListener('click', () => {
        // Find the chatbot button in the DOM and click it
        const chatbotButton = document.querySelector('#chainlit-copilot')?.shadowRoot?.querySelector('button');
        if (chatbotButton) {
          chatbotButton.click();
        }
      });
    }
  });
</script>

<style>
  .mara-assistant-container {
    position: relative;
    margin: 3rem 0;
    transition: all 0.3s ease;
    padding: 1rem 0;
  }
  
  /* Decorative circles */
  .mara-decorative-circle {
    position: absolute;
    border-radius: 50%;
    opacity: 0.15;
    z-index: 0;
  }
  
  .mara-decorative-circle-1 {
    width: 150px;
    height: 150px;
    background: linear-gradient(135deg, var(--accent-color), var(--secondary-color));
    top: -30px;
    left: -50px;
    filter: blur(25px);
  }
  
  .mara-decorative-circle-2 {
    width: 100px;
    height: 100px;
    background: linear-gradient(135deg, var(--secondary-color), var(--tertiary-color));
    bottom: -20px;
    right: 20%;
    filter: blur(20px);
  }
  
  .mara-decorative-circle-3 {
    width: 70px;
    height: 70px;
    background: linear-gradient(135deg, var(--tertiary-color), var(--accent-color));
    top: 20px;
    right: -20px;
    filter: blur(15px);
  }
  
  .mara-assistant-content {
    background-color: var(--bubble-bg);
    border-radius: 16px;
    backdrop-filter: blur(10px);
    border: 1px solid var(--border-color);
    padding: 1.5rem;
    display: flex;
    align-items: center;
    gap: 1.5rem;
    box-shadow: var(--card-shadow);
    transition: all 0.3s ease;
    overflow: hidden;
    position: relative;
  }
  
  .mara-assistant-content::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: var(--accent-color);
    z-index: 1;
  }

  /* Ensure Mara's colors update with theme changes */
  :root:not(.dark) .mara-assistant-content {
    background-color: var(--bubble-bg-light);
    border: 1px solid var(--border-color-light);
    box-shadow: var(--card-shadow-light);
  }
  
  .dark .mara-assistant-content {
    background-color: var(--bubble-bg-dark);
    border: 1px solid var(--border-color-dark);
    box-shadow: var(--card-shadow-dark);
  }
  
  .mara-assistant-content:hover {
    transform: translateY(-5px);
    box-shadow: 0 12px 48px rgba(0, 0, 0, 0.15);
  }
  
  .mara-avatar-container {
    position: relative;
    flex-shrink: 0;
    z-index: 1;
  }
  
  .mara-avatar-glow {
    position: absolute;
    width: 100px;
    height: 100px;
    border-radius: 50%;
    background: radial-gradient(circle, var(--accent-color) 0%, rgba(255,255,255,0) 70%);
    opacity: 0.2;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    z-index: 0;
    filter: blur(10px);
    transition: all 0.5s ease;
  }
  
  .mara-assistant-content:hover .mara-avatar-glow {
    opacity: 0.4;
    width: 110px;
    height: 110px;
  }
  
  .mara-avatar {
    position: relative;
    width: 80px;
    height: 80px;
    border-radius: 50%;
    object-fit: cover;
    border: 4px solid var(--accent-color);
    box-shadow: var(--card-shadow), 0 0 15px rgba(var(--accent-color-rgb), 0.3);
    transition: all 0.3s ease;
    z-index: 1;
  }
  
  :root:not(.dark) .mara-avatar {
    border: 3px solid var(--border-color-light);
    box-shadow: var(--card-shadow-light);
  }
  
  .dark .mara-avatar {
    border: 3px solid var(--border-color-dark);
    box-shadow: var(--card-shadow-dark);
  }
  
  .mara-assistant-content:hover .mara-avatar {
    transform: scale(1.05);
  }
  
  .mara-status-indicator {
    position: absolute;
    bottom: 0;
    right: 0;
    width: 14px;
    height: 14px;
    background-color: #4CAF50;
    border-radius: 50%;
    border: 2px solid white;
    box-shadow: 0 0 0 2px rgba(0, 0, 0, 0.1);
    animation: pulse 2s infinite;
    z-index: 2;
  }
  
  @keyframes pulse {
    0% {
      box-shadow: 0 0 0 0 rgba(76, 175, 80, 0.7);
    }
    70% {
      box-shadow: 0 0 0 10px rgba(76, 175, 80, 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgba(76, 175, 80, 0);
    }
  }
  
  .mara-info {
    flex: 1;
  }
  
  .mara-title-container {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.5rem;
  }
  
  .mara-info h3 {
    font-size: 1.5rem;
    margin-bottom: 0;
    color: var(--text-color);
  }
  
  .mara-badge {
    display: inline-block;
    background-color: var(--secondary-color);
    color: white;
    font-size: 0.7rem;
    font-weight: 600;
    padding: 0.25rem 0.5rem;
    border-radius: 20px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }
  
  .mara-info p {
    font-size: 1rem;
    margin-bottom: 1rem;
    opacity: 0.9;
    line-height: 1.5;
  }
  
  .mara-chat-button {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: linear-gradient(135deg, var(--accent-color), var(--secondary-color));
    color: white;
    border: none;
    border-radius: 30px;
    padding: 0.7rem 1.4rem;
    font-weight: 600;
    font-size: 0.95rem;
    cursor: pointer;
    transition: all 0.3s ease;
    box-shadow: 0 4px 15px rgba(var(--accent-color-rgb), 0.3);
    position: relative;
    overflow: hidden;
    z-index: 1;
  }
  
  .mara-chat-button::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, var(--secondary-color), var(--accent-color));
    opacity: 0;
    z-index: -1;
    transition: opacity 0.3s ease;
  }
  
  .mara-chat-button:hover {
    transform: translateY(-3px);
    box-shadow: 0 6px 20px rgba(var(--accent-color-rgb), 0.4);
  }
  
  .mara-chat-button:hover::before {
    opacity: 1;
  }
  
  .mara-chat-button i {
    transition: transform 0.3s ease;
  }
  
  .mara-chat-button:hover i {
    transform: translateX(5px);
  }
  
  .mara-chat-button:active {
    transform: translateY(-1px);
    box-shadow: 0 2px 10px rgba(var(--accent-color-rgb), 0.3);
  }
  
  @media (max-width: 640px) {
    .mara-assistant-content {
      flex-direction: column;
      text-align: center;
      padding: 2rem 1.5rem;
    }
    
    .mara-info {
      display: flex;
      flex-direction: column;
      align-items: center;
    }
    
    .mara-title-container {
      flex-direction: column;
      gap: 0.5rem;
    }
    
    .mara-avatar {
      width: 90px;
      height: 90px;
      margin-bottom: 0.5rem;
    }
    
    .mara-avatar-glow {
      width: 110px;
      height: 110px;
    }
    
    .mara-decorative-circle-1 {
      top: -20px;
      left: -30px;
      width: 100px;
      height: 100px;
    }
    
    .mara-decorative-circle-3 {
      top: 10px;
      right: -10px;
      width: 50px;
      height: 50px;
    }
    
    .mara-status-indicator {
      bottom: 2px;
      right: 2px;
      width: 16px;
      height: 16px;
    }
  }
</style>
