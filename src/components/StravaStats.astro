---
// Define interfaces for our data
interface ActivitySummary {
  name: string;
  type: string;
  distance: number; // in kilometers
  duration?: number; // in minutes
  date: string;
}

interface ActivityType {
  name: string;
  count: number;
  totalDistance?: number;
}

interface Summary {
  total_distance: number;
  total_elevation_gain: number;
  total_duration: number;
  activity_count: number;
}

interface YearlyStat {
  year: number;
  visits_count: number;
  countries_count: number;
  cities_count: number;
}

// Define the API URL
const apiUrl = 'http://api.homelab/api/v1/strava/data';

// Initialize variables with default values
let recentActivities: ActivitySummary[] = [];
let topActivityTypes: ActivityType[] = [];
let yearlyStats: YearlyStat[] = [];
let summary: Summary = {
  total_distance: 0,
  total_elevation_gain: 0,
  total_duration: 0,
  activity_count: 0
};
let athleteName = '';
let athleteLocation = '';
let hasError = false;
let errorMessage = '';
let isLoading = true;

// Check if we have cached data in sessionStorage
let cachedData = null;
if (typeof window !== 'undefined' && window.sessionStorage) {
  const cached = sessionStorage.getItem('stravaStatsCache');
  if (cached) {
    try {
      const { data, timestamp } = JSON.parse(cached);
      // Use cache if it's less than 15 minutes old
      if (Date.now() - timestamp < 15 * 60 * 1000) {
        cachedData = data;
        console.log('Using cached Strava data');
      }
    } catch (e) {
      console.error('Error parsing cached Strava data:', e);
    }
  }
}

try {
  if (cachedData) {
    // Use cached data
    const data = cachedData;
    
    // Process the data
    if (data.athlete) {
      athleteName = data.athlete.name || 'Unknown Athlete';
      athleteLocation = data.athlete.location || 'Unknown Location';
    }
    
    recentActivities = data.recent_activities || [];
    topActivityTypes = data.top_activity_types || [];
    summary = data.summary || {
      total_distance: 0,
      total_elevation_gain: 0,
      total_duration: 0,
      activity_count: 0
    };
    
    isLoading = false;
  } else {
    // Fetch data from the API
    const response = await fetch(apiUrl);
    
    if (!response.ok) {
      throw new Error(`API request failed: ${response.status}`);
    }
    
    const data = await response.json();
    
    // Cache the data in sessionStorage
    if (typeof window !== 'undefined' && window.sessionStorage) {
      sessionStorage.setItem('stravaStatsCache', JSON.stringify({
        data,
        timestamp: Date.now()
      }));
    }
    
    // Process the data
    if (data.athleteProfile) {
      athleteName = `${data.athleteProfile.firstname} ${data.athleteProfile.lastname}` || 'Unknown Athlete';
      athleteLocation = data.athleteProfile.city ? 
        `${data.athleteProfile.city}, ${data.athleteProfile.country}` : 
        'Unknown Location';
    }
    
    recentActivities = data.recentActivities || [];
    topActivityTypes = data.topActivityTypes || [];
    summary = data.summary || {
      total_distance: 0,
      total_elevation_gain: 0,
      total_duration: 0,
      activity_count: 0
    };
    
    isLoading = false;
  }
  
  // Convert distance from meters to miles if needed
  if (summary.total_distance > 1000) { // Assuming it's in meters if > 1000
    summary.total_distance = summary.total_distance / 1609.34; // Convert meters to miles
  }
  
  // Convert activity distances from meters to miles if needed
  recentActivities = recentActivities.map(activity => ({
    ...activity,
    distance: activity.distance > 100 ? activity.distance / 1609.34 : activity.distance // Convert meters to miles if needed
  }));
  
  // Format activity types for UI
  topActivityTypes = topActivityTypes.map(type => ({
    name: type.name,
    count: type.count,
    totalDistance: type.totalDistance || 0
  }));
  
} catch (error) {
  console.error('Error fetching Strava data:', error);
  hasError = true;
  errorMessage = error instanceof Error ? error.message : 'Unknown error';
  isLoading = false;
}

// Determine if we have data to display
const hasData = recentActivities.length > 0;

// Helper function to format duration
function formatDuration(seconds: number): string {
  const minutes = Math.floor(seconds / 60);
  const hours = Math.floor(minutes / 60);
  const mins = minutes % 60;
  return hours > 0 ? `${hours}h ${mins}m` : `${mins}m`;
}

// Helper function to get activity icon
function getActivityIcon(type: string): string {
  switch (type.toLowerCase()) {
    case 'run':
    case 'running':
      return `<i class="fas fa-running"></i>`;
    case 'ride':
    case 'cycling':
    case 'bikeride':
    case 'virtualride':
      return `<i class="fas fa-bicycle"></i>`;
    case 'swim':
    case 'swimming':
      return `<i class="fas fa-swimmer"></i>`;
    case 'hike':
    case 'hiking':
    case 'walk':
    case 'walking':
      return `<i class="fas fa-hiking"></i>`;
    case 'workout':
    case 'weighttraining':
    case 'weight_training':
    case 'weights':
      return `<i class="fas fa-dumbbell"></i>`;
    case 'yoga':
      return `<i class="fas fa-om"></i>`;
    case 'crossfit':
    case 'workout':
    case 'training':
      return `<i class="fas fa-heartbeat"></i>`;
    default:
      return `<i class="fas fa-plus"></i>`;
  }
}

// Format date for display
function formatDate(dateStr: string): string {
  const date = new Date(dateStr);
  return date.toLocaleDateString('en-US', { 
    year: 'numeric', 
    month: 'short', 
    day: 'numeric' 
  });
}
---

<div class="strava-stats-component p-6 bg-white rounded-lg border-l-4 border-orange-600 shadow-md dark:bg-gray-800 dark:border-orange-500">
  <!-- Simple Error Banner -->
  {errorMessage && (
    <div class="p-4 mb-6 text-sm text-orange-800 rounded-lg bg-orange-50 dark:bg-gray-800 dark:text-orange-400 border border-orange-300 dark:border-orange-800">
      <div class="flex items-center">
        <svg class="flex-shrink-0 inline w-5 h-5 mr-3" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 20 20">
          <path d="M10 .5a9.5 9.5 0 1 0 9.5 9.5A9.51 9.51 0 0 0 10 .5ZM9.5 4a1.5 1.5 0 1 1 0 3 1.5 1.5 0 0 1 0-3ZM12 15H8a1 1 0 0 1 0-2h1v-3H8a1 1 0 0 1 0-2h2a1 1 0 0 1 1 1v4h1a1 1 0 0 1 0 2Z"/>
        </svg>
        <span class="font-medium">
          Some stats may not be available due to: {errorMessage}
        </span>
      </div>
    </div>
  )}

  <div class="flex items-center mb-6">
    <div class="w-10 h-10 flex items-center justify-center text-orange-600 dark:text-orange-400 me-4">
      <i class="fab fa-strava text-3xl"></i>
    </div>
    <h2 class="text-3xl font-bold text-gray-900 dark:text-white">Strava Stats</h2>
  </div>
  
  
  <!-- Summary Stats -->
  <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
    {isLoading ? (
      // Skeleton loaders for summary stats
      Array(4).fill(0).map(() => (
        <div class="p-4 bg-gray-50 rounded-lg dark:bg-gray-700 flex flex-col items-center justify-center">
          <div class="w-24 h-4 bg-gray-200 dark:bg-gray-600 rounded animate-pulse mb-2"></div>
          <div class="w-16 h-8 bg-gray-200 dark:bg-gray-600 rounded animate-pulse"></div>
        </div>
      ))
    ) : (
      <>
        <div class="p-4 bg-gray-50 rounded-lg dark:bg-gray-700 flex flex-col items-center justify-center">
          <span class="text-sm text-gray-500 dark:text-gray-400">Activities</span>
          <span class="text-2xl font-bold text-gray-900 dark:text-white" id="activity-count">{summary.activity_count}</span>
        </div>
        <div class="p-4 bg-gray-50 rounded-lg dark:bg-gray-700 flex flex-col items-center justify-center">
          <span class="text-sm text-gray-500 dark:text-gray-400">Distance</span>
          <span class="text-2xl font-bold text-gray-900 dark:text-white" id="total-distance">{Math.round((summary.total_distance || 0) * 10) / 10} mi</span>
        </div>
        <div class="p-4 bg-gray-50 rounded-lg dark:bg-gray-700 flex flex-col items-center justify-center">
          <span class="text-sm text-gray-500 dark:text-gray-400">Elevation</span>
          <span class="text-2xl font-bold text-gray-900 dark:text-white" id="total-elevation">{Math.round(summary.total_elevation_gain)} m</span>
        </div>
        <div class="p-4 bg-gray-50 rounded-lg dark:bg-gray-700 flex flex-col items-center justify-center">
          <span class="text-sm text-gray-500 dark:text-gray-400">Duration</span>
          <span class="text-2xl font-bold text-gray-900 dark:text-white" id="total-duration">{formatDuration(summary.total_duration)}</span>
        </div>
      </>
    )}
  </div>
  
  <!-- Stats Grid -->
  <div id="stats-grid" class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <!-- Recent Activities -->
    <div class="p-4 bg-gray-50 rounded-lg dark:bg-gray-700">
      <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-4">Recent Activities</h3>
      <div id="recent-activities-container" class="space-y-3">
        {isLoading ? (
          // Skeleton loaders for activities
          Array(5).fill(0).map(() => (
            <div class="flex items-center justify-between py-2 border-b border-gray-200 dark:border-gray-600 last:border-0">
              <div class="flex items-center">
                <div class="w-6 h-6 bg-gray-200 dark:bg-gray-600 rounded animate-pulse"></div>
                <div class="w-10 h-10 rounded-full mx-3 bg-gray-200 dark:bg-gray-600 animate-pulse"></div>
                <div>
                  <div class="w-32 h-5 bg-gray-200 dark:bg-gray-600 rounded animate-pulse mb-2"></div>
                  <div class="w-24 h-4 bg-gray-200 dark:bg-gray-600 rounded animate-pulse"></div>
                </div>
              </div>
              <div class="text-right">
                <div class="w-16 h-5 bg-gray-200 dark:bg-gray-600 rounded animate-pulse mb-2"></div>
                <div class="w-12 h-4 bg-gray-200 dark:bg-gray-600 rounded animate-pulse"></div>
              </div>
            </div>
          ))
        ) : recentActivities && recentActivities.length > 0 ? (
          recentActivities.map((activity: ActivitySummary, index: number) => (
            <div class="flex items-center justify-between py-2 border-b border-gray-200 dark:border-gray-600 last:border-0">
              <div class="flex items-center">
                <span class="text-lg font-medium text-gray-500 dark:text-gray-400 w-6">{index + 1}</span>
                <div class="w-10 h-10 rounded-full mx-3 bg-orange-100 dark:bg-orange-900 flex items-center justify-center text-orange-600 dark:text-orange-300">
                  <Fragment set:html={getActivityIcon(activity.type)} />
                </div>
                <div>
                  <p class="font-medium text-gray-900 dark:text-white">{activity.name}</p>
                  <p class="text-sm text-gray-500 dark:text-gray-400">{activity.type} • {formatDate(activity.date)}</p>
                </div>
              </div>
              <div class="text-right">
                <p class="font-medium text-gray-900 dark:text-white">{(activity.distance || 0).toFixed(1)} mi</p>
                {activity.duration && (
                  <p class="text-sm text-gray-500 dark:text-gray-400">{formatDuration(activity.duration)}</p>
                )}
              </div>
            </div>
          ))
        ) : (
          <div>
            <p class="text-gray-500 dark:text-gray-400">No recent activity data available</p>
          </div>
        )}
      </div>
    </div>
    
    <!-- Activity Types -->
    <div class="p-4 bg-gray-50 rounded-lg dark:bg-gray-700">
      <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-4">Activity Types</h3>
      <div id="activity-types-container" class="space-y-3">
        {isLoading ? (
          // Skeleton loaders for activity types
          Array(5).fill(0).map(() => (
            <div class="mb-3 last:mb-0">
              <div class="flex justify-between mb-1">
                <div class="w-32 h-5 bg-gray-200 dark:bg-gray-600 rounded animate-pulse"></div>
                <div class="w-24 h-5 bg-gray-200 dark:bg-gray-600 rounded animate-pulse"></div>
              </div>
              <div class="w-full bg-gray-200 rounded-full h-2.5 dark:bg-gray-700">
                <div class="bg-gray-300 dark:bg-gray-600 h-2.5 rounded-full animate-pulse" style={`width: ${Math.random() * 100}%`}></div>
              </div>
            </div>
          ))
        ) : topActivityTypes && topActivityTypes.length > 0 ? (
          topActivityTypes.map((activityType: ActivityType) => (
            <div class="mb-3 last:mb-0">
              <div class="flex justify-between mb-1">
                <span class="text-base font-medium text-gray-900 dark:text-white">{activityType.name}</span>
                <span class="text-sm font-medium text-gray-500 dark:text-gray-400">{activityType.count} activities</span>
              </div>
              <div class="w-full bg-gray-200 rounded-full h-2.5 dark:bg-gray-700">
                <div class="bg-orange-600 h-2.5 rounded-full" style={`width: ${topActivityTypes.length > 0 ? (activityType.count / topActivityTypes[0].count) * 100 : 0}%`}></div>
              </div>
            </div>
          ))
        ) : (
          <div>
            <p class="text-gray-500 dark:text-gray-400">No activity type data available</p>
          </div>
        )}
      </div>
    </div>
  </div>
  
  <!-- Athlete Info -->
  {athleteName && (
    <div class="mt-6 p-4 bg-gray-50 rounded-lg dark:bg-gray-700">
      <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-4">Athlete Information</h3>
      <div class="flex items-center">
        <div class="w-12 h-12 rounded-full bg-orange-100 dark:bg-orange-900 flex items-center justify-center text-orange-600 dark:text-orange-300 mr-4">
          <i class="fas fa-user"></i>
        </div>
        <div>
          <p class="font-medium text-gray-900 dark:text-white">{athleteName}</p>
          {athleteLocation && (
            <p class="text-sm text-gray-500 dark:text-gray-400">
              <i class="fas fa-map-marker-alt mr-1"></i> {athleteLocation}
            </p>
          )}
        </div>
      </div>
    </div>
  )}
</div>
