---
import ThemeToggle from "../components/ThemeToggle.astro";

// Navigation links
const navLinks = [
  { name: "About", href: "/" },
  // { name: "Notes", href: "/notes" },
  { name: "Stats", href: "/stats" },
  { name: "Contact", href: "/contact" },
];
---

<nav class="nav-container">
  <div class="nav-links">
    <!-- Navigation links -->
    <div class="standard-links">
      {navLinks.map((link) => (
        <a 
          href={link.href} 
          class={`nav-link ${Astro.url.pathname === link.href ? "active" : ""}`}
          aria-current={Astro.url.pathname === link.href ? "page" : undefined}
        >
          {link.name}
        </a>
      ))}
    </div>
    
    <div class="theme-controls">
      <ThemeToggle />
    </div>
  </div>
</nav>

<script>
  // No script needed for navigation now that RPG mode is removed
</script>

<style>
  /* Mobile-friendly navigation styles */
  @media (max-width: 640px) {
    .nav-links {
      gap: 0.5rem;
    }
    
    .nav-link {
      padding: 0.4rem 0.8rem;
      font-size: 0.9rem;
    }
  }
  
  .theme-controls {
    display: flex;
    align-items: center;
  }
</style>
