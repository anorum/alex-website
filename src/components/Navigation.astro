---
import ThemeToggle from "../components/ThemeToggle.astro";

const links = [
  { name: "About", href: "/" },
  { name: "Notes", href: "/notes" },
  { name: "Stats", href: "/stats" },
  { name: "Contact", href: "/contact" },
];
---


<nav class="bg-white dark:bg-gray-900 fixed w-full z-20 top-0 start-0">
  <div class="max-w-screen-xl flex flex-wrap items-center justify-between mx-auto p-4">
  <a href="/" class="flex items-center space-x-3 rtl:space-x-reverse">
      <span class="self-center text-2xl font-semibold whitespace-nowrap dark:text-white">Alex Norum</span>
  </a>
  <div class="flex order-2 space-x-0 rtl:space-x-reverse">
    <div class="ms-3">
      {/* Import ThemeToggle component */}
      <ThemeToggle />
    </div>
  </div>
  <div class="items-center justify-between flex w-auto order-1" id="navbar-sticky">
    <ul class="flex flex-row p-0 mt-0 font-medium border-0 space-x-8 rtl:space-x-reverse bg-transparent">
      {links.map((link) => (
      <li>
        <a 
              href={link.href} 
              class={`rounded-full px-2 py-2 sm:px-3 sm:py-2 md:px-4 md:py-3 text-sm font-medium ${
                Astro.url.pathname === link.href 
                  ? "bg-gray-900 text-white dark:bg-blue-600" 
                  : "text-gray-700 hover:bg-gray-200 hover:text-gray-900 dark:text-gray-300 dark:hover:bg-gray-700 dark:hover:text-white"
              }`}
              aria-current={Astro.url.pathname === link.href ? "page" : undefined}
            >
              {link.name}
            </a>
      </li>
      ))}
    </ul>
  </div>
  </div>
</nav>
