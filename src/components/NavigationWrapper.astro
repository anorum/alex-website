---
import Navigation from './Navigation.astro';
import NavigationRPG from './rpg/NavigationRPG.astro';
---

<!-- Standard Navigation (visible by default) -->
<div class="standard-navigation">
  <Navigation />
</div>

<!-- RPG Navigation (hidden by default) -->
<div class="rpg-navigation hidden">
  <NavigationRPG />
</div>

<script is:inline>
  document.addEventListener('DOMContentLoaded', function() {
    updateNavigation();
  });
  
  document.addEventListener('astro:page-load', function() {
    updateNavigation();
  });
  
  function updateNavigation() {
    const currentTheme = localStorage.getItem('site-theme') || 'standard';
    const standardNavigation = document.querySelector('.standard-navigation');
    const rpgNavigation = document.querySelector('.rpg-navigation');
    
    console.log('NavigationWrapper - Current theme:', currentTheme);
    
    if (currentTheme === 'rpg') {
      standardNavigation?.classList.add('hidden');
      rpgNavigation?.classList.remove('hidden');
      console.log('NavigationWrapper - Showing RPG navigation');
    } else {
      standardNavigation?.classList.remove('hidden');
      rpgNavigation?.classList.add('hidden');
      console.log('NavigationWrapper - Showing standard navigation');
    }
  }
  
  // Listen for theme changes
  window.addEventListener('storage', function(event) {
    if (event.key === 'site-theme') {
      updateNavigation();
    }
  });
  
  // Custom event for theme changes
  document.addEventListener('themeChanged', function() {
    console.log('NavigationWrapper - themeChanged event received');
    updateNavigation();
  });
</script>

<style>
  .hidden {
    display: none;
  }
</style>
