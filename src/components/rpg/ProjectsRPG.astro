---
import { projects } from '../../data/projects';

const statusTag: Record<string, string> = {
  live: 'IN SERVICE',
  active: 'IN SERVICE',
  stable: 'FIELD TESTED',
  internal: 'GUILD PROPERTY',
  deprecated: 'BROKEN',
};
---

<div class="shop">
  <p class="shop-keeper">
    <span class="shop-keeper-cursor" aria-hidden="true">▶</span>
    Welcome, traveler. Everything here was forged after hours. Take a look.
  </p>

  <div class="shop-layout">
    <ul class="shop-list" role="list">
      {projects.map((p, i) => (
        <li>
          <button
            type="button"
            class={`shop-item ${i === 0 ? 'selected' : ''} ${p.status === 'deprecated' ? 'broken' : ''}`}
            data-project={p.id}
            aria-pressed={i === 0 ? 'true' : 'false'}
          >
            <span class="shop-item-cursor" aria-hidden="true">▶</span>
            <span class="shop-item-name">{p.rpg.itemName}</span>
          </button>
        </li>
      ))}
    </ul>

    <div class="shop-detail">
      {projects.map((p, i) => (
        <div class={`shop-card ${i === 0 ? 'selected' : ''}`} data-project={p.id}>
          <div class="shop-card-head">
            <span class="shop-card-name">{p.rpg.itemName}</span>
            <span class={`shop-card-status ${p.status === 'deprecated' ? 'broken' : ''}`}>
              {statusTag[p.status]}
            </span>
          </div>
          <p class="shop-flavor">{p.rpg.itemDescription}</p>
          <div class="shop-divider" aria-hidden="true"></div>
          <div class="shop-real-label">APPRAISAL - REAL WORLD DATA</div>
          <p class="shop-desc">{p.description}</p>
          {p.highlights.length > 0 && (
            <ul class="shop-highlights" role="list">
              {p.highlights.map((h) => (
                <li>
                  <span class="shop-tri" aria-hidden="true">▸</span> {h}
                </li>
              ))}
            </ul>
          )}
          <div class="shop-tech">
            {p.tech.map((t) => (
              <span class="shop-tech-tag">{t}</span>
            ))}
          </div>
          {(p.links.live || p.links.repo) && (
            <div class="shop-links">
              {p.links.live && (
                <a href={p.links.live} target="_blank" rel="noopener noreferrer">USE ITEM (LIVE)</a>
              )}
              {p.links.repo && (
                <a href={p.links.repo} target="_blank" rel="noopener noreferrer">INSPECT (GITHUB)</a>
              )}
            </div>
          )}
        </div>
      ))}
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    function selectProject(id) {
      document.querySelectorAll('.shop-item').forEach(function (btn) {
        var on = btn.getAttribute('data-project') === id;
        btn.classList.toggle('selected', on);
        btn.setAttribute('aria-pressed', on ? 'true' : 'false');
      });
      document.querySelectorAll('.shop-card').forEach(function (card) {
        card.classList.toggle('selected', card.getAttribute('data-project') === id);
      });
    }

    document.querySelectorAll('.shop-item').forEach(function (btn) {
      btn.addEventListener('click', function () {
        selectProject(btn.getAttribute('data-project'));
      });
    });

    // Deep-link support: switchRPGSection('projects') callers may pass a focus id
    document.addEventListener('rpg:section-change', function (e) {
      var d = e.detail || {};
      if (d.section === 'projects' && d.focus) selectProject(d.focus);
    });
  })();
</script>

<style>
  .shop {
    color: var(--ff7-text);
  }

  .shop-keeper {
    border: 1px solid var(--ff7-border);
    background-color: var(--ff7-blue-dark);
    padding: 0.75rem 1rem;
    margin-bottom: 1rem;
    font-size: 0.85em;
    line-height: 1.6;
  }

  .shop-keeper-cursor {
    color: var(--ff7-text-highlight);
    margin-right: 0.5em;
    animation: shopBlink 1.2s steps(2, start) infinite;
  }

  @keyframes shopBlink {
    to { visibility: hidden; }
  }

  @media (prefers-reduced-motion: reduce) {
    .shop-keeper-cursor {
      animation: none;
    }
  }

  .shop-layout {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
    gap: 1rem;
  }

  @media (max-width: 720px) {
    .shop-layout {
      grid-template-columns: 1fr;
    }
  }

  .shop-list {
    border: 1px solid var(--ff7-border);
    background-color: rgba(0, 0, 0, 0.2);
    padding: 0.5rem;
    margin: 0;
    align-self: start;
  }

  .shop-list li {
    list-style: none;
  }

  .shop-item {
    display: flex;
    align-items: center;
    gap: 0.5em;
    width: 100%;
    text-align: left;
    background: none;
    border: none;
    color: var(--ff7-text);
    font-family: inherit;
    font-size: 0.85em;
    padding: 0.625rem 0.5rem;
    cursor: pointer;
  }

  .shop-item-cursor {
    color: var(--ff7-text-highlight);
    visibility: hidden;
    flex-shrink: 0;
  }

  .shop-item.selected .shop-item-cursor {
    visibility: visible;
  }

  .shop-item.selected .shop-item-name,
  .shop-item:hover .shop-item-name {
    color: var(--ff7-text-highlight);
  }

  .shop-item.broken .shop-item-name {
    color: rgba(192, 192, 192, 0.5);
    text-decoration: line-through;
  }

  .shop-detail {
    min-width: 0;
  }

  .shop-card {
    display: none;
    border: 1px solid var(--ff7-border);
    background-color: rgba(0, 0, 0, 0.2);
    padding: 1rem;
  }

  .shop-card.selected {
    display: block;
  }

  .shop-card-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .shop-card-name {
    color: var(--ff7-text-highlight);
    font-weight: bold;
  }

  .shop-card-status {
    font-size: 0.7em;
    color: var(--ff7-mp-color, #4cc3ff);
  }

  .shop-card-status.broken {
    color: #ff6b6b;
  }

  .shop-flavor {
    margin-top: 0.75rem;
    font-style: italic;
    font-size: 0.85em;
    line-height: 1.6;
    color: var(--ff7-text);
  }

  .shop-divider {
    border-top: 1px solid var(--ff7-border);
    margin: 0.875rem 0;
  }

  .shop-real-label {
    font-size: 0.7em;
    color: var(--ff7-text-highlight);
    margin-bottom: 0.5rem;
  }

  .shop-desc {
    font-size: 0.8em;
    line-height: 1.65;
  }

  .shop-highlights {
    margin: 0.75rem 0 0;
    padding: 0;
  }

  .shop-highlights li {
    list-style: none;
    font-size: 0.75em;
    line-height: 1.6;
  }

  .shop-tri {
    color: var(--ff7-text-highlight);
  }

  .shop-tech {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.875rem;
  }

  .shop-tech-tag {
    font-size: 0.65em;
    border: 1px solid var(--ff7-border);
    padding: 0.25rem 0.5rem;
    color: var(--ff7-text);
  }

  .shop-links {
    display: flex;
    gap: 1.25rem;
    margin-top: 1rem;
    flex-wrap: wrap;
  }

  .shop-links a {
    font-size: 0.75em;
    color: var(--ff7-text-highlight);
    text-decoration: underline;
  }
</style>
