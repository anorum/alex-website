---
import '../../styles/ff7-menu.css';

const rpgLinks = [
  { name: "WORLD", scene: "world",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>` },
  { name: "STATUS", scene: "house",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" /></svg>` },
  { name: "ABILITIES", scene: "tower",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>` },
  { name: "SKILLS", scene: "dojo",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" /></svg>` },
  { name: "QUESTS", scene: "hall",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" /></svg>` },
  { name: "SHOP", scene: "shop",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" /></svg>` },
  { name: "CRAFTS", scene: "camp",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" /></svg>` },
  { name: "MAP", scene: "harbor",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7" /></svg>` },
  { name: "BATTLE", scene: "arena",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3l7 7m0 0v4m0-4h4M21 3l-7 7m0 0v4m0-4h4M3 21l6-6m12 6l-6-6" /></svg>` },
  { name: "ENCOUNTERS: ON", command: "toggle-encounters", labelAttr: "data-encounters-label",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>` },
  { name: "SOUND: OFF", command: "toggle-sound", labelAttr: "data-sound-label",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.536 8.464a5 5 0 010 7.072M12 6L7 10H4v4h3l5 4V6z" /></svg>` },
  { name: "EXIT", action: "exit",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" /></svg>` },
];
---

<div class="ff7-menu-button-container">
  <button id="ff7-menu-button" class="ff7-menu-button" onclick="toggleFF7Menu()">
    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
    </svg>
    <span>MENU</span>
  </button>
</div>

<div id="ff7-nav" class="ff7-game-menu hidden">
  <div class="ff7-status-bar ff7-status-top">
    <div class="ff7-time">Time <span id="ff7-clock">0:00:00</span></div>
    <div class="ff7-gil">Gil 2230</div>
  </div>
  <div class="ff7-menu-header">MENU</div>
  <div class="ff7-menu-options">
    {rpgLinks.map((link) => (
      link.action === "exit" ? (
        <div class="ff7-menu-option ff7-action-exit" onclick="exitRPGMode()">
          <span class="ff7-menu-icon" set:html={link.icon} />
          <span class="ff7-menu-text">{link.name}</span>
        </div>
      ) : link.scene ? (
        <div class="ff7-menu-option" data-scene={link.scene} onclick={`gotoRPGScene('${link.scene}')`}>
          <span class="ff7-menu-icon" set:html={link.icon} />
          <span class="ff7-menu-text">{link.name}</span>
        </div>
      ) : (
        <div class="ff7-menu-option" onclick={`rpgCommand('${link.command}')`}>
          <span class="ff7-menu-icon" set:html={link.icon} />
          <span class="ff7-menu-text" {...{ [link.labelAttr!]: '' }}>{link.name}</span>
        </div>
      )
    ))}
  </div>
</div>

<script is:inline>
  function toggleFF7Menu() {
    var menu = document.getElementById('ff7-nav');
    if (menu) menu.classList.toggle('hidden');
  }

  // Play time, like the real thing: counts up while the page is open
  (function() {
    var start = Date.now();
    var el = document.getElementById('ff7-clock');
    if (!el) return;
    function pad(n) { return n < 10 ? '0' + n : '' + n; }
    setInterval(function() {
      var s = Math.floor((Date.now() - start) / 1000);
      el.textContent = Math.floor(s / 3600) + ':' + pad(Math.floor(s / 60) % 60) + ':' + pad(s % 60);
    }, 1000);
  })();

  function exitRPGMode() {
    localStorage.setItem('site-theme', 'standard');
    document.documentElement.classList.forEach(function(c) {
      if (c.startsWith('theme-')) document.documentElement.classList.remove(c);
    });
    document.documentElement.classList.add('theme-standard');
    document.dispatchEvent(new CustomEvent('theme:change', { detail: { theme: 'standard' } }));
    var menu = document.getElementById('ff7-nav');
    if (menu) menu.classList.add('hidden');
    return false;
  }

  document.addEventListener('click', function(e) {
    var menu = document.getElementById('ff7-nav');
    var btn = document.getElementById('ff7-menu-button');
    if (menu && btn && !menu.classList.contains('hidden') && !menu.contains(e.target) && !btn.contains(e.target)) {
      menu.classList.add('hidden');
    }
  });

  // Keyboard navigation for the FF7 menu (only while the menu is open)
  document.addEventListener('keydown', function(e) {
    var menu = document.getElementById('ff7-nav');
    if (!menu || menu.classList.contains('hidden')) return;
    if (e.metaKey || e.ctrlKey || e.altKey) return;
    if (['ArrowUp', 'ArrowDown', 'Enter', 'Escape'].indexOf(e.key) === -1) return;

    var options = Array.prototype.slice.call(menu.querySelectorAll('.ff7-menu-option'));
    if (options.length === 0) return;
    var current = options.findIndex(function(o) { return o.classList.contains('active'); });

    if (e.key === 'Escape') {
      menu.classList.add('hidden');
      options.forEach(function(o) { o.classList.remove('active'); });
    } else if (e.key === 'ArrowUp' || e.key === 'ArrowDown') {
      var delta = e.key === 'ArrowUp' ? -1 : 1;
      var next = current === -1 ? (delta === 1 ? 0 : options.length - 1) : (current + delta + options.length) % options.length;
      options.forEach(function(o, i) { o.classList.toggle('active', i === next); });
    } else if (e.key === 'Enter' && current !== -1) {
      options[current].click();
    }
    e.preventDefault();
  });
</script>
