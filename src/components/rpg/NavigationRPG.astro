---

<!-- Menu Button -->
<div class="ff7-menu-button-container">
  <button id="ff7-menu-button" class="ff7-menu-button" onclick="toggleFF7Menu()">
    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
    </svg>
    <span>MENU</span>
  </button>
</div>

<!-- FF7 Game Menu (hidden by default) -->
<div id="ff7-nav" class="ff7-game-menu hidden">
  <!-- Status Bar at Top -->
  <div class="ff7-status-bar ff7-status-top">
    <div class="ff7-time">Time 0:54:53</div>
    <div class="ff7-gil">Gil 2230</div>
  </div>
  
  <div class="ff7-menu-header">MENU</div>
  
  <!-- Menu Options -->
  <div class="ff7-menu-options">
    {rpgLinks.map((link) => (
      link.action === "exit" ? (
        <div 
          class="ff7-menu-option ff7-action-exit"
          data-action={link.action}
          onclick="exitRPGMode()"
        >
          <span class="ff7-menu-icon" set:html={link.icon} />
          <span class="ff7-menu-text">{link.name}</span>
        </div>
      ) : link.action === "mara" ? (
        <div 
          class="ff7-menu-option"
          data-action={link.action}
          onclick="openMaraChatbot()"
        >
          <span class="ff7-menu-icon" set:html={link.icon} />
          <span class="ff7-menu-text">{link.name}</span>
        </div>
      ) : link.href ? (
        <a 
          href={link.href}
          class="ff7-menu-option"
        >
          <span class="ff7-menu-icon" set:html={link.icon} />
          <span class="ff7-menu-text">{link.name}</span>
        </a>
      ) : (
        <div 
          class="ff7-menu-option"
          data-section={link.section}
          data-href={link.href}
          onclick={`switchRPGSection('${link.section}')`}
        >
          <span class="ff7-menu-icon" set:html={link.icon} />
          <span class="ff7-menu-text">{link.name}</span>
        </div>
      )
    ))}
  </div>
</div>

<script is:inline>
  // Global function to toggle the menu
  function toggleFF7Menu() {
    const menu = document.getElementById('ff7-nav');
    if (menu) {
      menu.classList.toggle('hidden');
      playFF7MenuSound('open');
    }
  }
  
  // Global function to exit RPG mode
  function exitRPGMode() {
    
    // Update localStorage
    localStorage.setItem('site-theme', 'standard');
    
    // Directly update DOM classes
    document.documentElement.classList.forEach(className => {
      if (className.startsWith('theme-')) {
        document.documentElement.classList.remove(className);
      }
    });
    document.documentElement.classList.add('theme-standard');
    
    // Force update of navigation components
    const standardNavigation = document.querySelector('.standard-navigation');
    const rpgNavigation = document.querySelector('.rpg-navigation');
    
    if (standardNavigation && rpgNavigation) {
      standardNavigation.classList.remove('hidden');
      rpgNavigation.classList.add('hidden');
    }
    
    // Dispatch event for other components to react
    document.dispatchEvent(new CustomEvent('themeChanged', { 
      detail: { theme: 'standard' } 
    }));
    
    // Play sound and hide menu
    playFF7MenuSound('select');
    const menu = document.getElementById('ff7-nav');
    if (menu) {
      menu.classList.add('hidden');
    }
    
    // Force refresh of theme-dependent components
    setTimeout(() => {
      window.dispatchEvent(new Event('storage'));
    }, 50);
    
    return false; // Prevent default link behavior
  }
  
  // Global function to switch RPG sections
  function switchRPGSection(sectionId) {
    
    // Check if we're on the index page
    const isIndexPage = window.location.pathname === '/' || 
                        window.location.pathname === '/index' || 
                        window.location.pathname === '/index.html';
    
    if (!isIndexPage) {
      // If not on index page, navigate to index with section parameter
      window.location.href = `/?section=${sectionId}`;
      return false;
    }
    
    // Store the current section
    sessionStorage.setItem('rpg-active-section', sectionId);
    
    // Hide all sections
    const sections = document.querySelectorAll('.rpg-section');
    sections.forEach(section => {
      section.classList.remove('active');
    });
    
    // Show the selected section
    const selectedSection = document.getElementById(`rpg-${sectionId}`);
    if (selectedSection) {
      selectedSection.classList.add('active');
      
      // Play section change sound
      playFF7MenuSound('select');
      
      // Close the menu
      const menu = document.getElementById('ff7-nav');
      if (menu) {
        menu.classList.add('hidden');
      }
    }
    
    return false; // Prevent default link behavior
  }
  
  // Global function to open Mara chatbot
  function openMaraChatbot() {
    playFF7MenuSound('select');
    
    // Close the menu
    const menu = document.getElementById('ff7-nav');
    if (menu) {
      menu.classList.add('hidden');
    }
    
    // Try multiple selectors to find the Chainlit chatbot button
    const selectors = [
      '.chainlit-open-btn',
      '#chainlit-open-btn',
      '.cl-open-btn',
      '#cl-open-btn',
      '[data-testid="open-chat-button"]',
      '.chat-open-button',
      '.chat-toggle-button',
      '.chainlit-button'
    ];
    
    let chatbotButton = null;
    
    // Try each selector until we find a match
    for (const selector of selectors) {
      chatbotButton = document.querySelector(selector);
      if (chatbotButton) {
        break;
      }
    }
    
    // If we found a button, click it
    if (chatbotButton) {
      chatbotButton.click();
    } else {
      // Fallback: Try to find any button that might be the chatbot
      // Look for any button with "chat" in its class or id
      const possibleButtons = document.querySelectorAll('button');
      for (const btn of possibleButtons) {
        const classNames = btn.className || '';
        const id = btn.id || '';
        
        if (classNames.toLowerCase().includes('chat') || 
            id.toLowerCase().includes('chat') ||
            classNames.toLowerCase().includes('mara') || 
            id.toLowerCase().includes('mara')) {
          btn.click();
          break;
        }
      }
    }
    
    return false;
  }
  
  // Global function to play menu sounds
  function playFF7MenuSound(type) {
    // Create audio element for menu sounds
    const audio = new Audio();
    
    switch(type) {
      case 'open':
        // Menu open sound (short beep)
        audio.src = 'data:audio/wav;base64,';
        break;
      case 'close':
        // Menu close sound (short lower beep)
        audio.src = 'data:audio/wav;base64,';
        break;
      case 'select':
        // Menu select sound (short higher beep)
        audio.src = 'data:audio/wav;base64,';
        break;
    }
    
    // Play the sound
    audio.volume = 0.3; // Lower volume
    audio.play().catch(e => {/* Silently handle audio play failures */});
  }
  
  // Setup click handlers for menu items
  document.addEventListener('DOMContentLoaded', function() {
    // Setup exit button
    const exitButton = document.querySelector('.ff7-action-exit');
    if (exitButton) {
      exitButton.setAttribute('onclick', 'return exitRPGMode()');
    }
    
    // Add click sound to all menu items
    const menuItems = document.querySelectorAll('.ff7-nav-link:not(.ff7-action-exit)');
    menuItems.forEach(function(item) {
      item.addEventListener('click', function() {
        playFF7MenuSound('select');
      });
    });
    
    // Close menu when clicking outside
    document.addEventListener('click', function(event) {
      const menu = document.getElementById('ff7-nav');
      const menuButton = document.getElementById('ff7-menu-button');
      
      if (menu && !menu.classList.contains('hidden') && 
          !menu.contains(event.target) && 
          !menuButton.contains(event.target)) {
        menu.classList.add('hidden');
        playFF7MenuSound('close');
      }
    });
  });
</script>

<!-- Styles moved to ff7-menu.css -->
