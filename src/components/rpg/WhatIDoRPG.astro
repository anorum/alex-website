---
import { creed } from '../../data/creed';

const creedIcons = ['🧰', '🚦', '🔐', '📦', '📚'];
---

<div class="ff7-menu">
  <div class="ff7-menu-header">COMMAND MENU</div>
  
  <div class="ff7-abilities-content">
    <!-- Character Class Description -->
    <div class="ff7-class-description">
      <p class="ff7-text">
        As a <span class="ff7-highlight">DATA PLATFORM ENGINEER</span>, I specialize in building modern data infrastructure, focusing on reliable, secure, and self-service systems powered by Snowflake, Airflow on Kubernetes, and Terraform.
      </p>
      
      <p class="ff7-text">
        Works at the intersection of <span class="ff7-highlight">CLOUD INFRASTRUCTURE</span> and <span class="ff7-highlight">DATA ENGINEERING</span> - platforms and pipelines that teams run themselves.
      </p>
    </div>
    
    <!-- Ability Categories -->
    <div class="ff7-ability-categories">
      <!-- Magic Command - Infrastructure Engineering -->
      <div class="ff7-ability-category magic">
        <div class="ff7-ability-header">
          <div class="ff7-ability-icon magic">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
            </svg>
          </div>
          <div class="ff7-ability-title">INFRASTRUCTURE ENGINEERING</div>
          <div class="ff7-ability-level">LV.5</div>
        </div>
        
        <div class="ff7-ability-description">
          I architect cloud-native data platforms using Terraform, Kubernetes, and AWS. Rebuilt LegalZoom's data platform from the ground up as an engineer and people leader.
        </div>
        
        <div class="ff7-ability-stats">
          <div class="ff7-ability-stat">
            <span class="ff7-stat-name">MP COST</span>
            <span class="ff7-stat-value">45</span>
          </div>
          <div class="ff7-ability-stat">
            <span class="ff7-stat-name">EFFECT</span>
            <span class="ff7-stat-value">PLATFORM STABILITY +85%</span>
          </div>
        </div>
        
        <div class="ff7-ability-mastery">
          <div class="ff7-mastery-label">MASTERY</div>
          <div class="ff7-mastery-bar">
            <div class="ff7-mastery-fill" style="width: 90%;"></div>
          </div>
          <div class="ff7-mastery-value">90%</div>
          <div class="ff7-ap">AP: 9000/10000</div>
        </div>
      </div>
      
      <!-- Summon Command - Pipeline Orchestration -->
      <div class="ff7-ability-category summon">
        <div class="ff7-ability-header">
          <div class="ff7-ability-icon summon">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
          </div>
          <div class="ff7-ability-title">PIPELINE ORCHESTRATION</div>
          <div class="ff7-ability-level">LV.4</div>
        </div>
        
        <div class="ff7-ability-description">
          I design and implement data workflows using Airflow on Kubernetes, optimizing ETL processes that reduced runtime from hours to minutes.
        </div>
        
        <div class="ff7-ability-stats">
          <div class="ff7-ability-stat">
            <span class="ff7-stat-name">MP COST</span>
            <span class="ff7-stat-value">60</span>
          </div>
          <div class="ff7-ability-stat">
            <span class="ff7-stat-name">EFFECT</span>
            <span class="ff7-stat-value">PROCESSING SPEED +75%</span>
          </div>
        </div>
        
        <div class="ff7-ability-mastery">
          <div class="ff7-mastery-label">MASTERY</div>
          <div class="ff7-mastery-bar">
            <div class="ff7-mastery-fill" style="width: 75%;"></div>
          </div>
          <div class="ff7-mastery-value">75%</div>
          <div class="ff7-ap">AP: 7500/10000</div>
        </div>
      </div>
      
      <!-- Command - Data Governance -->
      <div class="ff7-ability-category command">
        <div class="ff7-ability-header">
          <div class="ff7-ability-icon command">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
            </svg>
          </div>
          <div class="ff7-ability-title">DATA GOVERNANCE</div>
          <div class="ff7-ability-level">LV.4</div>
        </div>
        
        <div class="ff7-ability-description">
          I implement secure access models, automated data masking, and compliance frameworks. Lead a team focused on platform reliability and self-service capabilities.
        </div>
        
        <div class="ff7-ability-stats">
          <div class="ff7-ability-stat">
            <span class="ff7-stat-name">MP COST</span>
            <span class="ff7-stat-value">70</span>
          </div>
          <div class="ff7-ability-stat">
            <span class="ff7-stat-name">EFFECT</span>
            <span class="ff7-stat-value">DATA SECURITY +80%</span>
          </div>
        </div>
        
        <div class="ff7-ability-mastery">
          <div class="ff7-mastery-label">MASTERY</div>
          <div class="ff7-mastery-bar">
            <div class="ff7-mastery-fill" style="width: 80%;"></div>
          </div>
          <div class="ff7-mastery-value">80%</div>
          <div class="ff7-ap">AP: 8000/10000</div>
        </div>
      </div>
    </div>
    
    <!-- Engineering Principles Section -->
    <div class="ff7-creed-section">
      <div class="ff7-section-title">ENGINEERING PRINCIPLES</div>
      
      <ul class="ff7-creed-list">
        {creed.map((line, i) => (
          <li class="ff7-creed-item">
            <span class="ff7-creed-icon">{creedIcons[i % creedIcons.length]}</span>
            <span class="ff7-creed-text">{line}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</div>

<style>
  /* FF7 Menu Styling */
  .ff7-menu {
    background-color: var(--ff7-menu-bg);
    border: var(--menu-border);
    padding: var(--menu-padding);
    margin: 0 auto;
    max-width: 600px;
    font-family: var(--font-body);
    color: var(--ff7-text);
    font-size: 12px;
  }
  
  .ff7-menu-header {
    background-color: var(--ff7-blue);
    border-bottom: var(--menu-border);
    padding: 0.25rem 0.5rem;
    margin: -0.5rem -0.5rem 0.5rem -0.5rem;
    text-transform: uppercase;
    font-weight: bold;
    text-align: center;
  }
  
  .ff7-abilities-content {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  
  /* Class Description */
  .ff7-class-description {
    border-bottom: 1px solid rgba(192, 192, 192, 0.3);
    padding-bottom: 0.5rem;
    margin-bottom: 0.5rem;
  }
  
  .ff7-text {
    color: var(--ff7-text);
    line-height: 1.4;
    margin-bottom: 0.5rem;
  }
  
  .ff7-highlight {
    color: var(--ff7-text-highlight);
    font-weight: bold;
  }
  
  /* Ability Categories */
  .ff7-ability-categories {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  
  .ff7-ability-category {
    border: 1px solid rgba(192, 192, 192, 0.3);
    padding: 0.5rem;
    background-color: rgba(0, 0, 0, 0.2);
  }
  
  .ff7-ability-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
    border-bottom: 1px solid rgba(192, 192, 192, 0.3);
    padding-bottom: 0.25rem;
  }
  
  .ff7-ability-icon {
    width: 24px;
    height: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
  }
  
  /* FF7 Command Type Styling */
  .ff7-ability-category.magic {
    border-left: 3px solid #00ffff;
  }
  
  .ff7-ability-category.summon {
    border-left: 3px solid #ff6666;
  }
  
  .ff7-ability-category.command {
    border-left: 3px solid #ffff00;
  }
  
  .ff7-ability-icon.magic {
    background-color: rgba(0, 255, 255, 0.2);
    color: #00ffff;
  }
  
  .ff7-ability-icon.summon {
    background-color: rgba(255, 102, 102, 0.2);
    color: #ff6666;
  }
  
  .ff7-ability-icon.command {
    background-color: rgba(255, 255, 0, 0.2);
    color: #ffff00;
  }
  
  .ff7-ability-title {
    flex: 1;
    color: var(--ff7-text-highlight);
    font-weight: bold;
  }
  
  .ff7-ability-level {
    color: var(--ff7-text);
  }
  
  .ff7-ability-description {
    color: var(--ff7-text);
    margin-bottom: 0.5rem;
    line-height: 1.4;
  }
  
  .ff7-ability-stats {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    margin-bottom: 0.5rem;
  }
  
  .ff7-ability-stat {
    display: flex;
    justify-content: space-between;
  }
  
  .ff7-stat-name {
    color: var(--ff7-text);
  }
  
  .ff7-stat-value {
    color: var(--ff7-text-highlight);
  }
  
  .ff7-ability-mastery {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  
  .ff7-mastery-label {
    color: var(--ff7-text);
    width: 70px;
  }
  
  .ff7-mastery-bar {
    flex: 1;
    height: var(--stat-bar-height);
    background-color: var(--stat-bar-bg);
    border: var(--stat-bar-border);
  }
  
  .ff7-mastery-fill {
    height: 100%;
    background-color: var(--mp-color);
  }
  
  .ff7-mastery-value {
    color: var(--ff7-text);
    width: 40px;
    text-align: right;
  }
  
  .ff7-ap {
    color: var(--ff7-text-highlight);
    font-size: 0.8em;
    margin-top: 0.25rem;
    width: 100%;
    text-align: right;
  }
  
  /* Enchanter's Creed */
  .ff7-creed-section {
    border-top: 1px solid rgba(192, 192, 192, 0.3);
    padding-top: 0.5rem;
    margin-top: 0.5rem;
  }
  
  .ff7-section-title {
    color: var(--ff7-text);
    font-weight: bold;
    margin-bottom: 0.5rem;
  }
  
  .ff7-creed-list {
    list-style-type: none;
    padding: 0;
  }
  
  .ff7-creed-item {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid rgba(192, 192, 192, 0.1);
  }
  
  .ff7-creed-icon {
    flex-shrink: 0;
  }
  
  .ff7-creed-text {
    color: var(--ff7-text);
    line-height: 1.4;
    font-size: 0.9em;
  }
  
  /* Responsive adjustments */
  @media (max-width: 640px) {
    .ff7-menu {
      max-width: 100%;
    }
    
    .ff7-ability-header {
      flex-wrap: wrap;
    }
    
    .ff7-ability-mastery {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.25rem;
    }
    
    .ff7-mastery-bar {
      width: 100%;
    }
  }
</style>
