<style>
  /* FF7 Menu Styling */
  .ff7-menu {
    background-color: var(--ff7-menu-bg);
    border: var(--menu-border);
    padding: var(--menu-padding);
    margin: 0 auto;
    max-width: 600px;
    font-family: var(--font-body);
    color: var(--ff7-text);
    font-size: 12px;
  }
  
  .ff7-menu-header {
    background-color: var(--ff7-blue);
    border-bottom: var(--menu-border);
    padding: 0.25rem 0.5rem;
    margin: -0.5rem -0.5rem 0.5rem -0.5rem;
    text-transform: uppercase;
    font-weight: bold;
    text-align: center;
  }
  
  /* Quest List */
  .ff7-quest-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  
  /* Quest Item */
  .ff7-quest {
    border: 1px solid rgba(192, 192, 192, 0.3);
    margin-bottom: 0.5rem;
  }
  
  .ff7-quest-header {
    background-color: rgba(0, 0, 0, 0.3);
    padding: 0.25rem 0.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid rgba(192, 192, 192, 0.3);
  }
  
  .ff7-quest-title {
    color: var(--ff7-text-highlight);
    font-weight: bold;
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }
  
  .ff7-cursor {
    color: var(--cursor-color);
    animation: ff7-cursor-blink 1s infinite;
  }
  
  @keyframes ff7-cursor-blink {
    0%, 50% { opacity: 1; }
    51%, 100% { opacity: 0; }
  }
  
  .ff7-quest-location {
    color: var(--ff7-text);
    font-size: 0.9em;
  }
  
  /* Quest Details */
  .ff7-quest-details {
    padding: 0.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  
  .ff7-quest-status,
  .ff7-quest-period {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  
  .ff7-quest-status-label,
  .ff7-quest-period-label {
    color: var(--ff7-text);
    font-size: 0.9em;
  }
  
  .ff7-quest-status-value {
    font-weight: bold;
  }
  
  .ff7-quest-status-value.active {
    color: var(--ff7-text-highlight);
  }
  
  .ff7-quest-status-value.completed {
    color: var(--hp-color);
  }
  
  .ff7-quest-period-value {
    color: var(--ff7-text);
  }
  
  .ff7-quest-description {
    color: var(--ff7-text);
    margin: 0.5rem 0;
    line-height: 1.4;
    border-top: 1px solid rgba(192, 192, 192, 0.3);
    border-bottom: 1px solid rgba(192, 192, 192, 0.3);
    padding: 0.5rem 0;
  }
  
  /* Quest Objectives */
  .ff7-quest-objectives {
    margin-top: 0.25rem;
  }
  
  .ff7-quest-objectives-title {
    color: var(--ff7-text);
    font-weight: bold;
    margin-bottom: 0.25rem;
  }
  
  .ff7-quest-objectives-list {
    list-style-type: none;
    padding-left: 0.5rem;
  }
  
  .ff7-quest-objective {
    color: var(--ff7-text);
    margin-bottom: 0.25rem;
    position: relative;
    padding-left: 1rem;
  }
  
  .ff7-quest-objective::before {
    content: "○";
    position: absolute;
    left: 0;
    color: var(--ff7-text);
  }
  
  .ff7-quest-objective.completed {
    color: var(--hp-color);
  }
  
  .ff7-quest-objective.completed::before {
    content: "●";
    color: var(--hp-color);
  }
  
  /* Quest Rewards */
  .ff7-quest-rewards {
    margin-top: 0.25rem;
    border-top: 1px solid rgba(192, 192, 192, 0.3);
    padding-top: 0.5rem;
  }
  
  .ff7-quest-rewards-title {
    color: var(--ff7-text);
    font-weight: bold;
    margin-bottom: 0.25rem;
  }
  
  .ff7-quest-reward {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.25rem;
  }
  
  .ff7-quest-reward-icon {
    font-size: 0.9em;
  }
  
  .ff7-quest-reward-name {
    color: var(--ff7-text-highlight);
  }
  
  /* Responsive adjustments */
  @media (max-width: 640px) {
    .ff7-menu {
      max-width: 100%;
    }
    
    .ff7-quest-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.25rem;
    }
  }
</style>
