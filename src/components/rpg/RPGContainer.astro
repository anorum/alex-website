---
import OverworldIsland from './overworld/OverworldIsland';
import BattleIsland from './battle/BattleIsland';
---

<div class="rpg-container">
  <div id="rpg-window-backdrop" class="rpg-window-backdrop" style="display: none;" onclick="switchRPGSection('overworld')"></div>
  <button id="rpg-back-world" class="rpg-back-world" style="display: none;" onclick="switchRPGSection('overworld')">
    ◀ BACK TO WORLD <span class="rpg-back-esc">ESC</span>
  </button>

  <div id="rpg-overworld" class="rpg-section active">
    <div class="ff7-menu">
      <div class="ff7-menu-header">WORLD</div>
      <div class="ff7-menu-content">
        <OverworldIsland client:visible />
      </div>
    </div>
  </div>

  <div id="rpg-battle" class="rpg-section">
    <div class="ff7-menu">
      <div class="ff7-menu-header">BATTLE</div>
      <div class="ff7-menu-content">
        <BattleIsland client:visible />
      </div>
    </div>
  </div>

</div>

<!-- switchRPGSection is defined HERE, co-located with the DOM it manages -->
<script is:inline>
  window.switchRPGSection = function(sectionId) {
    sessionStorage.setItem('rpg-active-section', sectionId);

    var sections = document.querySelectorAll('.rpg-section');
    sections.forEach(function(s) { s.classList.remove('active'); });

    var target = document.getElementById('rpg-' + sectionId);
    if (target) target.classList.add('active');

    document.dispatchEvent(new CustomEvent('rpg:section-change', { detail: { section: sectionId } }));

    var menu = document.getElementById('ff7-nav');
    if (menu) menu.classList.add('hidden');

    // Locations open as windows over the world; backdrop and back bar show together
    var inWindow = sectionId !== 'overworld';
    var back = document.getElementById('rpg-back-world');
    if (back) back.style.display = inWindow ? '' : 'none';
    var backdrop = document.getElementById('rpg-window-backdrop');
    if (backdrop) backdrop.style.display = inWindow ? '' : 'none';

  };

  // Quick travel into a scene: back to the overworld section, then teleport
  window.gotoRPGScene = function(scene) {
    window.switchRPGSection('overworld');
    document.dispatchEvent(new CustomEvent('rpg:goto', { detail: { scene: scene } }));
  };

  // Restore last active section on load. Sections replaced by interiors
  // migrate to their scene so old sessions land inside the right room.
  document.addEventListener('DOMContentLoaded', function() {
    var sceneMap = { status: 'house', quests: 'hall', abilities: 'tower', skills: 'dojo', projects: 'shop', crafts: 'camp', map: 'harbor' };
    var saved = sessionStorage.getItem('rpg-active-section');
    if (saved && sceneMap[saved]) {
      try {
        sessionStorage.setItem('rpg-ow', JSON.stringify({ scene: sceneMap[saved] }));
      } catch (e) { /* ignore */ }
      sessionStorage.setItem('rpg-active-section', 'overworld');
      saved = 'overworld';
    }
    if (saved && document.getElementById('rpg-' + saved)) window.switchRPGSection(saved);
  });

  // Escape from any location back to the overworld.
  // Skipped while the FF7 menu is open (it owns Escape) and during battle (it uses Escape to cancel menus).
  document.addEventListener('keydown', function(e) {
    if (e.key !== 'Escape' || e.metaKey || e.ctrlKey || e.altKey) return;
    if (!document.documentElement.classList.contains('theme-rpg')) return;
    var nav = document.getElementById('ff7-nav');
    if (nav && !nav.classList.contains('hidden')) return;
    var active = document.querySelector('.rpg-section.active');
    if (!active || active.id === 'rpg-overworld' || active.id === 'rpg-battle') return;
    window.switchRPGSection('overworld');
  });
</script>

<style>
  .rpg-container {
    width: 100%;
    max-width: 1400px;
    margin: 0 auto;
    padding: 1rem;
  }

  .rpg-back-world {
    position: fixed;
    z-index: 510;
    top: 0.75rem;
    left: 50%;
    transform: translateX(-50%);
    border: 1px solid var(--ff7-border);
    background-color: var(--ff7-blue-dark);
    color: var(--ff7-text-highlight);
    font-family: var(--font-body);
    font-size: 11px;
    padding: 0.5rem 0.875rem;
    cursor: pointer;
    white-space: nowrap;
  }

  .rpg-back-world:hover {
    background-color: var(--ff7-blue);
  }

  .rpg-back-esc {
    color: var(--ff7-text);
    border: 1px solid var(--ff7-border);
    padding: 0.0625rem 0.375rem;
    margin-left: 0.5rem;
    font-size: 9px;
  }

  .rpg-section {
    display: none;
  }

  /* The overworld is the persistent stage: always visible in RPG mode */
  #rpg-overworld.rpg-section {
    display: block;
  }

  /* Every other section opens as a window floating over the world */
  .rpg-section.active {
    display: block;
  }

  .rpg-section.active:not(#rpg-overworld) {
    position: fixed;
    z-index: 500;
    top: 3.75rem;
    left: 50%;
    transform: translateX(-50%);
    width: min(1200px, calc(100vw - 1.5rem));
    max-height: calc(100vh - 5rem);
    max-height: calc(100dvh - 5rem);
    overflow-y: auto;
    animation: rpgWindowIn 0.22s var(--ease-out);
  }

  .rpg-window-backdrop {
    position: fixed;
    inset: 0;
    z-index: 490;
    background-color: rgba(2, 2, 30, 0.55);
    cursor: pointer;
  }

  @keyframes rpgWindowIn {
    from {
      opacity: 0;
      transform: translateX(-50%) scale(0.97);
    }
    to {
      opacity: 1;
      transform: translateX(-50%) scale(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .rpg-section.active:not(#rpg-overworld) {
      animation: none;
    }
  }

  .ff7-menu {
    background-color: var(--ff7-menu-bg);
    border: var(--menu-border);
    padding: var(--menu-padding);
    margin: 0 auto;
    max-width: 1200px;
    font-family: var(--font-body);
    color: var(--ff7-text);
    font-size: 12px;
  }

  .ff7-menu-header {
    background-color: var(--ff7-blue);
    border-bottom: var(--menu-border);
    padding: 0.25rem 0.5rem;
    margin: -0.5rem -0.5rem 0.5rem -0.5rem;
    text-transform: uppercase;
    font-weight: bold;
    text-align: center;
  }

  .ff7-menu-content {
    padding: 1rem;
  }

  .ff7-text {
    color: var(--ff7-text);
    line-height: 1.4;
  }
</style>
