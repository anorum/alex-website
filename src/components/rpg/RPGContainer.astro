---
import HeroRPG from './HeroRPG.astro';
import SkillsRPG from './SkillsRPG.astro';
import WhatIDoRPG from './WhatIDoRPG.astro';
import TimelineRPG from './TimelineRPG.astro';
import InterestItemRPG from './InterestItemRPG.astro';
import IndexTravelMap from '../travel/IndexTravelMap';
import TimelineWrapper from '../TimelineWrapper.astro';
---

<div class="rpg-container">
  <!-- RPG components will be shown/hidden based on the active section -->
  <div id="rpg-status" class="rpg-section active">
    <HeroRPG />
  </div>
  
  <div id="rpg-abilities" class="rpg-section">
    <WhatIDoRPG />
  </div>
  
  <div id="rpg-skills" class="rpg-section">
    <SkillsRPG />
  </div>
  
  <div id="rpg-quests" class="rpg-section">
    <div class="ff7-menu">
      <div class="ff7-menu-header">QUESTS</div>
      <div class="ff7-menu-content">
        <div class="ff7-text">
          <h3 class="text-center mb-4">Quest Log</h3>
          <TimelineWrapper />
        </div>
      </div>
    </div>
  </div>
  
  <div id="rpg-crafts" class="rpg-section">
    <div class="ff7-menu">
      <div class="ff7-menu-header">CRAFTS</div>
      <div class="ff7-menu-content">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <InterestItemRPG
            title="Running & Fitness"
            description="Running mostly to clear my head. Sometimes to train. Always tracking something."
            icon='<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" /></svg>'
            colorScheme="green"
          >
            <div class="mt-3 text-sm">
              <a href="/stats" class="text-green-700 dark:text-green-400 hover:underline inline-flex items-center gap-1">
                <span>View my running stats</span>
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </a>
            </div>
          </InterestItemRPG>
          
          <InterestItemRPG
            title="Golf"
            description="Trying to get better, tracking my misses, and regretting most 3-woods."
            icon='<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" /></svg>'
            colorScheme="blue"
          >
            <div class="mt-3 text-sm">
              <a href="/stats" class="text-blue-700 dark:text-blue-400 hover:underline inline-flex items-center gap-1">
                <span>View my golf stats</span>
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </a>
            </div>
          </InterestItemRPG>
          
          <InterestItemRPG
            title="Reading"
            description="I read a mix of sci-fi, philosophy, and whatever's on my nightstand too long."
            icon='<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" /></svg>'
            colorScheme="purple"
          >
            <div class="mt-3 text-sm">
              <a href="/stats" class="text-purple-700 dark:text-purple-400 hover:underline inline-flex items-center gap-1">
                <span>See what I'm reading</span>
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </a>
            </div>
          </InterestItemRPG>
          
          <InterestItemRPG
            title="Traveling"
            description="One of my favorite quotes 'Travel is not a reward for working it's education for living.'"
            icon='<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>'
            colorScheme="yellow"
          />
        </div>
      </div>
    </div>
  </div>
  
  <div id="rpg-map" class="rpg-section">
    <div class="ff7-menu">
      <div class="ff7-menu-header">MAP</div>
      <div class="ff7-menu-content">
        <div class="ff7-text">
          <h3 class="text-center mb-4">Places I've Been</h3>
          <div id="travel-map-container" class="h-[400px] w-full relative">
            <IndexTravelMap client:only="react" />
          </div>
        </div>
      </div>
    </div>
  </div>
  
  <!-- We don't need the journal section anymore since it's a direct link to /notes -->
  
  <!-- We don't need the parameters section anymore since it's a direct link to /stats -->
  
  <!-- We don't need the linkshell section anymore since it's a direct link to /contact -->
  
  <!-- We don't need the mara section anymore since it opens the Chainlit chatbot -->
</div>

<script is:inline>
  // Store the current active section
  let currentActiveSection = 'status';
  
  // Global function to switch between RPG sections
  function switchRPGSection(sectionId) {
    
    // Store the current section
    currentActiveSection = sectionId;
    
    // Save to session storage to persist across page refreshes
    sessionStorage.setItem('rpg-active-section', sectionId);
    
    // Hide all sections
    const sections = document.querySelectorAll('.rpg-section');
    sections.forEach(section => {
      section.classList.remove('active');
    });
    
    // Show the selected section
    const selectedSection = document.getElementById(`rpg-${sectionId}`);
    if (selectedSection) {
      selectedSection.classList.add('active');
      
      // Play section change sound
      if (typeof playFF7MenuSound === 'function') {
        playFF7MenuSound('select');
      }
      
      // Close the menu
      const menu = document.getElementById('ff7-nav');
      if (menu) {
        menu.classList.add('hidden');
      }
      
      return false; // Prevent default link behavior
    }
    
    return false; // Prevent default link behavior
  }
  
  // Initialize the RPG container
  function initRPGContainer() {
    
    // Get the active section from session storage or use default
    const savedSection = sessionStorage.getItem('rpg-active-section') || 'status';
    switchRPGSection(savedSection);
    
    // Add event listeners to section links
    document.querySelectorAll('[data-section]').forEach(link => {
      link.addEventListener('click', function(e) {
        e.preventDefault();
        const section = this.getAttribute('data-section');
        switchRPGSection(section);
        return false;
      });
    });
  }
  
  // Run on initial load
  document.addEventListener('DOMContentLoaded', initRPGContainer);
  
  // Run on view transitions (page navigation)
  document.addEventListener('astro:page-load', initRPGContainer);
  
  // Run immediately if document is already loaded
  if (document.readyState === 'complete' || document.readyState === 'interactive') {
    setTimeout(initRPGContainer, 1);
  }
</script>

<style>
  .rpg-container {
    width: 100%;
    max-width: 1400px;
    margin: 0 auto;
    padding: 1rem;
  }
  
  .rpg-section {
    display: none;
    animation: fadeIn 0.3s ease-in-out;
  }
  
  .rpg-section.active {
    display: block;
  }
  
  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  
  .ff7-menu {
    background-color: var(--ff7-menu-bg);
    border: var(--menu-border);
    padding: var(--menu-padding);
    margin: 0 auto;
    max-width: 1200px;
    font-family: var(--font-body);
    color: var(--ff7-text);
    font-size: 12px;
  }
  
  .ff7-menu-header {
    background-color: var(--ff7-blue);
    border-bottom: var(--menu-border);
    padding: 0.25rem 0.5rem;
    margin: -0.5rem -0.5rem 0.5rem -0.5rem;
    text-transform: uppercase;
    font-weight: bold;
    text-align: center;
  }
  
  .ff7-menu-content {
    padding: 1rem;
  }
  
  .ff7-text {
    color: var(--ff7-text);
    line-height: 1.4;
  }
</style>
