---
import OverworldIsland from './overworld/OverworldIsland';
---

<div class="rpg-container">
  <div id="rpg-overworld" class="active">
    <div class="ff7-menu">
      <div class="ff7-menu-header">WORLD</div>
      <div class="ff7-menu-content">
        <OverworldIsland client:visible />
      </div>
    </div>
  </div>
</div>

<!-- The RPG is one continuous scene island; the FF7 menu talks to it through document events -->
<script is:inline>
  // Quick travel into a scene
  window.gotoRPGScene = function(scene) {
    document.dispatchEvent(new CustomEvent('rpg:goto', { detail: { scene: scene } }));
    var menu = document.getElementById('ff7-nav');
    if (menu) menu.classList.add('hidden');
  };

  // Toggles that live in the save (encounters, sound)
  window.rpgCommand = function(command) {
    document.dispatchEvent(new CustomEvent('rpg:command', { detail: { command: command } }));
    var menu = document.getElementById('ff7-nav');
    if (menu) menu.classList.add('hidden');
  };

  // Sessions from before the interiors saved a section id; map it to a scene once.
  document.addEventListener('DOMContentLoaded', function() {
    var sceneMap = { status: 'house', quests: 'hall', abilities: 'tower', skills: 'dojo', projects: 'shop', crafts: 'camp', map: 'harbor', battle: 'arena' };
    var saved = sessionStorage.getItem('rpg-active-section');
    if (!saved) return;
    sessionStorage.removeItem('rpg-active-section');
    if (sceneMap[saved]) {
      try {
        sessionStorage.setItem('rpg-ow', JSON.stringify({ scene: sceneMap[saved] }));
      } catch (e) { /* ignore */ }
    }
  });
</script>

<style>
  .rpg-container {
    width: 100%;
    max-width: 1400px;
    margin: 0 auto;
    padding: 1rem;
  }

  .ff7-menu {
    background-color: var(--ff7-menu-bg);
    border: var(--menu-border);
    padding: var(--menu-padding);
    margin: 0 auto;
    max-width: 1200px;
    font-family: var(--font-body);
    color: var(--ff7-text);
    font-size: 12px;
  }

  .ff7-menu-header {
    background-color: var(--ff7-blue);
    border-bottom: var(--menu-border);
    padding: 0.25rem 0.5rem;
    margin: -0.5rem -0.5rem 0.5rem -0.5rem;
    text-transform: uppercase;
    font-weight: bold;
    text-align: center;
  }

  .ff7-menu-content {
    padding: 1rem;
  }
</style>
