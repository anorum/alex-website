---
import meImage from '../../assets/me.jpeg';
---

<div class="rpg-hero relative z-10">
  <div class="max-w-4xl mx-auto px-4 flex flex-col-reverse lg:flex-row items-center gap-12">
    <!-- Text Content -->
    <div class="lg:w-3/5 space-y-6">
      <div class="space-y-2">
        <span class="inline-block text-sm font-semibold px-3 py-1 rounded-full bg-secondary-color dark:bg-secondary-color/80 text-sm dark:text-white">Hail, Traveler! 🏆</span>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight leading-tight">
          I am <span class="relative inline-block">
            <span class="relative z-10">Alex Norum</span>
            <span class="absolute bottom-2 left-0 w-full h-3 bg-accent-color opacity-30"></span>
          </span>
        </h1>
        <div class="rpg-title-decoration mx-auto w-32 h-2 mt-2"></div>
      </div>
      
      <p class="text-lg sm:text-xl text-muted max-w-xl leading-relaxed rpg-text">
        Master Architect of Digital Realms, I forge platforms and enchanted tools that empower data wizards to complete their quests without unnecessary trials. I craft systems that are elegant in their simplicity, steadfast in their reliability, and perhaps even imbued with a touch of magic.
      </p>
      
      <div class="flex flex-col sm:flex-row gap-4 sm:items-center">
        <p class="text-base text-muted rpg-text">
          Residing in the Portland Highlands. Currently serving the LegalZoom Guild. Former sage of New Relic and Oracle realms.
        </p>
        <span class="hidden sm:block h-1 w-1 bg-accent-color rounded-full"></span>
        <p class="text-base text-muted italic rpg-text">Forever seeking knowledge, forever evolving.</p>
      </div>
      
      <div class="pt-4 flex flex-wrap gap-3">
        <a href="#contact" class="rpg-button inline-flex items-center gap-2 px-4 py-2 rounded-md bg-accent-color dark:bg-accent-color/90 text-md dark:text-white hover:bg-opacity-90 dark:hover:bg-opacity-100 transition-all">
          <span>Send a Raven</span>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
        </a>
      </div>
    </div>
    
    <!-- Profile Image -->
    <div class="lg:w-2/5 flex justify-center">
      <div class="relative">
        <!-- Decorative elements around image -->
        <div class="absolute -top-4 -right-4 w-24 h-24 border-2 border-secondary-color rounded-full rpg-decoration"></div>
        <div class="absolute -bottom-4 -left-4 w-16 h-16 border-2 border-accent-color rounded-full rpg-decoration"></div>
        
        <!-- Main image with fancy border -->
        <div class="relative z-10 rounded-2xl overflow-hidden border-4 border-secondary-color dark:border-accent-color shadow-2xl transform hover:rotate-2 transition-transform duration-300 rpg-portrait">
          <img 
            src={meImage.src} 
            alt="Alex Norum" 
            class="w-64 sm:w-80 object-cover"
            loading="eager"
          />
          
          <!-- Overlay gradient -->
          <div class="absolute inset-0 bg-gradient-to-t from-black/30 to-transparent"></div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .rpg-hero {
    font-family: var(--font-body);
  }
  
  .rpg-hero h1 {
    font-family: var(--font-heading);
    text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.3);
  }
  
  .rpg-title-decoration {
    background: linear-gradient(to right, transparent, var(--accent-color), transparent);
    height: 2px;
    margin: 0.5rem auto 1.5rem;
  }
  
  .rpg-text {
    font-family: var(--font-body);
    line-height: 1.7;
  }
  
  .rpg-text::first-letter {
    font-size: 1.5em;
    font-family: var(--font-heading);
    font-weight: bold;
    color: var(--accent-color);
  }
  
  .rpg-button {
    font-family: var(--font-heading);
    border: 2px solid var(--secondary-color);
    background-color: var(--accent-color);
    color: var(--bg-color-light);
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.2);
    transition: all 0.3s ease;
  }
  
  .rpg-button:hover {
    transform: translateY(-3px);
    box-shadow: 0 6px 10px rgba(0, 0, 0, 0.3);
  }
  
  .rpg-decoration {
    border-width: 3px;
    box-shadow: 0 0 10px rgba(0, 0, 0, 0.2);
  }
  
  .rpg-portrait {
    position: relative;
    border-width: 5px;
    box-shadow: 0 0 0 2px var(--accent-color), 0 0 20px rgba(0, 0, 0, 0.4);
  }
  
  .rpg-portrait::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-image: var(--border-decoration);
    background-size: 100% 100%;
    background-repeat: no-repeat;
    pointer-events: none;
    opacity: 0.3;
    z-index: 2;
  }
</style>
