---
import meImage from '../../assets/me.jpeg';
---

<div class="ff7-menu">
  <div class="ff7-menu-header">STATUS</div>
  
  <div class="ff7-character-status">
    <!-- Character Info Section -->
    <div class="ff7-character-row">
      <div class="ff7-character-portrait">
        <img src={meImage.src} alt="Alex Norum" />
      </div>
      
      <div class="ff7-character-info">
        <div class="ff7-character-name">ALEX</div>
        <div class="ff7-character-class">DATA ARCHITECT</div>
        <div class="ff7-character-level">LV 99</div>
      </div>
    </div>
    
    <!-- Stats Section -->
    <div class="ff7-stats-section">
      <!-- HP/MP Bars -->
      <div class="ff7-stat-row">
        <div class="ff7-stat-label">HP</div>
        <div class="ff7-stat-value">9999/9999</div>
        <div class="ff7-stat-bar">
          <div class="ff7-stat-bar-fill hp" style="width: 100%;"></div>
        </div>
      </div>
      
      <div class="ff7-stat-row">
        <div class="ff7-stat-label">MP</div>
        <div class="ff7-stat-value">999/999</div>
        <div class="ff7-stat-bar">
          <div class="ff7-stat-bar-fill mp" style="width: 100%;"></div>
        </div>
      </div>
      
      <!-- Character Stats -->
      <div class="ff7-attributes">
        <div class="ff7-attribute-row">
          <div class="ff7-attribute">
            <span class="ff7-attribute-label">STR</span>
            <span class="ff7-attribute-value">95</span>
          </div>
          <div class="ff7-attribute">
            <span class="ff7-attribute-label">MAG</span>
            <span class="ff7-attribute-value">99</span>
          </div>
          <div class="ff7-attribute">
            <span class="ff7-attribute-label">DEX</span>
            <span class="ff7-attribute-value">85</span>
          </div>
        </div>
        
        <div class="ff7-attribute-row">
          <div class="ff7-attribute">
            <span class="ff7-attribute-label">VIT</span>
            <span class="ff7-attribute-value">80</span>
          </div>
          <div class="ff7-attribute">
            <span class="ff7-attribute-label">SPR</span>
            <span class="ff7-attribute-value">90</span>
          </div>
          <div class="ff7-attribute">
            <span class="ff7-attribute-label">LCK</span>
            <span class="ff7-attribute-value">70</span>
          </div>
        </div>
      </div>
      
      <!-- Experience -->
      <div class="ff7-exp-row">
        <div class="ff7-exp-label">EXP</div>
        <div class="ff7-exp-value">9999999</div>
      </div>
    </div>
    
    <!-- Equipment Section -->
    <div class="ff7-equipment-section">
      <div class="ff7-section-title">EQUIP</div>
      
      <div class="ff7-equipment-row">
        <div class="ff7-equipment-label">WEAPON</div>
        <div class="ff7-equipment-value">TERRAFORM MATERIA</div>
      </div>
      
      <div class="ff7-equipment-row">
        <div class="ff7-equipment-label">ARMOR</div>
        <div class="ff7-equipment-value">KUBERNETES CLUSTER</div>
      </div>
      
      <div class="ff7-equipment-row">
        <div class="ff7-equipment-label">ACC</div>
        <div class="ff7-equipment-value">SNOWFLAKE CRYSTAL</div>
      </div>
    </div>
    
    <!-- Limit Break -->
    <div class="ff7-limit-section">
      <div class="ff7-section-title">LIMIT</div>
      <div class="ff7-limit-name">DATA PIPELINE OPTIMIZATION</div>
    </div>
    
    <!-- Location -->
    <div class="ff7-location-section">
      <div class="ff7-location-row">
        <div class="ff7-location-label">LOCATION</div>
        <div class="ff7-location-value">PORTLAND</div>
      </div>
      
      <div class="ff7-location-row">
        <div class="ff7-location-label">GUILD</div>
        <div class="ff7-location-value">LEGALZOOM</div>
      </div>
    </div>
    
    <!-- Action Button -->
    <div class="ff7-action-section">
      <a href="contact" class="ff7-action-button">
        <span class="ff7-cursor">▶</span> SEND MESSAGE
      </a>
    </div>
  </div>
</div>

<style>
  /* FF7 Menu Styling */
  .ff7-menu {
    background-color: var(--ff7-menu-bg);
    border: var(--menu-border);
    padding: var(--menu-padding);
    margin: 0 auto;
    max-width: 600px;
    font-family: var(--font-body);
    color: var(--ff7-text);
    font-size: 12px;
  }
  
  .ff7-menu-header {
    background-color: var(--ff7-blue);
    border-bottom: var(--menu-border);
    padding: 0.25rem 0.5rem;
    margin: -0.5rem -0.5rem 0.5rem -0.5rem;
    text-transform: uppercase;
    font-weight: bold;
    text-align: center;
  }
  
  /* Character Status */
  .ff7-character-status {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  
  .ff7-character-row {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid rgba(192, 192, 192, 0.3);
  }
  
  .ff7-character-portrait {
    width: 64px;
    height: 64px;
    border: 1px solid var(--ff7-border);
    overflow: hidden;
  }
  
  .ff7-character-portrait img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  
  .ff7-character-info {
    flex: 1;
  }
  
  .ff7-character-name {
    color: var(--ff7-text-highlight);
    font-weight: bold;
    font-size: 1.2em;
  }
  
  .ff7-character-class {
    color: var(--ff7-text);
    font-size: 0.9em;
  }
  
  .ff7-character-level {
    color: var(--ff7-text-highlight);
    font-size: 0.9em;
  }
  
  /* Stats Section */
  .ff7-stats-section {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid rgba(192, 192, 192, 0.3);
  }
  
  .ff7-stat-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  
  .ff7-stat-label {
    width: 30px;
    color: var(--ff7-text);
    font-weight: bold;
  }
  
  .ff7-stat-value {
    width: 80px;
    color: var(--ff7-text);
    text-align: right;
  }
  
  .ff7-stat-bar {
    flex: 1;
    height: var(--stat-bar-height);
    background-color: var(--stat-bar-bg);
    border: var(--stat-bar-border);
  }
  
  .ff7-stat-bar-fill {
    height: 100%;
  }
  
  .ff7-stat-bar-fill.hp {
    background-color: var(--hp-color);
  }
  
  .ff7-stat-bar-fill.mp {
    background-color: var(--mp-color);
  }
  
  /* Attributes */
  .ff7-attributes {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin: 0.5rem 0;
  }
  
  .ff7-attribute-row {
    display: flex;
    justify-content: space-between;
  }
  
  .ff7-attribute {
    display: flex;
    gap: 0.5rem;
    width: 30%;
  }
  
  .ff7-attribute-label {
    color: var(--ff7-text);
  }
  
  .ff7-attribute-value {
    color: var(--ff7-text-highlight);
  }
  
  /* Experience */
  .ff7-exp-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  
  .ff7-exp-label {
    width: 30px;
    color: var(--ff7-text);
    font-weight: bold;
  }
  
  .ff7-exp-value {
    color: var(--ff7-text-highlight);
  }
  
  /* Equipment Section */
  .ff7-equipment-section {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid rgba(192, 192, 192, 0.3);
  }
  
  .ff7-section-title {
    color: var(--ff7-text);
    font-weight: bold;
    margin-bottom: 0.25rem;
  }
  
  .ff7-equipment-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  
  .ff7-equipment-label {
    width: 60px;
    color: var(--ff7-text);
  }
  
  .ff7-equipment-value {
    color: var(--ff7-text-highlight);
  }
  
  /* Limit Break */
  .ff7-limit-section {
    padding-bottom: 0.5rem;
    border-bottom: 1px solid rgba(192, 192, 192, 0.3);
  }
  
  .ff7-limit-name {
    color: var(--ff7-text-highlight);
  }
  
  /* Location */
  .ff7-location-section {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid rgba(192, 192, 192, 0.3);
  }
  
  .ff7-location-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  
  .ff7-location-label {
    width: 80px;
    color: var(--ff7-text);
  }
  
  .ff7-location-value {
    color: var(--ff7-text-highlight);
  }
  
  /* Action Button */
  .ff7-action-section {
    display: flex;
    justify-content: center;
    margin-top: 1rem;
  }
  
  .ff7-action-button {
    background-color: var(--ff7-blue);
    color: var(--ff7-text);
    border: 1px solid var(--ff7-border);
    padding: 0.5rem 1rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  
  .ff7-action-button:hover {
    background-color: var(--ff7-blue-light);
    color: var(--ff7-text-highlight);
  }
  
  .ff7-cursor {
    color: var(--cursor-color);
    animation: ff7-cursor-blink 1s infinite;
  }
  
  @keyframes ff7-cursor-blink {
    0%, 50% { opacity: 1; }
    51%, 100% { opacity: 0; }
  }
  
  /* Responsive adjustments */
  @media (max-width: 640px) {
    .ff7-menu {
      max-width: 100%;
    }
    
    .ff7-attribute-row {
      flex-direction: column;
      gap: 0.25rem;
    }
    
    .ff7-attribute {
      width: 100%;
    }
  }
</style>
