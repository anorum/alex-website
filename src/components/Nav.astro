---
---

<header class="site-nav" style="border-bottom: var(--rule); background-color: var(--bg-color);">
  <div class="max-w-6xl mx-auto px-5 sm:px-8 flex items-center justify-between gap-3 h-14">
    <a href="#top" class="monogram" aria-label="Alex Norum - back to top">AN.</a>

    <nav class="nav-links eyebrow" aria-label="Sections">
      <a href="#experience">Work</a>
      <span class="sep" aria-hidden="true">-</span>
      <a href="#stack">Skills</a>
      <span class="sep" aria-hidden="true">-</span>
      <a href="#travel">Travel</a>
    </nav>

    <div class="flex items-center gap-3 sm:gap-4">
      <button id="nav-dark-toggle" class="nav-btn" aria-label="Toggle dark mode">
        <svg id="nav-dark-icon" class="hidden w-4 h-4" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
          <path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"></path>
        </svg>
        <svg id="nav-light-icon" class="hidden w-4 h-4" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
          <path d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z" fill-rule="evenodd" clip-rule="evenodd"></path>
        </svg>
      </button>
      <button id="nav-rpg-toggle" class="nav-btn eyebrow rpg-btn" aria-label="Switch to RPG mode">
        <span aria-hidden="true">▶</span> <span class="rpg-label">RPG Mode</span><span class="rpg-label-short">RPG</span>
      </button>
    </div>
  </div>
</header>

<script is:inline>
  (function() {
    var btn = document.getElementById('nav-dark-toggle');
    var darkIcon = document.getElementById('nav-dark-icon');
    var lightIcon = document.getElementById('nav-light-icon');

    function syncIcons() {
      var isDark = document.documentElement.classList.contains('dark');
      lightIcon && lightIcon.classList.toggle('hidden', !isDark);
      darkIcon && darkIcon.classList.toggle('hidden', isDark);
    }
    syncIcons();

    btn && btn.addEventListener('click', function() {
      if (document.documentElement.classList.contains('dark')) {
        document.documentElement.classList.remove('dark');
        localStorage.setItem('color-theme', 'light');
      } else {
        document.documentElement.classList.add('dark');
        localStorage.setItem('color-theme', 'dark');
      }
      syncIcons();
    });

    var rpgBtn = document.getElementById('nav-rpg-toggle');
    rpgBtn && rpgBtn.addEventListener('click', function() {
      document.documentElement.classList.forEach(function(c) {
        if (c.startsWith('theme-')) document.documentElement.classList.remove(c);
      });
      document.documentElement.classList.add('theme-rpg');
      localStorage.setItem('site-theme', 'rpg');
      document.dispatchEvent(new CustomEvent('theme:change', { detail: { theme: 'rpg' } }));
    });
  })();
</script>

<style>
  .site-nav {
    position: sticky;
    top: 0;
    z-index: 50;
  }

  .monogram {
    font-family: var(--font-heading);
    font-weight: 900;
    font-size: 1.125rem;
    letter-spacing: -0.02em;
    color: var(--text-color);
    text-decoration: none;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    color: var(--text-secondary);
  }

  .nav-links a {
    color: inherit;
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .nav-links a:hover {
    color: var(--accent-text);
  }

  .sep {
    opacity: 0.4;
    user-select: none;
  }

  .nav-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    background: none;
    border: none;
    padding: 0.375rem 0;
    cursor: pointer;
    color: var(--text-secondary);
    transition: color var(--duration-fast) var(--ease-out);
  }

  .nav-btn:hover {
    color: var(--accent-text);
  }

  .rpg-btn span[aria-hidden] {
    font-size: 0.5rem;
  }

  .rpg-label-short {
    display: none;
  }

  @media (max-width: 540px) {
    .nav-links {
      gap: 0.5rem;
      font-size: 0.625rem;
    }
    .sep {
      display: none;
    }
    .rpg-label {
      display: none;
    }
    .rpg-label-short {
      display: inline;
    }
  }

  @media (max-width: 380px) {
    .nav-links {
      gap: 0.4375rem;
      font-size: 0.5625rem;
    }
  }
</style>
