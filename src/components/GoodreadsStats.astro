---
import { BookOpenIcon } from '@heroicons/react/24/outline';
import BookSummary from './goodreads/BookSummary';
import CurrentlyReading from './goodreads/CurrentlyReading';
import RecentlyRead from './goodreads/RecentlyRead';
import TopRatedBooks from './goodreads/TopRatedBooks';
import Authors from './goodreads/Authors';
---

<div class="relative">
  <div class="max-w-4xl mx-auto px-4">
    <div class="mb-6">
      <div class="flex items-center mb-4">
        <div class="w-10 h-10 flex items-center justify-center bg-yellow-100 dark:bg-yellow-900 rounded-full text-yellow-600 dark:text-yellow-400 me-4">
          <BookOpenIcon className="h-6 w-6" />
        </div>
        <div>
          <h2 class="text-2xl font-bold text-gray-900 dark:text-white">Reading Stats</h2>
          <p class="text-sm">Track my reading journey</p>
        </div>
      </div>
    </div>
  
  <div id="reading-stats-content">
    <!-- Initial loading state - this will be shown immediately -->
    <div id="reading-loading-indicator" class="flex flex-col items-center justify-center p-8">
      <div class="animate-spin rounded-full h-12 w-12 border-b-2 border-yellow-500 mb-4"></div>
      <p class="text-gray-500 dark:text-gray-400">Loading reading data...</p>
    </div>
    
    <!-- Error message container - initially hidden -->
    <div id="reading-error-message" class="hidden p-4 mb-6 text-sm text-red-800 rounded-lg bg-red-50 dark:bg-gray-800 dark:text-red-400 border border-red-300 dark:border-red-800">
      <div class="flex items-center">
        <svg class="flex-shrink-0 inline w-5 h-5 mr-3" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 20 20">
          <path d="M10 .5a9.5 9.5 0 1 0 9.5 9.5A9.51 9.51 0 0 0 10 .5ZM9.5 4a1.5 1.5 0 1 1 0 3 1.5 1.5 0 0 1 0-3ZM12 15H8a1 1 0 0 1 0-2h1v-3H8a1 1 0 0 1 0-2h2a1 1 0 0 1 1 1v4h1a1 1 0 0 1 0 2Z"/>
        </svg>
        <span id="reading-error-text" class="font-medium">Error loading reading stats</span>
      </div>
    </div>
    
    <!-- Content container - initially hidden -->
    <div id="reading-stats-container" class="hidden">
      <!-- Book Summary -->
      <div class="mb-8" id="book-summary">
        <BookSummary client:only="react" summary={{}} />
      </div>
      
      <!-- Currently Reading -->
      <div class="mb-8" id="currently-reading">
        <CurrentlyReading client:only="react" currentlyReading={[]} />
      </div>
      
      <!-- Recently Read -->
      <div class="mb-8" id="recently-read">
        <RecentlyRead client:only="react" recentlyRead={[]} />
      </div>
      
      <!-- Top Rated Books -->
      <div class="mb-8" id="top-rated-books">
        <TopRatedBooks client:only="react" topRatedBooks={[]} />
      </div>
    </div>
  </div>
</div>

<script is:inline>
  document.addEventListener('DOMContentLoaded', async function() {
    const loadingIndicator = document.getElementById('reading-loading-indicator');
    const errorMessage = document.getElementById('reading-error-message');
    const errorText = document.getElementById('reading-error-text');
    const statsContainer = document.getElementById('reading-stats-container');
    
    try {
      const response = await fetch('/api/alexapi/api/v1/books/data');
      
      if (!response.ok) {
        throw new Error(`API request failed: ${response.status}`);
      }
      
      const data = await response.json();
      const books = data.books || [];
      const stats = data.stats || {};
      
      // Dispatch event with data
      setTimeout(() => {
        document.dispatchEvent(new CustomEvent('books-data-ready', {
          detail: {
            books: books,
            summary: stats,
            booksPerYear: stats.books_per_year || {},
            currentlyReading: stats.currently_reading || [],
            recentlyRead: stats.recently_read || [],
            topRatedBooks: stats.top_rated_books || [],
            topAuthors: stats.top_authors || []
          },
          bubbles: true
        }));
      }, 500);
      
      // Update UI
      loadingIndicator?.classList.add('hidden');
      statsContainer?.classList.remove('hidden');
    } catch (error) {
      console.error('Error loading reading stats:', error);
      loadingIndicator?.classList.add('hidden');
      
      if (errorMessage && errorText) {
        errorText.textContent = error instanceof Error ? 
          error.message : 'Unknown error loading reading stats';
        errorMessage.classList.remove('hidden');
      }
    }
  });
</script>
