---
import { BookOpenIcon } from '@heroicons/react/24/outline';
---

<div class="stats-card p-0.5 sm:p-2 md:p-4">
  <div class="mb-6">
    <div class="flex items-center mb-4">
      <div class="w-10 h-10 flex items-center justify-center bg-yellow-100 dark:bg-yellow-900 rounded-full text-yellow-600 dark:text-yellow-400 me-4">
        <BookOpenIcon className="h-6 w-6" />
      </div>
      <div>
        <h2 class="text-2xl font-bold text-gray-900 dark:text-white">Reading Stats</h2>
        <p class="text-gray-500 dark:text-gray-400 text-sm">Track your reading journey</p>
      </div>
    </div>
  </div>
  
  <div id="reading-stats-content">
    <!-- Initial loading state - this will be shown immediately -->
    <div id="reading-loading-indicator" class="flex flex-col items-center justify-center p-8">
      <div class="animate-spin rounded-full h-12 w-12 border-b-2 border-yellow-500 mb-4"></div>
      <p class="text-gray-500 dark:text-gray-400">Loading reading data...</p>
    </div>
    
    <!-- Error message container - initially hidden -->
    <div id="reading-error-message" class="hidden p-4 mb-6 text-sm text-red-800 rounded-lg bg-red-50 dark:bg-gray-800 dark:text-red-400 border border-red-300 dark:border-red-800">
      <div class="flex items-center">
        <svg class="flex-shrink-0 inline w-5 h-5 mr-3" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 20 20">
          <path d="M10 .5a9.5 9.5 0 1 0 9.5 9.5A9.51 9.51 0 0 0 10 .5ZM9.5 4a1.5 1.5 0 1 1 0 3 1.5 1.5 0 0 1 0-3ZM12 15H8a1 1 0 0 1 0-2h1v-3H8a1 1 0 0 1 0-2h2a1 1 0 0 1 1 1v4h1a1 1 0 0 1 0 2Z"/>
        </svg>
        <span id="reading-error-text" class="font-medium">Error loading reading stats</span>
      </div>
    </div>
    
    <!-- Content container - initially hidden -->
    <div id="reading-stats-container" class="hidden">
      <div class="p-8 text-center">
        <p class="text-gray-500 dark:text-gray-400">Reading stats coming soon!</p>
      </div>
    </div>
  </div>
</div>

<script is:inline>
  // Initialize when the page loads
  document.addEventListener('astro:page-load', function() {
    // Get DOM elements
    const loadingIndicator = document.getElementById('reading-loading-indicator');
    const statsContainer = document.getElementById('reading-stats-container');
    
    // Show the content and hide the loading indicator
    if (loadingIndicator) loadingIndicator.classList.add('hidden');
    if (statsContainer) statsContainer.classList.remove('hidden');
  });
</script>
