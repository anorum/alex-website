---
interface Props {
  title: string;
  description?: string;
  icon?: string; // SVG path or icon class
  colorScheme?: 'blue' | 'green' | 'purple' | 'yellow' | 'red' | 'indigo' | 'pink' | 'gray' | string;
}

const { 
  title, 
  description, 
  icon,
  colorScheme = 'blue' 
} = Astro.props;

// Define color schemes
const colorSchemes = {
  blue: {
    bg: 'bg-blue-100',
    text: 'text-blue-800',
    darkBg: 'dark:bg-blue-900',
    darkText: 'dark:text-blue-300'
  },
  green: {
    bg: 'bg-green-100',
    text: 'text-green-800',
    darkBg: 'dark:bg-green-900',
    darkText: 'dark:text-green-300'
  },
  purple: {
    bg: 'bg-purple-100',
    text: 'text-purple-800',
    darkBg: 'dark:bg-purple-900',
    darkText: 'dark:text-purple-300'
  },
  yellow: {
    bg: 'bg-yellow-100',
    text: 'text-yellow-800',
    darkBg: 'dark:bg-yellow-900',
    darkText: 'dark:text-yellow-300'
  },
  red: {
    bg: 'bg-red-100',
    text: 'text-red-800',
    darkBg: 'dark:bg-red-900',
    darkText: 'dark:text-red-300'
  },
  indigo: {
    bg: 'bg-indigo-100',
    text: 'text-indigo-800',
    darkBg: 'dark:bg-indigo-900',
    darkText: 'dark:text-indigo-300'
  },
  pink: {
    bg: 'bg-pink-100',
    text: 'text-pink-800',
    darkBg: 'dark:bg-pink-900',
    darkText: 'dark:text-pink-300'
  },
  gray: {
    bg: 'bg-gray-100',
    text: 'text-gray-800',
    darkBg: 'dark:bg-gray-700',
    darkText: 'dark:text-gray-300'
  }
};

// Get colors from the colorScheme, defaulting to blue if not found
const colors = colorSchemes[colorScheme as keyof typeof colorSchemes] || colorSchemes.blue;

// Default icon if none provided
const defaultIcon = `<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
</svg>`;
---

<div class="flex items-start p-4 bg-gray-50 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg">
  <div class={`flex-shrink-0 ${colors.bg} rounded-full p-3 ${colors.darkBg}`}>
    {icon ? 
      <Fragment set:html={icon} /> : 
      <span class={`${colors.text} ${colors.darkText}`} set:html={defaultIcon} />
    }
  </div>
  <div class="ml-4">
    <h3 class="text-lg font-semibold text-gray-900 dark:text-white">{title}</h3>
    {description && <p class="text-base text-gray-500 dark:text-gray-400 mt-1">{description}</p>}
    <slot />
  </div>
</div>
