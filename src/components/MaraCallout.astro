---
---

<div class="fixed bottom-24 right-6 z-20 max-w-xs transform transition-transform duration-500 animate-float">
  <div class="bg-white dark:bg-gray-800 rounded-lg shadow-lg border border-blue-100 dark:border-blue-900 p-4 flex items-start">
    <div class="flex-shrink-0 mr-3">
      <div class="relative">
        <img src="/mara_logo.png" alt="Mara" class="w-12 h-12 rounded-full border-2 border-blue-500" />
        <div class="absolute -bottom-1 -right-1 bg-green-500 rounded-full w-4 h-4 border-2 border-white dark:border-gray-800"></div>
      </div>
    </div>
    <div>
      <h3 class="font-medium text-gray-900 dark:text-white">Mara is always here!</h3>
      <p class="text-sm text-gray-600 dark:text-gray-300 mt-1">
        Click the chat icon in the bottom right corner anytime to ask me questions about Alex.
      </p>
      <button id="dismiss-callout" class="text-xs text-blue-600 dark:text-blue-400 hover:underline mt-2">Got it</button>
    </div>
  </div>
</div>

<script>
  document.addEventListener('astro:page-load', () => {
    const callout = document.querySelector('.animate-float');
    const dismissButton = document.getElementById('dismiss-callout');
    
    // Check if the callout has been dismissed before
    const isCalloutDismissed = localStorage.getItem('maraCalloutDismissed');
    
    if (isCalloutDismissed === 'true' && callout) {
      callout.classList.add('hidden');
    }
    
    if (dismissButton && callout) {
      dismissButton.addEventListener('click', () => {
        // Add a fade-out animation
        callout.classList.add('opacity-0');
        
        // After animation completes, hide the element
        setTimeout(() => {
          callout.classList.add('hidden');
          // Save the dismissal in localStorage
          localStorage.setItem('maraCalloutDismissed', 'true');
        }, 300);
      });
    }
    
    // Hide the callout after 15 seconds
    if (callout) {
      setTimeout(() => {
        if (!callout.classList.contains('hidden')) {
          callout.classList.add('opacity-0');
          
          setTimeout(() => {
            callout.classList.add('hidden');
          }, 300);
        }
      }, 15000);
    }
  });
</script>

<style>
  .animate-float {
    animation: float 3s ease-in-out infinite;
  }
  
  @keyframes float {
    0% {
      transform: translateY(0px);
    }
    50% {
      transform: translateY(-10px);
    }
    100% {
      transform: translateY(0px);
    }
  }
  
  .opacity-0 {
    opacity: 0;
    transition: opacity 0.3s ease-out;
  }
</style>
