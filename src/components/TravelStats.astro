---
import { GlobeAltIcon } from '@heroicons/react/24/outline';
import TravelMap from './travel/TravelMap';
import TravelSummary from './travel/TravelSummary';
import YearlyStats from './travel/YearlyStats';
import CountriesStats from './travel/CountriesStats';
import CitiesStats from './travel/CitiesStats';
---

<div class="stats-card">
  <div class="mb-6">
    <div class="flex items-center mb-4">
      <div class="w-10 h-10 flex items-center justify-center bg-green-100 dark:bg-green-900 rounded-full text-green-600 dark:text-green-400 me-4">
        <GlobeAltIcon className="h-6 w-6" />
      </div>
      <div>
        <h2 class="text-2xl font-bold text-gray-900 dark:text-white">Travel Stats</h2>
        <p class="text-gray-500 dark:text-gray-400 text-sm">Explore your journey around the world</p>
      </div>
    </div>
  </div>
  
  <div id="travel-stats-content">
    <!-- Initial loading state - this will be shown immediately -->
    <div id="loading-indicator" class="flex flex-col items-center justify-center p-8">
      <div class="animate-spin rounded-full h-12 w-12 border-b-2 border-green-500 mb-4"></div>
      <p class="text-gray-500 dark:text-gray-400">Loading travel data...</p>
    </div>
    
    <!-- Error message container - initially hidden -->
    <div id="error-message" class="hidden p-4 mb-6 text-sm text-red-800 rounded-lg bg-red-50 dark:bg-gray-800 dark:text-red-400 border border-red-300 dark:border-red-800">
      <div class="flex items-center">
        <svg class="flex-shrink-0 inline w-5 h-5 mr-3" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 20 20">
          <path d="M10 .5a9.5 9.5 0 1 0 9.5 9.5A9.51 9.51 0 0 0 10 .5ZM9.5 4a1.5 1.5 0 1 1 0 3 1.5 1.5 0 0 1 0-3ZM12 15H8a1 1 0 0 1 0-2h1v-3H8a1 1 0 0 1 0-2h2a1 1 0 0 1 1 1v4h1a1 1 0 0 1 0 2Z"/>
        </svg>
        <span id="error-text" class="font-medium">Error loading travel stats</span>
      </div>
    </div>
    
    <!-- Content container - initially hidden -->
    <div id="stats-container" class="hidden">
      <!-- Travel Map -->
      <div class="mb-8">
        <div id="travel-map-container">
          <TravelMap client:only="react" travelData={[]} />
        </div>
      </div>
      
      <!-- Travel Summary -->
      <div class="mb-8" id="travel-summary">
        <TravelSummary client:only="react" summary={{}} />
      </div>
      
      <!-- Stats Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
        <div id="yearly-stats">
          <YearlyStats client:only="react" yearlyStats={[]} />
        </div>
        <div id="countries-stats">
          <CountriesStats client:only="react" countriesData={[]} />
        </div>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div id="cities-stats">
          <CitiesStats client:only="react" citiesData={[]} />
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Load Leaflet CSS and JS -->
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
<script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>

<!-- Custom CSS to fix Leaflet z-index issues -->
<style is:global>
  /* Fix for Leaflet map z-index issues */
  .leaflet-pane,
  .leaflet-tile,
  .leaflet-marker-icon,
  .leaflet-marker-shadow,
  .leaflet-tile-container,
  .leaflet-pane > svg,
  .leaflet-pane > canvas,
  .leaflet-zoom-box,
  .leaflet-image-layer,
  .leaflet-layer {
    z-index: 1 !important;
  }
  
  .leaflet-overlay-pane { z-index: 2 !important; }
  .leaflet-shadow-pane { z-index: 3 !important; }
  .leaflet-marker-pane { z-index: 4 !important; }
  .leaflet-tooltip-pane { z-index: 5 !important; }
  .leaflet-popup-pane { z-index: 6 !important; }
  .leaflet-control { z-index: 7 !important; }
  .leaflet-top, .leaflet-bottom { z-index: 8 !important; }
  
  /* Custom styles for travel stats */
  .stats-card {
    background-color: var(--bubble-bg);
    border-radius: var(--radius-md);
    padding: var(--spacing-md);
    border: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow: var(--card-shadow);
    transition: transform 0.3s ease;
  }
  
  .stats-card:hover {
    transform: translateY(-5px);
  }
  
  /* Override Tremor styles to match website theme */
  :root {
    --tremor-background: var(--bubble-bg) !important;
    --tremor-border: rgba(255, 255, 255, 0.1) !important;
    --tremor-ring: var(--accent-color) !important;
    --tremor-primary: var(--accent-color) !important;
    --tremor-brand: var(--secondary-color) !important;
  }
  
  /* Style popup content */
  .popup-content h3 {
    color: var(--text-dark);
    margin-bottom: 0.5rem;
  }
  
  .popup-content p {
    margin-bottom: 0.5rem;
  }
  
  /* Style map tooltips */
  .leaflet-popup-content-wrapper {
    border-radius: var(--radius-sm) !important;
    padding: 0.5rem !important;
    box-shadow: var(--card-shadow) !important;
  }
  
  .leaflet-popup-content {
    margin: 0 !important;
    line-height: 1.4 !important;
  }
  
  .leaflet-popup-tip {
    box-shadow: var(--card-shadow) !important;
  }
  
  .map-tooltip .leaflet-popup-content-wrapper {
    background-color: rgba(255, 255, 255, 0.95);
  }
  
  .dark .map-tooltip .leaflet-popup-content-wrapper {
    background-color: rgba(42, 69, 53, 0.95);
    color: var(--text-color);
  }
</style>

<script>
  // Initialize when the page loads
  document.addEventListener('astro:page-load', async function() {
    // Get DOM elements
    const loadingIndicator = document.getElementById('loading-indicator');
    const errorMessage = document.getElementById('error-message');
    const errorText = document.getElementById('error-text');
    const statsContainer = document.getElementById('stats-container');
    
    try {
      // Fetch data from the API
      const apiUrl = '/api/alexapi/travel';
      console.log('Fetching travel data from:', apiUrl);
      
      const response = await fetch(apiUrl);
      
      if (!response.ok) {
        throw new Error(`API request failed: ${response.status}`);
      }
      
      const data = await response.json();
      
      // Process the data to create a format compatible with our map
      const recentVisits = data.recent_visits || [];
      const locationMap = new Map();
      
      recentVisits.forEach((visit: any) => {
        if (!locationMap.has(visit.location_id)) {
          locationMap.set(visit.location_id, {
            id: visit.location_id,
            city: visit.city,
            country: visit.country,
            coordinates: visit.coordinates,
            visits: []
          });
        }
        
        const location = locationMap.get(visit.location_id);
        if (location) {
          location.visits.push({
            id: visit.visit_id,
            date: visit.date,
            notes: visit.notes,
            imageUrls: visit.image_urls
          });
        }
      });
      
      const travelLocations = Array.from(locationMap.values());
      
      // Create a custom event with all the data
      const travelDataEvent = new CustomEvent('travel-data-ready', {
        detail: {
          travelLocations: travelLocations,
          summary: data.summary || {},
          yearlyStats: data.yearly_stats || [],
          countriesData: data.countries_data || [],
          citiesData: data.cities_data || []
        },
        bubbles: true
      });
      
      // Dispatch the event to the document so all components can listen for it
      document.dispatchEvent(travelDataEvent);
      
      // Show the content and hide the loading indicator
      if (loadingIndicator) loadingIndicator.classList.add('hidden');
      if (statsContainer) statsContainer.classList.remove('hidden');
    } catch (error) {
      console.error('Error loading travel stats:', error);
      
      // Show error message and hide loading indicator
      if (loadingIndicator) loadingIndicator.classList.add('hidden');
      if (errorMessage) {
        if (errorText) errorText.textContent = error instanceof Error ? error.message : 'Unknown error loading travel stats';
        errorMessage.classList.remove('hidden');
      }
    }
  });
</script>
