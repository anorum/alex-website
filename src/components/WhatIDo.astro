---
import SectionHeader from './SectionHeader.astro';
import { whatIDo } from '../data/whatido';
---

<section class="py-12 sm:py-16" style="border-top: var(--rule);">
  <div class="max-w-6xl mx-auto px-5 sm:px-8">
    <SectionHeader number="01" title="What I Do" />

    <div class="card-grid mt-6 sm:mt-8 stagger-children">
      {whatIDo.map((item) => (
        <div class={`card reveal-item${item.inverted ? ' card-inverted' : ''}`}>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="card-icon"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            aria-hidden="true"
          >
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={item.iconPath} />
          </svg>
          <h3 class="card-title">{item.title}</h3>
          <p class="card-desc">{item.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  /* Collapsed 2px borders: outer border on the grid, each card draws only
     its right/bottom edge; last column/row edges suppressed per breakpoint. */
  .card-grid {
    display: grid;
    grid-template-columns: 1fr;
    border: var(--rule);
  }

  .card {
    padding: 1.5rem 1.5rem 1.75rem;
    border-bottom: var(--rule);
    color: var(--text-color);
    transition: background-color var(--duration-fast) var(--ease-out);
  }

  .card:last-child {
    border-bottom: none;
  }

  @media (min-width: 640px) {
    .card-grid {
      grid-template-columns: 1fr 1fr;
    }
    .card {
      padding: 1.75rem 1.75rem 2rem;
    }
    .card:nth-child(odd) {
      border-right: var(--rule);
    }
    .card:nth-last-child(-n + 2):nth-child(odd),
    .card:last-child {
      border-bottom: none;
    }
    /* re-apply bottom border to first row */
    .card:nth-child(-n + 2) {
      border-bottom: var(--rule);
    }
  }

  .card:not(.card-inverted):hover {
    background-color: color-mix(in srgb, var(--accent-color) 6%, transparent);
  }

  .card-inverted {
    background-color: var(--accent-color);
    color: var(--on-accent);
  }

  .card-icon {
    width: 1.5rem;
    height: 1.5rem;
    margin-bottom: 1rem;
    color: var(--accent-text);
  }

  .card-inverted .card-icon {
    color: var(--on-accent);
  }

  .card-title {
    font-family: var(--font-heading);
    font-weight: 900;
    font-size: 1.0625rem;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    line-height: 1.2;
  }

  .card-desc {
    font-family: var(--font-body);
    font-size: 0.8125rem;
    line-height: 1.6;
    margin-top: 0.5rem;
    color: var(--text-secondary);
  }

  .card-inverted .card-desc {
    color: color-mix(in srgb, var(--on-accent) 88%, var(--accent-color));
  }
</style>
