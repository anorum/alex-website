---
import { whatIDo } from '../data/whatido';
---

<section class="py-16" style="background-color: var(--bubble-bg); border-top: 1px solid var(--border-color); border-bottom: 1px solid var(--border-color);">
  <div class="max-w-5xl mx-auto px-6">
    <h2 class="text-2xl sm:text-3xl font-bold mb-4 reveal-item" style="font-family: var(--font-heading); color: var(--text-color);">What I Do</h2>

    <p class="reveal-item text-base sm:text-lg leading-relaxed mb-10" style="color: var(--text-secondary);">
      I lead <span class="font-semibold" style="color: var(--accent-color);">Data Platform Engineering</span> at LegalZoom — building reliable, self-service infrastructure with Snowflake, Airflow, and Terraform.
    </p>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
      {whatIDo.map((item, i) => (
        <div
          class="reveal-item group p-6 rounded-xl border transition-all duration-200 hover:-translate-y-1"
          style={`background-color: var(--bubble-bg); border-color: var(--border-color); box-shadow: var(--card-shadow); --reveal-delay: ${i * 100}ms;`}
        >
          <div
            class="w-11 h-11 rounded-lg flex items-center justify-center mb-4 transition-colors duration-200"
            style={`background-color: color-mix(in srgb, var(${item.accentVar}) 12%, transparent);`}
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" style={`color: var(${item.accentVar});`}>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={item.iconPath} />
            </svg>
          </div>
          <h3 class="text-lg font-semibold mb-2" style="font-family: var(--font-heading); color: var(--text-color);">{item.title}</h3>
          <p class="text-sm leading-relaxed" style="color: var(--text-secondary);">{item.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
