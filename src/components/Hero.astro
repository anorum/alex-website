---
import meImage from '../assets/me.jpeg';

const shippingYears = new Date().getFullYear() - 2013;
---

<section class="pt-16 pb-10 sm:pt-24 sm:pb-14">
  <div class="max-w-6xl mx-auto px-5 sm:px-8 stagger-children">
    <p class="eyebrow reveal-item mb-6 sm:mb-8" style="color: var(--accent-text);">
      Portland, OR - Data Platform Engineering
    </p>

    <h1 class="display-type reveal-item" style="color: var(--text-color);">
      Data platforms<br />
      <span style="color: var(--accent-color);">teams actually</span><br />
      want to use.
    </h1>

    <div class="reveal-item mt-10 sm:mt-14 flex flex-col sm:flex-row sm:items-end sm:justify-between gap-8">
      <p class="text-[15px] sm:text-base leading-relaxed max-w-md" style="color: var(--text-secondary); font-family: var(--font-body);">
        I'm Alex Norum - an engineering leader who still ships. I run the team behind
        LegalZoom's data platform and build the AI tooling on top of it.
        <span style="color: var(--text-color); font-weight: 500;">Simple systems where the right way is the easy way.</span>
      </p>

      <div class="flex items-center gap-5 sm:gap-6">
        <div class="hero-links eyebrow flex flex-col items-end gap-2" style="color: var(--text-secondary);">
          <div class="flex items-center gap-4">
            <a href="https://github.com/anorum" aria-label="GitHub">GitHub</a>
            <a href="https://www.linkedin.com/in/alex-norum/" aria-label="LinkedIn">LinkedIn</a>
          </div>
        </div>
        <img
          src={meImage.src}
          alt="Alex Norum"
          class="hero-photo"
          width="96"
          height="96"
          loading="eager"
        />
      </div>
    </div>

    <div class="hero-strip reveal-item mt-12 sm:mt-16">
      <div class="hero-stats eyebrow">
        <span class="hero-stat">Shipping since 2013</span>
        <span class="hero-stat-sep" aria-hidden="true">/</span>
        <a class="hero-stat hero-stat-link" href="#projects">{shippingYears} yrs, 5 side projects</a>
        <span class="hero-stat-sep hero-stat-wide" aria-hidden="true">/</span>
        <span class="hero-stat hero-stat-wide">45.5°N 122.7°W</span>
      </div>
      <div class="flex items-center gap-3" aria-hidden="true">
        <span class="scroll-cue eyebrow" style="color: var(--text-tertiary);">Scroll</span>
        <span class="scroll-arrow" style="color: var(--accent-color);">↓</span>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-photo {
    width: 88px;
    height: 88px;
    object-fit: cover;
    border: 2px solid var(--line-color);
    box-shadow: 6px 6px 0 0 var(--accent-color);
    flex-shrink: 0;
  }

  @media (min-width: 640px) {
    .hero-photo {
      width: 104px;
      height: 104px;
    }
  }

  .hero-links a {
    text-decoration: none;
    color: inherit;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .hero-links a:hover {
    color: var(--accent-text);
  }

  .hero-strip {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75rem 1rem;
    border-top: var(--rule);
    padding-top: 1rem;
  }

  .hero-stats {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem 0.875rem;
    color: var(--text-secondary);
    min-width: 0;
  }

  .hero-stat {
    white-space: nowrap;
  }

  .hero-stat-sep {
    color: var(--text-tertiary);
  }

  .hero-stat-link {
    color: var(--accent-text);
    text-decoration: none;
    border-bottom: 1px solid currentColor;
    padding-bottom: 0.0625rem;
  }

  @media (max-width: 700px) {
    .hero-stat-wide {
      display: none;
    }
  }

  .scroll-arrow {
    display: inline-block;
    animation: scrollBob 2s var(--ease-out) infinite;
    font-size: 0.875rem;
  }

  @keyframes scrollBob {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(5px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .scroll-arrow {
      animation: none;
    }
  }
</style>
