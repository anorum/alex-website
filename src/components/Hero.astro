---
import meImage from '../assets/me.jpeg';
---

<section class="py-16 md:py-24">
  <div class="max-w-5xl mx-auto px-6">
    <div class="flex flex-col-reverse lg:flex-row items-center gap-12 lg:gap-16">
      <!-- Text Content -->
      <div class="lg:w-3/5 space-y-6 stagger-children">
        <div class="space-y-3 reveal-item">
          <p class="text-sm font-medium tracking-widest uppercase" style="color: var(--accent-color);">Data Platform Engineering Leader</p>
          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight leading-[1.1]" style="font-family: var(--font-heading); color: var(--text-color);">
            Hey, I'm <span style="color: var(--accent-color);">Alex</span>
          </h1>
        </div>

        <p class="reveal-item text-lg sm:text-xl leading-relaxed" style="color: var(--text-secondary);">
          I build data platforms that teams actually want to use — <span class="font-medium" style="color: var(--text-color);">simple systems, clear docs, and less time in Slack.</span>
        </p>

        <div class="reveal-item flex flex-wrap items-center gap-3 pt-2">
          <span class="inline-flex items-center gap-2 px-3.5 py-2 rounded-full text-sm font-medium" style="background-color: color-mix(in srgb, var(--accent-color) 10%, transparent); color: var(--accent-color);">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
            Portland, OR
          </span>
          <span class="inline-flex items-center gap-2 px-3.5 py-2 rounded-full text-sm font-medium" style="background-color: color-mix(in srgb, var(--secondary-color) 10%, transparent); color: var(--secondary-color);">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
            LegalZoom
          </span>

          <div class="flex items-center gap-4 ml-1">
            <a href="https://github.com/anorum" class="transition-colors duration-150 hover:scale-110 transition-transform" style="color: var(--text-tertiary);" aria-label="GitHub">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd"></path></svg>
            </a>
            <a href="https://www.linkedin.com/in/alex-norum/" class="transition-colors duration-150 hover:scale-110 transition-transform" style="color: var(--text-tertiary);" aria-label="LinkedIn">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452z"></path></svg>
            </a>
          </div>
        </div>
      </div>

      <!-- Profile Image -->
      <div class="lg:w-2/5 flex justify-center reveal-item">
        <div class="relative">
          <div class="rounded-2xl overflow-hidden shadow-lg" style="box-shadow: var(--card-shadow);">
            <img
              src={meImage.src}
              alt="Alex Norum"
              class="w-56 sm:w-64 lg:w-72 object-cover"
              loading="eager"
            />
          </div>
          <!-- Subtle decorative element -->
          <div class="absolute -z-10 -bottom-3 -right-3 w-full h-full rounded-2xl" style="border: 2px solid var(--accent-color); opacity: 0.15;"></div>
        </div>
      </div>
    </div>
  </div>
</section>
