---
import ChocoboThemeToggle from '../components/ChocoboThemeToggle.astro';

import "../styles/global.css";
import "../styles/standard-theme.css";
import "../styles/rpg-theme.css";
import "../styles/ff7-cursor.css";
import "../styles/ff7-menu.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Alex Norum - Data Platform, Data Engineering, and Analytics",
  description = "Alex Norum, a Portland engineer who works on data platforms, data engineering, and analytics."
} = Astro.props;

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://alexnorum.com';
const canonical = new URL(Astro.url.pathname, siteUrl).toString();
const ogImage = `${siteUrl}/og.png`;

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Alex Norum',
  url: siteUrl,
  image: ogImage,
  jobTitle: 'Data Platform Engineer',
  knowsAbout: ['Data platforms', 'Data engineering', 'Analytics', 'Snowflake', 'Airflow', 'dbt', 'Kafka', 'Kubernetes', 'Terraform'],
  address: { '@type': 'PostalAddress', addressLocality: 'Portland', addressRegion: 'OR', addressCountry: 'US' },
  sameAs: ['https://github.com/anorum', 'https://www.linkedin.com/in/alex-norum/'],
};
---
<!doctype html>
<html lang="en" class="theme-standard">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<meta name="theme-color" content="#f4f1ea" media="(prefers-color-scheme: light)" />
		<meta name="theme-color" content="#0d1a15" media="(prefers-color-scheme: dark)" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Alex Norum" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Alex Norum - Data platforms teams actually want to use." />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />
		<script type="application/ld+json" set:html={JSON.stringify(personSchema)} />

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Archivo:wght@700;900&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&family=Press+Start+2P&display=swap"
			rel="stylesheet"
		/>

		<!-- Theme initialization (runs before paint to prevent flash) -->
		<script is:inline>
			(function() {
				var theme = localStorage.getItem('site-theme') || 'standard';
				document.documentElement.className = 'theme-' + theme;
				if (localStorage.getItem('color-theme') === 'dark' || (!localStorage.getItem('color-theme') && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
					document.documentElement.classList.add('dark');
				}
			})();
		</script>
	</head>
	<body>
		<a href="#main" class="skip-link">Skip to content</a>

		<!-- Subtle background texture -->
		<div class="fixed inset-0 z-0 pointer-events-none">
			<div class="absolute inset-0 opacity-[0.012]" style="background-image: url('data:image/svg+xml;base64,');"></div>
		</div>

		<!-- Chocobo easter egg toggle -->
		<ChocoboThemeToggle />

		<slot />

		<!-- Initialize scroll animations -->
		<script>
			import { initScrollAnimations } from '../utils/scroll-animations';

			function init() {
				initScrollAnimations({
					selector: '.reveal-item',
					animationClass: 'animate-reveal',
					threshold: 0.08,
					once: true,
				});
			}

			document.addEventListener('DOMContentLoaded', init);
		</script>
	</body>
</html>
