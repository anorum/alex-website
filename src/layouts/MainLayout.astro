---
import Layout from './Layout.astro';

interface Props {
  title?: string;
  description?: string;
}

const { title = "Alex Norum", description = "Personal website and blog" } = Astro.props;
---

<Layout title={title} description={description}>
  <main class="container mx-auto px-4 py-8">
    <slot />
  </main>
</Layout>
