---
import { ClientRouter } from "astro:transitions";

import ChainlitCopilot from '../components/ChainlitCopilot.jsx';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro'

import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "Alex Norum - Web Developer", 
  description = "Personal website and blog of Alex Norum, web developer and tech enthusiast."
} = Astro.props;
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content={description} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<ClientRouter />
		
		<!-- Font Awesome -->
		<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA==" crossorigin="anonymous" referrerpolicy="no-referrer" />
		
		<!-- Dark mode script -->
		<script is:inline>
			// On page load or when changing themes, best to add inline in `head` to avoid FOUC
			function applyTheme() {
				if (localStorage.getItem('color-theme') === 'dark' || (!('color-theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
					document.documentElement.classList.add('dark');
				} else {
					document.documentElement.classList.remove('dark');
				}
			}
			
			// Apply theme on initial load
			applyTheme();
			
			// Apply theme on page navigation
			document.addEventListener('astro:page-load', applyTheme);
			document.addEventListener('astro:after-swap', applyTheme);
		</script>
	</head>
	<body>
		<script is:inline src="https://cdn.jsdelivr.net/npm/flowbite@3.1.2/dist/flowbite.min.js"></script>
		<ChainlitCopilot client:load />
		<Navigation />
		<div id="content-container">
			<slot />
		</div>
		<Footer />
	</body>
</html>

<style is:global>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
		display: flex;
		flex-direction: column;
		background-color: white;
	}
	
	html.dark,
	html.dark body {
		background-color: #111827; /* dark:bg-gray-900 */
	}
	
	body {
		display: flex;
		flex-direction: column;
		min-height: 100vh;
	}
	
	#content-container {
		font-family: Inter, Roboto, 'Helvetica Neue', 'Arial Nova', 'Nimbus Sans', Arial, sans-serif;
		flex: 1;
		max-width: 1200px;
		width: 100%;
		margin: 0 auto;
		padding: 5rem 1rem 2rem; /* Added top padding to account for fixed navigation */
	}
</style>
