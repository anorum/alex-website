---
import { ClientRouter } from "astro:transitions";

import ChainlitCopilot from '../components/ChainlitCopilot.jsx';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro'

import "../styles/global.css";
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>Astro Basics</title>
		<ClientRouter />
	</head>
	<body>
		<script is:inline src="https://cdn.jsdelivr.net/npm/flowbite@3.1.2/dist/flowbite.min.js"></script>
		<ChainlitCopilot client:load />
		<Navigation />
		<div id="content-container">
			<slot />
		</div>
		<Footer />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
	
	#content-container {
		font-family: Inter, Roboto, 'Helvetica Neue', 'Arial Nova', 'Nimbus Sans', Arial, sans-serif;
		height: 100%;
		max-width: 1200px;
		margin: 0 auto;
		padding: 5rem 1rem 2rem; /* Added top padding to account for fixed navigation */
		min-height: 70vh; /* Ensures minimum height for content area */
	}
</style>
