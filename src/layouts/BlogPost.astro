---
import Layout from './Layout.astro';

const { frontmatter } = Astro.props;
const { title, description, pubDate, updatedDate, author, image, tags, category } = frontmatter;

// Format date function
function formatDate(date: Date): string {
  return new Date(date).toLocaleDateString('en-us', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
}
---

<Layout title={`${title} - Alex Norum`} description={description}>
    <article class="bg-white dark:bg-gray-900">
      <div class="py-8 px-4 mx-auto max-w-screen-xl lg:py-16">
        <!-- Header -->
        <div class="mb-8">
          <div class="flex items-center gap-2 mb-4">
            <span class="bg-blue-100 text-blue-800 text-xs font-medium px-2.5 py-0.5 rounded dark:bg-blue-900 dark:text-blue-300">
              {category}
            </span>
            <span class="text-sm text-gray-500 dark:text-gray-400">
              {formatDate(pubDate)}
            </span>
            {updatedDate && (
              <span class="text-sm text-gray-500 dark:text-gray-400">
                (Updated: {formatDate(updatedDate)})
              </span>
            )}
          </div>
          
          <h1 class="text-4xl md:text-5xl font-extrabold text-gray-900 dark:text-white mb-4">
            {title}
          </h1>
          
          <p class="text-xl text-gray-500 dark:text-gray-400 mb-6">
            {description}
          </p>
          
          <div class="flex items-center mb-6">
            <div class="flex items-center space-x-2">
              <img class="w-10 h-10 rounded-full" src="https://flowbite.s3.amazonaws.com/blocks/marketing-ui/avatars/jese-leos.png" alt={`${author} avatar`} />
              <div>
                <p class="text-gray-900 dark:text-white font-medium">{author}</p>
              </div>
            </div>
          </div>
          
          {image && (
            <img 
              src={image} 
              alt={`Cover image for ${title}`} 
              class="w-full h-auto max-h-96 object-cover rounded-lg mb-8"
            />
          )}
          
          <div class="flex flex-wrap gap-2 mb-8">
            {tags && tags.map((tag: string) => (
              <span class="bg-gray-100 text-gray-800 text-xs font-medium px-2.5 py-0.5 rounded dark:bg-gray-700 dark:text-gray-300">
                {tag}
              </span>
            ))}
          </div>
        </div>
        
        <!-- Content -->
        <div class="prose prose-lg dark:prose-invert max-w-none">
          <slot />
        </div>
        
        <!-- Footer -->
        <div class="mt-12 pt-8 border-t border-gray-200 dark:border-gray-700">
          <div class="flex flex-col md:flex-row md:justify-between gap-4">
            <a href="/notes" class="inline-flex items-center text-blue-600 hover:underline dark:text-blue-500">
              <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
                <path fill-rule="evenodd" d="M7.707 14.707a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 1.414L5.414 9H17a1 1 0 110 2H5.414l2.293 2.293a1 1 0 010 1.414z" clip-rule="evenodd"></path>
              </svg>
              Back to all posts
            </a>
          </div>
        </div>
      </div>
    </article>
</Layout>
