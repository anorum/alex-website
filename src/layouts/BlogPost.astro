---
import Layout from './Layout.astro';

const { frontmatter } = Astro.props;
const { title, description, pubDate, updatedDate, author, image, tags, category } = frontmatter;

// Format date function
function formatDate(date: Date): string {
  return new Date(date).toLocaleDateString('en-us', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
}
---

<Layout title={`${title} - Alex Norum`} description={description}>
    <article class="relative">
      <div class="absolute inset-0 bg-white/5 dark:bg-white/5 border-y border-white/10"></div>
      <div class="relative z-10 py-8 px-4 mx-auto max-w-4xl lg:py-16">
        <!-- Header -->
        <div class="mb-8">
          <div class="flex items-center gap-2 mb-4">
            <span class="bg-[var(--secondary-color)] text-[var(--text-color)] text-xs font-medium px-2.5 py-0.5 rounded transition-transform hover:scale-105">
              {category}
            </span>
            <span class="text-sm text-[var(--text-secondary)]">
              {formatDate(pubDate)}
            </span>
            {updatedDate && (
              <span class="text-sm text-[var(--text-secondary)]">
                (Updated: {formatDate(updatedDate)})
              </span>
            )}
          </div>
          
          <h1 class="text-4xl md:text-5xl font-extrabold text-[var(--text-color)] mb-4">
            {title}
          </h1>
          
          <p class="text-xl text-[var(--text-secondary)] mb-6">
            {description}
          </p>
          
          <div class="flex items-center mb-6">
            <div class="flex items-center space-x-2">
              <img class="w-10 h-10 rounded-full" src="https://flowbite.s3.amazonaws.com/blocks/marketing-ui/avatars/jese-leos.png" alt={`${author} avatar`} />
              <div>
                <p class="text-[var(--text-color)] font-medium">{author}</p>
              </div>
            </div>
          </div>
          
          {image && (
            <img 
              src={image} 
              alt={`Cover image for ${title}`} 
              class="w-full h-auto max-h-96 object-cover rounded-lg mb-8"
            />
          )}
          
          <div class="flex flex-wrap gap-2 mb-8">
            {tags && tags.map((tag: string) => (
              <span class="bg-[var(--tertiary-color)] text-[var(--text-color)] text-xs font-medium px-2.5 py-0.5 rounded transition-transform hover:scale-105">
                {tag}
              </span>
            ))}
          </div>
        </div>
        
        <!-- Content -->
        <div class="prose prose-lg dark:prose-invert max-w-none 
          prose-headings:text-[var(--text-color)] 
          prose-p:text-[var(--text-secondary)] 
          prose-a:text-[var(--accent-color)] hover:prose-a:text-[var(--secondary-color)]
          prose-strong:text-[var(--text-color)]
          prose-em:text-[var(--text-secondary)]
          prose-code:bg-[var(--bubble-bg)] prose-code:text-[var(--text-color)] prose-code:px-1 prose-code:py-0.5 prose-code:rounded
          prose-pre:bg-[var(--bubble-bg)] prose-pre:text-[var(--text-color)] prose-pre:shadow-sm
          prose-pre:border prose-pre:border-[var(--border-color)]
          prose-li:text-[var(--text-secondary)]
          prose-ol:text-[var(--text-secondary)]
          prose-ul:text-[var(--text-secondary)]
          prose-blockquote:text-[var(--text-secondary)] prose-blockquote:border-[var(--accent-color)]
          prose-hr:border-[var(--border-color)]
          prose-table:text-[var(--text-secondary)]
          prose-th:text-[var(--text-color)] prose-th:bg-[var(--bubble-bg)]
          prose-td:border-[var(--border-color)]
          prose-img:rounded-lg prose-img:shadow-md
          prose-figure:text-[var(--text-secondary)]
          prose-figcaption:text-[var(--text-tertiary)]">
          <slot />
        </div>
        
        <!-- Footer -->
        <div class="mt-12 pt-8 border-t border-[var(--border-color)]">
          <div class="flex flex-col md:flex-row md:justify-between gap-4">
            <a href="/notes" class="inline-flex items-center px-4 py-2 rounded-full bg-[var(--bubble-bg)] text-[var(--text-color)] border border-[var(--border-color)] hover:bg-[var(--accent-color)] hover:text-white transition-all duration-300 hover:scale-105">
              <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
                <path fill-rule="evenodd" d="M7.707 14.707a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 1.414L5.414 9H17a1 1 0 110 2H5.414l2.293 2.293a1 1 0 010 1.414z" clip-rule="evenodd"></path>
              </svg>
              Back to all posts
            </a>
          </div>
        </div>
      </div>
    </article>
</Layout>
