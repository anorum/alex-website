---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import WhatIDo from '../components/WhatIDo.astro';
import Experience from '../components/Experience.astro';
import Stack from '../components/Stack.astro';
import SectionHeader from '../components/SectionHeader.astro';
import IndexTravelMap from '../components/travel/IndexTravelMap';
import { travelLocations, travelStats } from '../data/travel';

const japanVisits = travelLocations.find((loc) => loc.country === 'Japan')?.visits ?? 0;
---

<Layout title="Alex Norum - Data Platform Engineering Leader" description="Personal website of Alex Norum – engineering leader, infrastructure builder, and system simplifier. Based in Portland, OR.">

  <!-- Hero Section -->
  <Hero />

  <!-- 01 What I Do -->
  <WhatIDo />

  <!-- 02 Experience -->
  <Experience />

  <!-- 03 Stack -->
  <Stack />

  <!-- 04 Travel -->
  <section class="py-12 sm:py-16" id="travel" style="border-top: var(--rule);">
    <div class="max-w-6xl mx-auto px-5 sm:px-8">
      <SectionHeader number="04" title="Off the Clock" />

      <div class="travel-layout mt-6 sm:mt-8 reveal-item">
        <div class="travel-stats">
          <div class="travel-stat">
            <span class="travel-stat-num">{travelStats.totalCountries}</span>
            <span class="travel-stat-label eyebrow">Countries</span>
          </div>
          <div class="travel-stat">
            <span class="travel-stat-num">{travelStats.totalVisits}</span>
            <span class="travel-stat-label eyebrow">Trips</span>
          </div>
          <div class="travel-stat">
            <span class="travel-stat-num">{japanVisits}×</span>
            <span class="travel-stat-label eyebrow">Japan</span>
          </div>
        </div>

        <div class="travel-map">
          <IndexTravelMap client:only="react" travelData={travelLocations} />
        </div>
      </div>

      <p class="mt-4 text-sm reveal-item" style="color: var(--text-tertiary); font-family: var(--font-body);">
        When I'm not building platforms, I'm usually somewhere on this map.
      </p>
    </div>
  </section>

</Layout>

<style>
  .travel-layout {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  @media (min-width: 900px) {
    .travel-layout {
      flex-direction: row;
      align-items: stretch;
      gap: 3rem;
    }
  }

  .travel-stats {
    display: flex;
    gap: 2.5rem;
    flex-shrink: 0;
  }

  @media (min-width: 900px) {
    .travel-stats {
      flex-direction: column;
      gap: 1.75rem;
      justify-content: center;
    }
  }

  .travel-stat {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .travel-stat-num {
    font-family: var(--font-heading);
    font-weight: 900;
    font-size: 2.5rem;
    line-height: 1;
    color: var(--accent-color);
  }

  .travel-stat-label {
    color: var(--text-secondary);
  }

  .travel-map {
    flex: 1;
    border: var(--rule);
    overflow: hidden;
    min-width: 0;
  }
</style>

<style is:global>
  /* Leaflet z-index fixes */
  .leaflet-pane,
  .leaflet-tile,
  .leaflet-marker-icon,
  .leaflet-marker-shadow,
  .leaflet-tile-container,
  .leaflet-pane > svg,
  .leaflet-pane > canvas,
  .leaflet-zoom-box,
  .leaflet-image-layer,
  .leaflet-layer {
    z-index: 1 !important;
  }
  .leaflet-overlay-pane { z-index: 2 !important; }
  .leaflet-shadow-pane { z-index: 3 !important; }
  .leaflet-marker-pane { z-index: 4 !important; }
  .leaflet-tooltip-pane { z-index: 5 !important; }
  .leaflet-popup-pane { z-index: 6 !important; }
  .leaflet-control { z-index: 7 !important; }
  .leaflet-top, .leaflet-bottom { z-index: 8 !important; }

  .theme-standard .leaflet-popup-content-wrapper {
    border-radius: 0 !important;
    border: 2px solid var(--line-color) !important;
    background-color: var(--bg-color) !important;
    color: var(--text-color) !important;
    padding: 0.5rem !important;
    box-shadow: none !important;
    font-family: var(--font-mono) !important;
  }
  .theme-standard .leaflet-popup-tip {
    background-color: var(--bg-color) !important;
    border: 1px solid var(--line-color) !important;
  }
  .leaflet-popup-content {
    margin: 0 !important;
    line-height: 1.4 !important;
  }
  .leaflet-popup {
    z-index: 1000 !important;
  }
</style>
