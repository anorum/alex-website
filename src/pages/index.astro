---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import WhatIDo from '../components/WhatIDo.astro';
import Timeline from '../components/Timeline.astro';
import IndexTravelMap from '../components/travel/IndexTravelMap';
import { travelLocations, travelStats } from '../data/travel';
---

<Layout title="Alex Norum - Data Platform Engineering Leader" description="Personal website of Alex Norum – engineering leader, infrastructure builder, and occasional golf enthusiast. Based in Portland, OR.">

  <!-- Hero Section -->
  <Hero />

  <!-- What I Do Section -->
  <WhatIDo />

  <!-- Work Experience Timeline -->
  <section class="py-16" id="experience">
    <div class="max-w-5xl mx-auto px-6">
      <h2 class="text-2xl sm:text-3xl font-bold mb-2 reveal-item" style="font-family: var(--font-heading); color: var(--text-color);">Work Experience</h2>
      <p class="text-sm mb-6 reveal-item" style="color: var(--text-tertiary);">From analyst to engineering leader</p>
      <Timeline />
    </div>
  </section>

  <!-- Travel Map Section -->
  <section class="py-12 reveal-item" id="travel">
    <div class="max-w-5xl mx-auto px-6 mb-5">
      <h2 class="text-2xl sm:text-3xl font-bold" style="font-family: var(--font-heading); color: var(--text-color);">Places I've Been</h2>
      <p class="text-sm mt-1" style="color: var(--text-tertiary);">When I'm not building platforms, I'm usually somewhere on this map. {travelStats.totalCountries} countries &middot; {travelStats.totalVisits} trips.</p>
    </div>
    <div class="w-full overflow-hidden">
      <IndexTravelMap client:only="react" travelData={travelLocations} />
    </div>
  </section>

  <!-- Contact CTA -->
  <section class="py-16 reveal-item" id="contact">
    <div class="max-w-5xl mx-auto px-6 text-center">
      <h2 class="text-2xl sm:text-3xl font-bold mb-3" style="font-family: var(--font-heading); color: var(--text-color);">Let's Connect</h2>
      <p class="text-base sm:text-lg mb-6" style="color: var(--text-secondary);">Always happy to talk data platforms, team building, or whatever you're working on.</p>
      <a
        href="https://www.linkedin.com/in/alex-norum/"
        class="inline-flex items-center gap-2 px-6 py-3 rounded-lg font-medium transition-all duration-200 hover:-translate-y-0.5"
        style="background-color: var(--accent-color); color: var(--bg-color);"
      >
        Say hello on LinkedIn
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
      </a>
    </div>
  </section>

</Layout>

<!-- Leaflet CSS -->
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />

<style>
/* Leaflet z-index fixes */
.leaflet-pane,
.leaflet-tile,
.leaflet-marker-icon,
.leaflet-marker-shadow,
.leaflet-tile-container,
.leaflet-pane > svg,
.leaflet-pane > canvas,
.leaflet-zoom-box,
.leaflet-image-layer,
.leaflet-layer {
  z-index: 1 !important;
}
.leaflet-overlay-pane { z-index: 2 !important; }
.leaflet-shadow-pane { z-index: 3 !important; }
.leaflet-marker-pane { z-index: 4 !important; }
.leaflet-tooltip-pane { z-index: 5 !important; }
.leaflet-popup-pane { z-index: 6 !important; }
.leaflet-control { z-index: 7 !important; }
.leaflet-top, .leaflet-bottom { z-index: 8 !important; }

.leaflet-popup-content-wrapper {
  border-radius: 0.5rem !important;
  padding: 0.5rem !important;
  box-shadow: var(--card-shadow) !important;
}
.leaflet-popup-content {
  margin: 0 !important;
  line-height: 1.4 !important;
}
.leaflet-popup {
  z-index: 1000 !important;
}
</style>
