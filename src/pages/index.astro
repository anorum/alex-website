---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import WhatIDo from '../components/WhatIDo.astro';
import Experience from '../components/Experience.astro';
import Projects from '../components/Projects.astro';
import Stack from '../components/Stack.astro';
import HowIThink from '../components/HowIThink.astro';
import { interests } from '../data/interests';
import SectionHeader from '../components/SectionHeader.astro';
import IndexTravelMap from '../components/travel/IndexTravelMap';
import { travelLocations, travelStats } from '../data/travel';

const japanVisits = travelLocations.find((loc) => loc.country === 'Japan')?.visits ?? 0;
---

<Layout title="Alex Norum - Data Platform, Data Engineering, and Analytics" description="Alex Norum, a Portland engineer who works on data platforms, data engineering, and analytics.">

  <!-- Hero Section -->
  <Hero />

  <!-- 01 What I Do -->
  <WhatIDo />

  <!-- 02 Experience -->
  <Experience />

  <!-- 03 Projects -->
  <Projects />

  <!-- 04 Stack -->
  <Stack />

  <!-- 05 How I Think -->
  <HowIThink />

  <!-- 06 Off the Clock -->
  <section class="section-pad" id="travel" style="border-top: var(--rule);">
    <div class="max-w-6xl mx-auto px-5 sm:px-8">
      <SectionHeader number="06" title="Off the clock" />

      <div class="travel-layout mt-6 sm:mt-8 reveal-item">
        <div class="travel-stats">
          <div class="travel-stat">
            <span class="travel-stat-num">{travelStats.totalCountries}</span>
            <span class="travel-stat-label eyebrow">Countries</span>
          </div>
          <div class="travel-stat">
            <span class="travel-stat-num">{travelStats.totalVisits}</span>
            <span class="travel-stat-label eyebrow">Trips</span>
          </div>
          <div class="travel-stat">
            <span class="travel-stat-num">{japanVisits}×</span>
            <span class="travel-stat-label eyebrow">Japan</span>
          </div>
        </div>

        <div class="travel-map">
          <IndexTravelMap client:only="react" travelData={travelLocations} />
        </div>
      </div>

      <ul class="interests mt-8 sm:mt-10 stagger-children" role="list">
        {interests.filter((i) => i.title !== 'Travel').map((item) => (
          <li class="interest reveal-item">
            <span class="interest-title eyebrow">{item.title}</span>
            <span class="interest-desc">{item.description}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

</Layout>

<style>
  .travel-layout {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  @media (min-width: 900px) {
    .travel-layout {
      flex-direction: row;
      align-items: stretch;
      gap: 3rem;
    }
  }

  .travel-stats {
    display: flex;
    gap: 2.5rem;
    flex-shrink: 0;
  }

  @media (min-width: 900px) {
    .travel-stats {
      flex-direction: column;
      gap: 1.75rem;
      justify-content: center;
    }
  }

  .travel-stat {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .travel-stat-num {
    font-family: var(--font-heading);
    font-weight: 900;
    font-size: 2.5rem;
    line-height: 1;
    color: var(--accent-color);
  }

  .travel-stat-label {
    color: var(--text-secondary);
  }

  .travel-map {
    flex: 1;
    border: var(--rule);
    overflow: hidden;
    min-width: 0;
  }

  .interests {
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
    gap: 0;
    border-top: 1px solid var(--hairline-color);
  }

  .interest {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    padding: 1rem 1.5rem 1rem 0;
    border-bottom: 1px solid var(--hairline-color);
  }

  .interest-title {
    color: var(--accent-text);
  }

  .interest-desc {
    font-family: var(--font-body);
    font-size: 0.8438rem;
    line-height: 1.55;
    color: var(--text-secondary);
  }
</style>

<style is:global>
  /* Leaflet z-index fixes */
  .leaflet-pane,
  .leaflet-tile,
  .leaflet-marker-icon,
  .leaflet-marker-shadow,
  .leaflet-tile-container,
  .leaflet-pane > svg,
  .leaflet-pane > canvas,
  .leaflet-zoom-box,
  .leaflet-image-layer,
  .leaflet-layer {
    z-index: 1 !important;
  }
  .leaflet-overlay-pane { z-index: 2 !important; }
  .leaflet-shadow-pane { z-index: 3 !important; }
  .leaflet-marker-pane { z-index: 4 !important; }
  .leaflet-tooltip-pane { z-index: 5 !important; }
  .leaflet-popup-pane { z-index: 6 !important; }
  .leaflet-control { z-index: 7 !important; }
  .leaflet-top, .leaflet-bottom { z-index: 8 !important; }

  /* Ocean color behind the country polygons (there is no tile layer) */
  .theme-standard .leaflet-container {
    background-color: #e4ebe7;
  }
  .theme-standard.dark .leaflet-container {
    background-color: #0f1a15;
  }

  .theme-standard .leaflet-popup-content-wrapper {
    border-radius: 0 !important;
    border: 2px solid var(--line-color) !important;
    background-color: var(--bg-color) !important;
    color: var(--text-color) !important;
    padding: 0.5rem !important;
    box-shadow: none !important;
    font-family: var(--font-mono) !important;
  }
  .theme-standard .leaflet-popup-tip {
    background-color: var(--bg-color) !important;
    border: 1px solid var(--line-color) !important;
  }
  .leaflet-popup-content {
    margin: 0 !important;
    line-height: 1.4 !important;
  }
  .leaflet-popup {
    z-index: 1000 !important;
  }
</style>
