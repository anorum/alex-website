---
import { Image } from 'astro:assets';
import meImage from '../assets/me.jpeg';
import legalZoomLogo from '../assets/logos/LegalZoomlogo.webp';
import newRelicLogo from '../assets/logos/newreliclogo.svg';
import oracleLogo from '../assets/logos/oraclelogo.png';
import Layout from '../layouts/Layout.astro';
import MaraAssistant from '../components/MaraAssistant.astro';

// Define work experience data
const workExperience = [
  {
    title: "Group Manager, Data Platform Engineering",
    company: "LegalZoom",
    period: "23-Present",
    description: "Leading the Data Platform team, focused on Snowflake administration, orchestration (Airflow), infrastructure-as-code (Terraform), and data governance enablement."
  },
  {
    title: "Principal Data Engineer",
    company: "LegalZoom",
    period: "21-23",
    description: "Modernized the data platform by introducing Airflow on Kubernetes, revamping Snowflake architecture with Terraform, and enabling cost governance practices."
  },
  {
    title: "Senior Data Engineer",
    company: "New Relic",
    period: "19-21",
    description: "Worked across analytics and data platform teams to scale ETL pipelines, manage dbt models, and integrate cross-functional product analytics workflows."
  },
  {
    title: "Data Engineer",
    company: "Oracle",
    period: "13-19",
    description: "Built data pipelines and analytics solutions for enterprise database systems."
  }
];

// Define skills
const skills = [
  "Python", "Snowflake", "Airflow", "Terraform", "AWS", "Kubernetes", 
  "dbt", "PostgreSQL", "Kafka", "ETL", "Data Modeling", "LLMs", 
  "ML Pipelines", "Prompt Engineering", "Data Contracts", "Cost Optimization"
];

// Define principles
const principles = [
  {
    number: "01",
    title: "Build for Scale",
    description: "I design systems that can handle growth and increasing complexity. Scalability isn't just about handling more data—it's about creating architectures that can evolve with changing requirements."
  },
  {
    number: "02",
    title: "Collaborate",
    description: "Good engineering is not created in isolation but rather in a shared space. I aim to include stakeholders in my process and create a collaborative environment that welcomes and encourages feedback."
  },
  {
    number: "03",
    title: "Accessibility",
    description: "I aim to make everything I design accessible to all for one main reason - it's the right thing to do. Accessible products benefit the many, not the few."
  },
  {
    number: "04",
    title: "Experiment",
    description: "Everything I create is subject to change and experimentation. Not everything will work, but it's worth trying - and learning from what doesn't."
  }
];
---

<Layout title="Alex Norum - Software Engineer" description="Personal website of Alex Norum, Software Engineer and Technology Enthusiast">
    <!-- Hero Section -->
    <section class="hero">
      <h1>I'm Alex.</h1>
      <p>Data Platform Engineer & Technology Enthusiast</p>
      <div class="profile animate-fade-in">
        <Image 
          src={meImage} 
          alt="Alex Norum" 
          width={300}
          height={300}
          class="profile-image"
        />
        <div class="profile-content">
          <h2>I'm a Data Platform Engineer working remotely from Portland, Oregon.</h2>
          <p>
            Over the past decade, I've worked in various areas of data engineering, including ETL pipelines, data modeling, and platform architecture. I currently lead the Data Platform Engineering team at LegalZoom, where I focus on enabling teams through clean tooling, governance, and cost-efficient architecture.
          </p>
          <p>
            I'm passionate about creating scalable, efficient data solutions that help businesses make better decisions. My approach combines technical expertise with a focus on collaboration and accessibility.
          </p>
        </div>
      </div>
    </section>
            
    <!-- Experience Section -->
    <section class="section">
      <div class="container">
        <h2>Work Experience</h2>
        <div class="experience-container">
            <div class="company-timeline backdrop-blur-md bg-white/5 rounded-xl p-6 border border-white/10">
              <div class="company-header flex items-center mb-4">
                <div class="flex items-center justify-center">
                  <Image 
                    src={legalZoomLogo} 
                    alt="LegalZoom Logo" 
                    width={50}
                    height={50}
                    class="rounded-lg mr-4"
                  />
                </div>
                <div class="flex flex-col justify-center">
                  <h3 class="text-2xl mb-0">LegalZoom</h3>
                  <p class="text-sm opacity-70">Legal Technology</p>
                </div>
              </div>
              
              <div class="relative pl-8 border-l-2 border-secondary-color ml-6 mt-6">
                <div class="experience-timeline-item mb-8">
                  <div class="absolute w-4 h-4 bg-secondary-color rounded-full -left-[10px] mt-1"></div>
                  <div class="flex justify-between items-center mb-2">
                    <h4 class="text-xl">Group Manager, Data Platform Engineering</h4>
                    <span class="experience-date">23-Present</span>
                  </div>
                  <p class="text-sm opacity-80 leading-relaxed">Leading the Data Platform team, focused on Snowflake administration, orchestration (Airflow), infrastructure-as-code (Terraform), and data governance enablement.</p>
                </div>
                
                <div class="experience-timeline-item">
                  <div class="absolute w-4 h-4 bg-secondary-color rounded-full -left-[10px] mt-1"></div>
                  <div class="flex justify-between items-center mb-2">
                    <h4 class="text-xl">Principal Data Engineer</h4>
                    <span class="experience-date">21-23</span>
                  </div>
                  <p class="text-sm opacity-80 leading-relaxed">Modernized the data platform by introducing Airflow on Kubernetes, revamping Snowflake architecture with Terraform, and enabling cost governance practices.</p>
                </div>
              </div>
            </div>
            
            <div class="company-timeline backdrop-blur-md bg-white/5 rounded-xl p-6 border border-white/10">
              <div class="company-header flex items-center mb-4">
                <div class="flex items-center justify-center">
                  <Image 
                    src={newRelicLogo} 
                    alt="New Relic Logo" 
                    width={50}
                    height={50}
                    class="rounded-lg mr-4"
                  />
                </div>
                <div class="flex flex-col justify-center">
                  <h3 class="text-2xl mb-0">New Relic</h3>
                  <p class="text-sm opacity-70">Observability Platform</p>
                </div>
              </div>
              
              <div class="relative pl-8 border-l-2 border-secondary-color ml-6 mt-6">
                <div class="experience-timeline-item">
                  <div class="absolute w-4 h-4 bg-secondary-color rounded-full -left-[10px] mt-1"></div>
                  <div class="flex justify-between items-center mb-2">
                    <h4 class="text-xl">Senior Data Engineer</h4>
                    <span class="experience-date">19-21</span>
                  </div>
                  <p class="text-sm opacity-80 leading-relaxed">Worked across analytics and data platform teams to scale ETL pipelines, manage dbt models, and integrate cross-functional product analytics workflows.</p>
                </div>
              </div>
            </div>
            
            <div class="company-timeline backdrop-blur-md bg-white/5 rounded-xl p-6 border border-white/10">
              <div class="company-header flex items-center mb-4">
                <div class="flex items-center justify-center">
                  <Image 
                    src={oracleLogo} 
                    alt="Oracle Logo" 
                    width={50}
                    height={50}
                    class="rounded-lg mr-4"
                  />
                </div>
                <div class="flex flex-col justify-center">
                  <h3 class="text-2xl mb-0">Oracle</h3>
                  <p class="text-sm opacity-70">Enterprise Technology</p>
                </div>
              </div>
              
              <div class="relative pl-8 border-l-2 border-secondary-color ml-6 mt-6">
                <div class="experience-timeline-item mb-8">
                  <div class="absolute w-4 h-4 bg-secondary-color rounded-full -left-[10px] mt-1"></div>
                  <div class="flex justify-between items-center mb-2">
                    <h4 class="text-xl">Senior Data Engineer</h4>
                    <span class="experience-date">17-19</span>
                  </div>
                  <p class="text-sm opacity-80 leading-relaxed">Led development of enterprise data pipelines and analytics solutions for Oracle's cloud services.</p>
                </div>
                
                <div class="experience-timeline-item">
                  <div class="absolute w-4 h-4 bg-secondary-color rounded-full -left-[10px] mt-1"></div>
                  <div class="flex justify-between items-center mb-2">
                    <h4 class="text-xl">Data Engineer</h4>
                    <span class="experience-date">13-17</span>
                  </div>
                  <p class="text-sm opacity-80 leading-relaxed">Built and maintained data pipelines and analytics solutions for enterprise database systems.</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Skills Section -->
    <section class="section">
      <div class="container">
        <h2>Skills & Technologies</h2>
        
        <div class="principles-grid mb-6">
          <div class="principle-card">
            <div class="skill-category">
              <div class="skill-category-header">
                <i class="fas fa-code text-3xl text-secondary-color mr-3 skill-category-icon"></i>
                <div>
                  <h3>Programming</h3>
                  <div class="skill-level" style="width: 95%;"></div>
                </div>
              </div>
              <div class="skills-container">
                <span class="skill-tag"><i class="fab fa-python skill-tag-icon"></i>Python</span>
                <span class="skill-tag"><i class="fas fa-database skill-tag-icon"></i>PostgreSQL</span>
                <span class="skill-tag"><i class="fas fa-exchange-alt skill-tag-icon"></i>ETL</span>
                <span class="skill-tag"><i class="fas fa-project-diagram skill-tag-icon"></i>Data Modeling</span>
              </div>
            </div>
          </div>
          
          <div class="principle-card">
            <div class="skill-category">
              <div class="skill-category-header">
                <i class="fas fa-cloud text-3xl text-secondary-color mr-3 skill-category-icon"></i>
                <div>
                  <h3>Cloud & Infrastructure</h3>
                  <div class="skill-level" style="width: 90%;"></div>
                </div>
              </div>
              <div class="skills-container">
                <span class="skill-tag"><i class="fas fa-snowflake skill-tag-icon"></i>Snowflake</span>
                <span class="skill-tag"><i class="fab fa-aws skill-tag-icon"></i>AWS</span>
                <span class="skill-tag"><i class="fas fa-server skill-tag-icon"></i>Terraform</span>
                <span class="skill-tag"><i class="fas fa-dharmachakra skill-tag-icon"></i>Kubernetes</span>
              </div>
            </div>
          </div>
        </div>
        
        <div class="principles-grid">
          <div class="principle-card">
            <div class="skill-category">
              <div class="skill-category-header">
                <i class="fas fa-cogs text-3xl text-secondary-color mr-3 skill-category-icon"></i>
                <div>
                  <h3>Data Engineering</h3>
                  <div class="skill-level" style="width: 98%;"></div>
                </div>
              </div>
              <div class="skills-container">
                <span class="skill-tag"><i class="fas fa-wind skill-tag-icon"></i>Airflow</span>
                <span class="skill-tag"><i class="fas fa-cube skill-tag-icon"></i>dbt</span>
                <span class="skill-tag"><i class="fas fa-stream skill-tag-icon"></i>Kafka</span>
                <span class="skill-tag"><i class="fas fa-chart-line skill-tag-icon"></i>Cost Optimization</span>
              </div>
            </div>
          </div>
          
          <div class="principle-card">
            <div class="skill-category">
              <div class="skill-category-header">
                <i class="fas fa-robot text-3xl text-secondary-color mr-3 skill-category-icon"></i>
                <div>
                  <h3>AI & ML</h3>
                  <div class="skill-level" style="width: 85%;"></div>
                </div>
              </div>
              <div class="skills-container">
                <span class="skill-tag"><i class="fas fa-brain skill-tag-icon"></i>LLMs</span>
                <span class="skill-tag"><i class="fas fa-cogs skill-tag-icon"></i>ML Pipelines</span>
                <span class="skill-tag"><i class="fas fa-terminal skill-tag-icon"></i>Prompt Engineering</span>
                <span class="skill-tag"><i class="fas fa-file-contract skill-tag-icon"></i>Data Contracts</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Principles Section -->
    <section class="section">
      <div class="container">
        <h2>My Principles</h2>
        <p class="mb-8 text-lg">
          Let's collaborate if you're committed to sustainability, education, equality, or carbon neutrality. I believe we should leave this Earth as good as or better than we found it for future generations.
        </p>

        <div class="principles-grid">
          <div class="principle-card">
            <div class="flex items-center mb-4">
              <div class="principle-number">01</div>
              <i class="fas fa-expand-arrows-alt text-3xl text-accent-color ml-4"></i>
            </div>
            <h3>Build for Scale</h3>
            <p>
              I design systems that can handle growth and increasing complexity. Scalability isn't just about handling more data—it's about creating architectures that can evolve with changing requirements.
            </p>
          </div>
          
          <div class="principle-card">
            <div class="flex items-center mb-4">
              <div class="principle-number">02</div>
              <i class="fas fa-users text-3xl text-accent-color ml-4"></i>
            </div>
            <h3>Collaborate</h3>
            <p>
              Good engineering is not created in isolation but rather in a shared space. I aim to include stakeholders in my process and create a collaborative environment that welcomes and encourages feedback.
            </p>
          </div>
          
          <div class="principle-card">
            <div class="flex items-center mb-4">
              <div class="principle-number">03</div>
              <i class="fas fa-universal-access text-3xl text-accent-color ml-4"></i>
            </div>
            <h3>Accessibility</h3>
            <p>
              I aim to make everything I design accessible to all for one main reason - it's the right thing to do. Accessible products benefit the many, not the few.
            </p>
          </div>
          
          <div class="principle-card">
            <div class="flex items-center mb-4">
              <div class="principle-number">04</div>
              <i class="fas fa-flask text-3xl text-accent-color ml-4"></i>
            </div>
            <h3>Experiment</h3>
            <p>
              Everything I create is subject to change and experimentation. Not everything will work, but it's worth trying - and learning from what doesn't.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Personal Section -->
    <section class="section">
      <div class="container">
        <h2>Beyond Work</h2>
        <div class="principles-grid">
          <div class="principle-card">
            <div class="flex items-center mb-4">
              <i class="fas fa-snowboarding text-4xl text-secondary-color mr-4"></i>
              <h3>Outdoor Adventures</h3>
            </div>
            <p>
              When I'm not coding, you'll find me on the slopes snowboarding during winter months, hitting the trails for runs around Portland, or playing a round of golf at one of Oregon's beautiful courses.
            </p>
          </div>
          <div class="principle-card">
            <div class="flex items-center mb-4">
              <i class="fas fa-globe-americas text-4xl text-secondary-color mr-4"></i>
              <h3>Travel & Exploration</h3>
            </div>
            <p>
              I'm passionate about traveling around the world, experiencing different cultures, and collecting memories rather than things. My partner and I are always planning our next adventure.
            </p>
          </div>
        </div>
        
        <div class="principles-grid mt-6">
          <div class="principle-card">
            <div class="flex items-center mb-4">
              <i class="fas fa-utensils text-4xl text-secondary-color mr-4"></i>
              <h3>Portland Foodie</h3>
            </div>
            <p>
              Portland's food scene is incredible, and I love exploring local restaurants and food carts. From innovative farm-to-table spots to hidden neighborhood gems, I'm always on the hunt for great culinary experiences.
            </p>
          </div>
          <div class="principle-card">
            <div class="flex items-center mb-4">
              <i class="fas fa-dog text-4xl text-secondary-color mr-4"></i>
              <h3>Life at Home</h3>
            </div>
            <p>
              At home, I enjoy playing music, reading, and spending quality time with my Australian Labradoodle, Mara, who's always ready for the next adventure or just a lazy afternoon.
            </p>
          </div>
        </div>
        
        <div class="mt-8 text-center">
          <a href="/contact" class="nav-link inline-block">Get in touch</a>
        </div>
      </div>
    </section>
</Layout>
