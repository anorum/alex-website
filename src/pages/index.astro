---
import { Image } from 'astro:assets';
import meImage from '../assets/me.jpeg';
import MainLayout from '../layouts/MainLayout.astro';
import WorkExperienceItem from '../components/WorkExperienceItem.astro';
import EducationItem from '../components/EducationItem.astro';
import SkillsGroup from '../components/SkillsGroup.astro';
import InterestItem from '../components/InterestItem.astro';

// Define skills data
const frontendSkills = ['HTML', 'CSS', 'JavaScript', 'Astro', 'React', 'Tailwind CSS'];
const backendSkills = ['Python', 'FastAPI', 'Node.js', 'TypeScript'];
const databaseSkills = ['Snowflake', 'PostgreSQL', 'MySQL', 'Redis'];
const devopsSkills = ['Airflow', 'Kubernetes', 'Terraform', 'AWS', 'GitHub Actions', 'CI/CD'];

// Define interests data
const interests = [
  {
    title: 'Trail Running',
    description: 'I’m currently training for a marathon, and I love exploring forest trails around the Pacific Northwest.',
    icon: `<svg class="w-5 h-5 text-green-600 dark:text-green-300" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg"><path d="M10 2a8 8 0 018 8 8 8 0 11-8-8zM8 9H5a1 1 0 000 2h3v3a1 1 0 002 0v-3h3a1 1 0 000-2H10V6a1 1 0 10-2 0v3z"/></svg>`,
    colorScheme: 'green'
  },
  {
    title: 'DIY & Homelab Projects',
    description: 'From running Kubernetes on Raspberry Pis to building LLM-powered assistants, I enjoy automating and optimizing my home infrastructure.',
    icon: `<svg class="w-5 h-5 text-yellow-600 dark:text-yellow-300" fill="currentColor" viewBox="0 0 20 20"><path d="M4 3h12a1 1 0 011 1v12a1 1 0 01-1 1H4a1 1 0 01-1-1V4a1 1 0 011-1z"/></svg>`,
    colorScheme: 'yellow'
  }
];
---

<MainLayout title="Alex Norum - Software Engineer" description="Personal website of Alex Norum, Software Engineer and Technology Enthusiast">
	<main>
		<section class="bg-white dark:bg-gray-900">
			<div class="py-8 px-4 mx-auto max-w-screen-xl lg:py-16">
				<!-- Hero Section -->
				<div class="flex flex-col items-center justify-center text-center py-12 md:py-24">
					<h1 class="text-4xl md:text-6xl font-extrabold text-gray-900 dark:text-white mb-6">
						<span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-600 to-purple-600">Alex Norum</span>
					</h1>
					<p class="text-xl md:text-2xl font-light text-gray-500 dark:text-gray-400 mb-8 max-w-3xl">
						Software Engineer & Technology Enthusiast
					</p>
					<div class="flex space-x-4">
						<a href="#" class="text-gray-500 hover:text-gray-900 dark:hover:text-white">
							<svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path fill-rule="evenodd" d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z" clip-rule="evenodd" /></svg>
						</a>
						<a href="#" class="text-gray-500 hover:text-gray-900 dark:hover:text-white">
							<svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M8.29 20.251c7.547 0 11.675-6.253 11.675-11.675 0-.178 0-.355-.012-.53A8.348 8.348 0 0022 5.92a8.19 8.19 0 01-2.357.646 4.118 4.118 0 001.804-2.27 8.224 8.224 0 01-2.605.996 4.107 4.107 0 00-6.993 3.743 11.65 11.65 0 01-8.457-4.287 4.106 4.106 0 001.27 5.477A4.072 4.072 0 012.8 9.713v.052a4.105 4.105 0 003.292 4.022 4.095 4.095 0 01-1.853.07 4.108 4.108 0 003.834 2.85A8.233 8.233 0 012 18.407a11.616 11.616 0 006.29 1.84" /></svg>
						</a>
						<a href="#" class="text-gray-500 hover:text-gray-900 dark:hover:text-white">
							<svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" /></svg>
						</a>
						<a href="#" class="text-gray-500 hover:text-gray-900 dark:hover:text-white">
							<svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path fill-rule="evenodd" d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10c5.51 0 10-4.48 10-10S17.51 2 12 2zm6.605 4.61a8.502 8.502 0 011.93 5.314c-.281-.054-3.101-.629-5.943-.271-.065-.141-.12-.293-.184-.445a25.416 25.416 0 00-.564-1.236c3.145-1.28 4.577-3.124 4.761-3.362zM12 3.475c2.17 0 4.154.813 5.662 2.148-.152.216-1.443 1.941-4.48 3.08-1.399-2.57-2.95-4.675-3.189-5A8.687 8.687 0 0112 3.475zm-3.633.803a53.896 53.896 0 013.167 4.935c-3.992 1.063-7.517 1.04-7.896 1.04a8.581 8.581 0 014.729-5.975zM3.453 12.01v-.26c.37.01 4.512.065 8.775-1.215.25.477.477.965.694 1.453-.109.033-.228.065-.336.098-4.404 1.42-6.747 5.303-6.942 5.629a8.522 8.522 0 01-2.19-5.705zM12 20.547a8.482 8.482 0 01-5.239-1.8c.152-.315 1.888-3.656 6.703-5.337.022-.01.033-.01.054-.022a35.318 35.318 0 011.823 6.475 8.4 8.4 0 01-3.341.684zm4.761-1.465c-.086-.52-.542-3.015-1.659-6.084 2.679-.423 5.022.271 5.314.369a8.468 8.468 0 01-3.655 5.715z" clip-rule="evenodd" /></svg>
						</a>
					</div>
				</div>
				
				<!-- About Section -->
				<div class="grid md:grid-cols-3 gap-12 mb-16">
					<div class="col-span-1">
						<Image class="w-full rounded-lg shadow-lg" width=500 height=500 src={meImage} alt="Alex Norum profile picture">
					</div>
					<div class="col-span-2">
						<h2 class="text-3xl font-bold text-gray-900 dark:text-white mb-4">About Me</h2>
						<p class="text-lg text-gray-500 dark:text-gray-400 mb-4">
							I'm a data platform engineering leader with over a decade of experience building scalable, reliable, and self-service infrastructure. I currently lead the Data Platform Engineering team at LegalZoom, where I focus on enabling teams through clean tooling, governance, and cost-efficient architecture. Outside of work, I enjoy trail running, snowboarding, cooking, and exploring side projects involving LLMs and automation. I live in Portland, Oregon, with my partner and our Australian Labradoodle, Mara.
						</p>
					</div>
				</div>
				
				<!-- Work Experience Section -->
				<div class="mb-16">
					<h2 class="text-3xl font-bold text-gray-900 dark:text-white mb-8">Work Experience</h2>
					
					<ol class="relative border-s border-gray-200 dark:border-gray-700">
						<WorkExperienceItem
							title="Group Manager, Data Platform Engineering"
							company="LegalZoom"
							startDate="March 2023"
							location="Remote"
							isCurrent={true}
							description="Leading the Data Platform team, focused on Snowflake administration, orchestration (Airflow), infrastructure-as-code (Terraform), and data governance enablement. Driving cost optimization, access control automation, and self-service tooling across the organization."
							skills={["Snowflake", "Airflow", "Terraform", "AWS", "Kubernetes"]}
						/>
						<WorkExperienceItem
							title="Principal Data Engineer"
							company="LegalZoom"
							startDate="December 2021"
							endDate="March 2023"
							location="Remote"
							description="Modernized the data platform by introducing Airflow on Kubernetes, revamping Snowflake architecture with Terraform, and enabling cost governance practices. Built infrastructure for secure, scalable data processing."
							skills={["Python", "Airflow", "Terraform", "Snowflake", "Vault"]}
						/>
						<WorkExperienceItem
							title="Senior Data Engineer"
							company="New Relic"
							startDate="2019"
							endDate="2021"
							location="Portland, OR"
							description="Worked across analytics and data platform teams to scale ETL pipelines, manage dbt models, and integrate cross-functional product analytics workflows."
							skills={["dbt", "PostgreSQL", "Looker", "Python", "Kafka"]}
						/>
					</ol>
				</div>
				
				<!-- Education Section -->
				<div class="mb-16">
					<h2 class="text-3xl font-bold text-gray-900 dark:text-white mb-8">Education</h2>
					
					<EducationItem
						degree="Bachelor of Science in Computer Science"
						institution="University of Oregon"
						startYear="2010"
						endYear="2013"
						location="Eugene, OR"
					/>
				</div>
				
				<!-- Skills Section -->
				<div class="mb-16">
					<h2 class="text-3xl font-bold text-gray-900 dark:text-white mb-8">Skills</h2>
					
					<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
						<SkillsGroup title="Frontend" skills={frontendSkills} colorScheme="blue" />
						<SkillsGroup title="Backend" skills={backendSkills} colorScheme="green" />
						<SkillsGroup title="Database" skills={databaseSkills} colorScheme="purple" />
						<SkillsGroup title="DevOps" skills={devopsSkills} colorScheme="yellow" />
						<SkillsGroup title="Data Engineering" skills={['dbt', 'Kafka', 'ETL', 'Data Modeling', 'Batch & Streaming Pipelines']} colorScheme="pink" />
						<SkillsGroup title="Machine Learning & AI" skills={['LLMs', 'ML Pipelines', 'Prompt Engineering', 'Model Evaluation']} colorScheme="rose" />
						<SkillsGroup title="Data Governance & Observability" skills={['Data Contracts', 'Monitoring', 'Cost Optimization', 'Data Quality']} colorScheme="gray" />
					</div>
				</div>
				
				<!-- Interests Section -->
				<div class="mb-16">
					<h2 class="text-3xl font-bold text-gray-900 dark:text-white mb-8">Interests</h2>
					
					<div class="grid md:grid-cols-2 gap-4">
						{interests.map(interest => (
							<InterestItem
								title={interest.title}
								description={interest.description}
								icon={interest.icon}
								colorScheme={interest.colorScheme}
							/>
						))}
					</div>
				</div>
			</div>
		</section>
	</main>
</MainLayout>
