---
import Layout from '../layouts/Layout.astro';
import meImage from '../assets/me.jpeg';
import MaraAssistant from '../components/MaraAssistant.astro';
import Timeline from '../components/Timeline.astro';
import SkillsGroup from '../components/SkillsGroup.astro';
import InterestItem from '../components/InterestItem.astro';
import TravelMap from '../components/travel/TravelMap';
---

<Layout title="Alex Norum - Data Platform Engineer" description="Personal website of Alex Norum – engineering leader, infrastructure builder, and system simplifier. Based in Portland, OR.">
  <!-- Hero Section with About Me -->
  <section class="relative overflow-hidden py-16 md:py-24">
    <!-- Background decorative elements -->
    <div class="absolute top-0 left-0 w-full h-full overflow-hidden z-0">
      <div class="absolute top-20 left-10 w-64 h-64 bg-green-300 rounded-full mix-blend-multiply filter blur-3xl opacity-20 animate-blob"></div>
      <div class="absolute top-40 right-10 w-72 h-72 bg-purple-300 rounded-full mix-blend-multiply filter blur-3xl opacity-20 animate-blob animation-delay-2000"></div>
      <div class="absolute bottom-20 left-1/3 w-80 h-80 bg-yellow-300 rounded-full mix-blend-multiply filter blur-3xl opacity-20 animate-blob animation-delay-4000"></div>
    </div>

    <div class="container max-w-6xl mx-auto px-4 relative z-10">
      <div class="flex flex-col-reverse lg:flex-row items-center gap-12">
        <!-- Text Content -->
        <div class="lg:w-3/5 space-y-6">
          <div class="space-y-2">
            <span class="inline-block text-sm font-semibold px-3 py-1 rounded-full bg-secondary-color text-white">Hello there 👋</span>
            <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight leading-tight">
              I'm <span class="relative inline-block">
                <span class="relative z-10">Alex Norum</span>
                <span class="absolute bottom-2 left-0 w-full h-3 bg-secondary-color opacity-30"></span>
              </span>
            </h1>
          </div>
          
          <p class="text-lg sm:text-xl text-muted max-w-xl leading-relaxed">
            I lead platform teams, build scalable infrastructure, and obsess over empowering data teams with great tooling.
          </p>
          
          <div class="flex flex-col sm:flex-row gap-4 sm:items-center">
            <p class="text-base text-muted">
              Based in Portland. Building at LegalZoom. Formerly New Relic and Oracle.
            </p>
            <span class="hidden sm:block h-1 w-1 bg-accent-color rounded-full"></span>
            <p class="text-base text-muted italic">Always learning, always iterating.</p>
          </div>
          
          <div class="pt-4 flex flex-wrap gap-3">
            <a href="/stats" class="inline-flex items-center gap-2 px-4 py-2 rounded-full border border-accent-color text-accent-color hover:bg-accent-color hover:text-white transition-all">
              <span>See what I'm tracking</span>
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </a>
            <a href="#contact" class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-accent-color text-white hover:bg-opacity-90 transition-all">
              <span>Get in touch</span>
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            </a>
          </div>
        </div>
        
        <!-- Profile Image -->
        <div class="lg:w-2/5 flex justify-center">
          <div class="relative">
            <!-- Decorative elements around image -->
            <div class="absolute -top-4 -right-4 w-24 h-24 border-2 border-secondary-color rounded-full"></div>
            <div class="absolute -bottom-4 -left-4 w-16 h-16 border-2 border-accent-color rounded-full"></div>
            
            <!-- Main image with fancy border -->
            <div class="relative z-10 rounded-2xl overflow-hidden border-4 border-white dark:border-gray-800 shadow-2xl transform hover:rotate-2 transition-transform duration-300">
              <img 
                src={meImage.src} 
                alt="Alex Norum" 
                class="w-64 sm:w-80 object-cover"
                loading="eager"
              />
              
              <!-- Overlay gradient -->
              <div class="absolute inset-0 bg-gradient-to-t from-black/30 to-transparent"></div>
            </div>
          </div>
        </div>
      </div>
    </div>
    
    <!-- Scroll indicator -->
    <div class="absolute bottom-8 left-1/2 transform -translate-x-1/2 flex flex-col items-center animate-bounce">
      <span class="text-xs text-muted mb-2">Scroll to explore</span>
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-accent-color" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
      </svg>
    </div>
  </section>

  <!-- What I Do Section -->
  <section class="py-16 bg-white/5 border-y border-white/10">
    <div class="container max-w-6xl mx-auto px-4">
      <div class="max-w-4xl mx-auto">
        <div class="flex items-center gap-3 mb-6">
          <div class="h-px flex-1 bg-accent-color opacity-30"></div>
          <h2 class="text-2xl sm:text-3xl font-bold whitespace-nowrap">What I Do</h2>
          <div class="h-px flex-1 bg-accent-color opacity-30"></div>
        </div>
        
        <div class="space-y-6">
          <p class="text-md sm:text-lg text-muted leading-relaxed">
            I lead the <span class="font-semibold text-accent-color">Data Platform Engineering</span> team at LegalZoom, focused on building reliable, secure, and self-service data infrastructure with tools like Snowflake, Airflow, and Terraform.
          </p>
          
          <p class="text-md sm:text-lg text-muted leading-relaxed">
            My work lives at the intersection of <span class="italic">platform engineering and enablement</span> — delivering reusable building blocks and strong foundations for teams to move fast with confidence.
          </p>
          
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mt-10">
            <div class="p-6 rounded-xl bg-bubble-bg border border-border-color hover:transform hover:-translate-y-1 transition-all">
              <div class="w-12 h-12 rounded-full bg-accent-color bg-opacity-20 flex items-center justify-center mb-4">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-accent-color" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
                </svg>
              </div>
              <h3 class="text-xl font-semibold mb-2">Data Architecture</h3>
              <p class="text-muted">Designing scalable data systems that balance performance, cost, and maintainability.</p>
            </div>
            
            <div class="p-6 rounded-xl bg-bubble-bg border border-border-color hover:transform hover:-translate-y-1 transition-all">
              <div class="w-12 h-12 rounded-full bg-secondary-color bg-opacity-20 flex items-center justify-center mb-4">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-secondary-color" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                </svg>
              </div>
              <h3 class="text-xl font-semibold mb-2">Platform Engineering</h3>
              <p class="text-muted">Building self-service tools and platforms that empower teams to work efficiently.</p>
            </div>
            
            <div class="p-6 rounded-xl bg-bubble-bg border border-border-color hover:transform hover:-translate-y-1 transition-all">
              <div class="w-12 h-12 rounded-full bg-tertiary-color bg-opacity-20 flex items-center justify-center mb-4">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-tertiary-color" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
                </svg>
              </div>
              <h3 class="text-xl font-semibold mb-2">Team Leadership</h3>
              <p class="text-muted">Growing engineering talent and fostering a culture of collaboration and innovation.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Work Experience Timeline -->
  <section class="py-16" id="experience">
    <div class="container max-w-6xl mx-auto px-4">
      <div class="max-w-4xl mx-auto">
        <div class="flex items-center gap-3 mb-10">
          <div class="h-px flex-1 bg-accent-color opacity-30"></div>
          <h2 class="text-2xl sm:text-3xl font-bold whitespace-nowrap">Work Experience</h2>
          <div class="h-px flex-1 bg-accent-color opacity-30"></div>
        </div>
        
        <!-- Custom timeline wrapper with horizontal scroll indicator -->
        <div class="relative">
          <!-- Timeline progress bar -->
          <div class="absolute left-0 top-6 w-full h-1 bg-gray-200 dark:bg-gray-700 rounded-full overflow-hidden">
            <div class="h-full bg-accent-color w-0 timeline-progress"></div>
          </div>
          
          <!-- Timeline component -->
          <div class="pt-10">
            <Timeline />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Skills Section -->
  <section class="py-16 bg-white/5 border-y border-white/10" id="skills">
    <div class="container max-w-6xl mx-auto px-4">
      <div class="max-w-4xl mx-auto">
        <div class="flex items-center gap-3 mb-10">
          <div class="h-px flex-1 bg-accent-color opacity-30"></div>
          <h2 class="text-2xl sm:text-3xl font-bold whitespace-nowrap">Core Skills</h2>
          <div class="h-px flex-1 bg-accent-color opacity-30"></div>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <!-- Data Engineering Skills -->
          <div class="skills-category">
            <div class="flex items-center gap-3 mb-4">
              <div class="w-10 h-10 rounded-full bg-blue-100 dark:bg-blue-900 flex items-center justify-center">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-blue-800 dark:text-blue-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4m0 5c0 2.21-3.582 4-8 4s-8-1.79-8-4" />
                </svg>
              </div>
              <h3 class="text-xl font-semibold">Data Engineering</h3>
            </div>
            
            <SkillsGroup 
              title="Data Platforms" 
              skills={["Snowflake", "BigQuery", "Redshift", "Databricks"]}
              colorScheme="blue"
            />
            
            <div class="h-4"></div>
            
            <SkillsGroup 
              title="Data Processing" 
              skills={["Airflow", "dbt", "Spark", "Kafka"]}
              colorScheme="blue"
            />
          </div>
          
          <!-- Infrastructure Skills -->
          <div class="skills-category">
            <div class="flex items-center gap-3 mb-4">
              <div class="w-10 h-10 rounded-full bg-green-100 dark:bg-green-900 flex items-center justify-center">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-green-800 dark:text-green-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
                </svg>
              </div>
              <h3 class="text-xl font-semibold">Infrastructure</h3>
            </div>
            
            <SkillsGroup 
              title="Cloud & DevOps" 
              skills={["AWS", "GCP", "Terraform", "Kubernetes"]}
              colorScheme="green"
            />
            
            <div class="h-4"></div>
            
            <SkillsGroup 
              title="Monitoring & Reliability" 
              skills={["Datadog", "Prometheus", "Grafana", "SLOs"]}
              colorScheme="green"
            />
          </div>
          
          <!-- Leadership Skills -->
          <div class="skills-category md:col-span-2">
            <div class="flex items-center gap-3 mb-4">
              <div class="w-10 h-10 rounded-full bg-purple-100 dark:bg-purple-900 flex items-center justify-center">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-purple-800 dark:text-purple-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
                </svg>
              </div>
              <h3 class="text-xl font-semibold">Leadership & Strategy</h3>
            </div>
            
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <SkillsGroup 
                title="Team Leadership" 
                skills={["Engineering Management", "Mentoring", "Technical Roadmaps", "Cross-team Collaboration"]}
                colorScheme="purple"
              />
              
              <SkillsGroup 
                title="Strategic Planning" 
                skills={["System Design", "Technical Strategy", "Process Optimization", "Stakeholder Management"]}
                colorScheme="purple"
              />
            </div>
          </div>
        </div>
        
        <!-- Interactive skills visualization -->
        <div class="mt-12 p-6 rounded-xl bg-bubble-bg border border-border-color">
          <h3 class="text-xl font-semibold mb-4">My Engineering Philosophy</h3>
          
          <ul class="space-y-4 text-muted">
            <li class="flex items-start gap-3 transform hover:-translate-x-1 transition-transform">
              <span class="text-2xl">💡</span>
              <span>Build for scale, not for today.</span>
            </li>
            <li class="flex items-start gap-3 transform hover:-translate-x-1 transition-transform">
              <span class="text-2xl">🧠</span>
              <span>Simplicity wins. Always.</span>
            </li>
            <li class="flex items-start gap-3 transform hover:-translate-x-1 transition-transform">
              <span class="text-2xl">⚙️</span>
              <span>Invest in good defaults and strong foundations.</span>
            </li>
            <li class="flex items-start gap-3 transform hover:-translate-x-1 transition-transform">
              <span class="text-2xl">🤝</span>
              <span>Tools should enable, not obstruct.</span>
            </li>
            <li class="flex items-start gap-3 transform hover:-translate-x-1 transition-transform">
              <span class="text-2xl">📈</span>
              <span>Everything is an experiment — track it and learn.</span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Beyond Work Section -->
  <section class="py-16" id="beyond-work">
    <div class="container max-w-6xl mx-auto px-4">
      <div class="max-w-4xl mx-auto">
        <div class="flex items-center gap-3 mb-10">
          <div class="h-px flex-1 bg-accent-color opacity-30"></div>
          <h2 class="text-2xl sm:text-3xl font-bold whitespace-nowrap">Beyond Work</h2>
          <div class="h-px flex-1 bg-accent-color opacity-30"></div>
        </div>
        
        <p class="text-muted mb-8">
          I track everything from my running to my reading to my golf swing. I believe data can deepen hobbies, not just work.
        </p>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <InterestItem
            title="Running & Fitness"
            description="Exploring trails around Forest Park and tracking my progress with data."
            icon='<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" /></svg>'
            colorScheme="green"
          >
            <div class="mt-3 text-sm">
              <a href="/stats" class="text-green-700 dark:text-green-400 hover:underline inline-flex items-center gap-1">
                <span>View my running stats</span>
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </a>
            </div>
          </InterestItem>
          
          <InterestItem
            title="Golf"
            description="Tracking stats and rebuilding my swing with data-driven insights."
            icon='<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" /></svg>'
            colorScheme="blue"
          >
            <div class="mt-3 text-sm">
              <a href="/stats" class="text-blue-700 dark:text-blue-400 hover:underline inline-flex items-center gap-1">
                <span>View my golf stats</span>
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </a>
            </div>
          </InterestItem>
          
          <InterestItem
            title="Reading"
            description="Murakami, sci-fi, philosophy, and data science books."
            icon='<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" /></svg>'
            colorScheme="purple"
          >
            <div class="mt-3 text-sm">
              <a href="/stats" class="text-purple-700 dark:text-purple-400 hover:underline inline-flex items-center gap-1">
                <span>See what I'm reading</span>
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </a>
            </div>
          </InterestItem>
          
          <InterestItem
            title="Cooking"
            description="Japanese comfort food and experimenting with new recipes."
            icon='<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v13m0-13V6a2 2 0 112 2h-2zm0 0V5.5A2.5 2.5 0 109.5 8H12zm-7 4h14M5 12a2 2 0 110-4h14a2 2 0 110 4M5 12v7a2 2 0 002 2h10a2 2 0 002-2v-7" /></svg>'
            colorScheme="yellow"
          />
        </div>
        
        <!-- Travel visualization teaser -->
        <div class="mt-10 p-6 rounded-xl bg-bubble-bg border border-border-color overflow-hidden">
          <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 mb-4">
            <h3 class="text-xl font-semibold">Places I've Been</h3>
            <a href="/stats" class="text-sm text-accent-color hover:underline inline-flex items-center gap-1">
              <span>View detailed travel stats</span>
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </a>
          </div>
          
          <div class="relative h-64 bg-gray-100 dark:bg-gray-800 rounded-lg overflow-hidden">
            <div class="absolute inset-0 flex items-center justify-center">
              <TravelMap client:only="react" travelData={[]}/>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Mara AI Assistant Section -->
  <section class="py-16 bg-white/5 border-t border-white/10" id="chat">
    <div class="container max-w-6xl mx-auto px-4">
      <div class="max-w-4xl mx-auto">
        <div class="flex items-center gap-3 mb-10">
          <div class="h-px flex-1 bg-accent-color opacity-30"></div>
          <h2 class="text-2xl sm:text-3xl font-bold whitespace-nowrap">Chat with Mara</h2>
          <div class="h-px flex-1 bg-accent-color opacity-30"></div>
        </div>
        
        <div class="relative">
          <!-- Decorative elements -->
          <div class="absolute -top-10 -right-10 w-20 h-20 border-2 border-secondary-color rounded-full opacity-20"></div>
          <div class="absolute -bottom-5 -left-5 w-16 h-16 border-2 border-accent-color rounded-full opacity-20"></div>
          
          <!-- Enhanced Mara Assistant -->
          <MaraAssistant />
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
/* Animation classes */
.animate-blob {
  animation: blob-bounce 7s infinite;
}

.animation-delay-2000 {
  animation-delay: 2s;
}

.animation-delay-4000 {
  animation-delay: 4s;
}

@keyframes blob-bounce {
  0% {
    transform: translate(0px, 0px) scale(1);
  }
  33% {
    transform: translate(30px, -50px) scale(1.1);
  }
  66% {
    transform: translate(-20px, 20px) scale(0.9);
  }
  100% {
    transform: translate(0px, 0px) scale(1);
  }
}

/* Timeline progress animation */
.timeline-progress {
  animation: timeline-progress 2s ease-out forwards;
}

@keyframes timeline-progress {
  0% {
    width: 0%;
  }
  100% {
    width: 100%;
  }
}

/* Fade in up animation for sections */
.animate-fade-in-up {
  animation: fadeInUp 0.8s ease-out forwards;
  opacity: 0;
}

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(20px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
</style>

<script>
// Intersection Observer for scroll animations
document.addEventListener('DOMContentLoaded', () => {
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('animate-fade-in-up');
        (entry.target as HTMLElement).style.opacity = '1';
      }
    });
  }, {
    threshold: 0.1
  });
  
  // Observe all sections
  document.querySelectorAll('section').forEach(section => {
    observer.observe(section);
  });
});
</script>
