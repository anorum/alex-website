---
import MainLayout from '../layouts/MainLayout.astro';
import SpotifyStats from '../components/SpotifyStats.astro';

// Get the time range from the URL query parameter, or default to short_term
const timeRange = Astro.url.searchParams.get('time_range');
const defaultTimeRange = timeRange || 'short_term';
---

<MainLayout title="Stats - Alex Norum" description="Personal statistics and data visualizations">
	<main>
		<section class="bg-white dark:bg-gray-900">
			<div class="py-8 px-4 mx-auto max-w-screen-xl lg:py-16">
				<!-- Hero Section -->
				<div class="flex flex-col items-center justify-center text-center py-12 md:py-16">
					<h1 class="text-4xl md:text-6xl font-extrabold text-gray-900 dark:text-white mb-6">
						<span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-600 to-purple-600">Stats</span>
					</h1>
					<p class="text-xl md:text-2xl font-light text-gray-500 dark:text-gray-400 mb-8 max-w-3xl">
						This page will be populated with statistics from various platforms like Spotify, Strava, and more.
					</p>
				</div>
				
				<!-- Stats Cards -->
				<div class="grid md:grid-cols-1 gap-8 mb-16">
					<!-- Spotify Stats -->
					<SpotifyStats defaultTimeRange={defaultTimeRange} />
					
					<!-- Strava Stats -->
					<div class="p-6 bg-white rounded-lg border-l-4 border-orange-600 shadow-md dark:bg-gray-800 dark:border-orange-500">
						<div class="flex items-center mb-4">
							<svg class="w-10 h-10 text-orange-600 dark:text-orange-400 me-4" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24">
								<path d="M15.387 17.944l-2.089-4.116h-3.065L15.387 24l5.15-10.172h-3.066m-7.008-5.599l2.836 5.598h4.172L10.463 0l-7 13.828h4.169"/>
							</svg>
							<h2 class="text-3xl font-bold text-gray-900 dark:text-white">Strava Stats</h2>
						</div>
						<p class="text-lg text-gray-500 dark:text-gray-400 mb-6">Coming soon! This section will display your Strava activity statistics.</p>
						
						<div class="grid grid-cols-2 gap-4">
							<div class="p-4 bg-gray-50 rounded-lg dark:bg-gray-700">
								<h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-2">Total Distance</h3>
								<p class="text-gray-500 dark:text-gray-400">Coming soon</p>
							</div>
							<div class="p-4 bg-gray-50 rounded-lg dark:bg-gray-700">
								<h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-2">Elevation Gain</h3>
								<p class="text-gray-500 dark:text-gray-400">Coming soon</p>
							</div>
							<div class="p-4 bg-gray-50 rounded-lg dark:bg-gray-700">
								<h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-2">Activity Time</h3>
								<p class="text-gray-500 dark:text-gray-400">Coming soon</p>
							</div>
							<div class="p-4 bg-gray-50 rounded-lg dark:bg-gray-700">
								<h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-2">Recent Activities</h3>
								<p class="text-gray-500 dark:text-gray-400">Coming soon</p>
							</div>
						</div>
					</div>
				</div>
				
				<!-- Additional Stats Section -->
				<div class="mb-16">
					<h2 class="text-3xl font-bold text-gray-900 dark:text-white mb-8 text-center">Other Platforms</h2>
					
					<div class="grid md:grid-cols-3 gap-6">
						<!-- GitHub Stats -->
						<div class="p-6 bg-white rounded-lg border-l-4 border-gray-600 shadow-md dark:bg-gray-800 dark:border-gray-500">
							<div class="flex items-center mb-4">
								<svg class="w-8 h-8 text-gray-600 dark:text-gray-400 me-3" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24">
									<path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" />
								</svg>
								<h3 class="text-xl font-semibold text-gray-900 dark:text-white">GitHub</h3>
							</div>
							<p class="text-gray-500 dark:text-gray-400">Coming soon! GitHub contribution stats and repository information.</p>
						</div>
						
						<!-- Goodreads Stats -->
						<div class="p-6 bg-white rounded-lg border-l-4 border-amber-600 shadow-md dark:bg-gray-800 dark:border-amber-500">
							<div class="flex items-center mb-4">
								<svg class="w-8 h-8 text-amber-600 dark:text-amber-400 me-3" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24">
									<path d="M19 4h-1a1 1 0 1 0 0 2v11a1 1 0 0 1-2 0V2a2 2 0 0 0-2-2H2a2 2 0 0 0-2 2v15a3 3 0 0 0 3 3h14a3 3 0 0 0 3-3V5a1 1 0 0 0-1-1Z"/>
								</svg>
								<h3 class="text-xl font-semibold text-gray-900 dark:text-white">Goodreads</h3>
							</div>
							<p class="text-gray-500 dark:text-gray-400">Coming soon! Book reading statistics and currently reading list.</p>
						</div>
						
						<!-- Twitter Stats -->
						<div class="p-6 bg-white rounded-lg border-l-4 border-blue-400 shadow-md dark:bg-gray-800 dark:border-blue-500">
							<div class="flex items-center mb-4">
								<svg class="w-8 h-8 text-blue-400 dark:text-blue-300 me-3" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24">
									<path d="M8.29 20.251c7.547 0 11.675-6.253 11.675-11.675 0-.178 0-.355-.012-.53A8.348 8.348 0 0022 5.92a8.19 8.19 0 01-2.357.646 4.118 4.118 0 001.804-2.27 8.224 8.224 0 01-2.605.996 4.107 4.107 0 00-6.993 3.743 11.65 11.65 0 01-8.457-4.287 4.106 4.106 0 001.27 5.477A4.072 4.072 0 012.8 9.713v.052a4.105 4.105 0 003.292 4.022 4.095 4.095 0 01-1.853.07 4.108 4.108 0 003.834 2.85A8.233 8.233 0 012 18.407a11.616 11.616 0 006.29 1.84" />
								</svg>
								<h3 class="text-xl font-semibold text-gray-900 dark:text-white">Twitter</h3>
							</div>
							<p class="text-gray-500 dark:text-gray-400">Coming soon! Twitter engagement and activity statistics.</p>
						</div>
					</div>
				</div>
			</div>
		</section>
	</main>
</MainLayout>
