---
import MainLayout from '../layouts/MainLayout.astro';
import SpotifyStats from '../components/SpotifyStats.astro';
import StravaStats from '../components/StravaStats.astro';
import { default as EighteenBirdiesStats } from '../components/18BirdiesStats.astro';
import GoodreadsStats from '../components/GoodreadsStats.astro';
import TravelStats from '../components/TravelStats.astro';

// Get the time range from the URL query parameter, or default to short_term
const timeRange = Astro.url.searchParams.get('time_range');
const defaultTimeRange = timeRange || 'short_term';

// Get the year for Goodreads stats from the URL query parameter
const year = Astro.url.searchParams.get('year');
---

<MainLayout title="Stats - Alex Norum" description="Personal statistics and data visualizations">
	<main>
		<section class="bg-white dark:bg-gray-900">
			<div class="py-8 px-4 mx-auto max-w-screen-xl lg:py-16">
				<!-- Hero Section -->
				<div class="flex flex-col items-center justify-center text-center py-12 md:py-16">
					<h1 class="text-4xl md:text-6xl font-extrabold text-gray-900 dark:text-white mb-6">
						<span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-600 to-purple-600">Stats</span>
					</h1>
					<p class="text-xl md:text-2xl font-light text-gray-500 dark:text-gray-400 mb-8 max-w-3xl">
						This page will be populated with statistics from various platforms like Spotify, Strava, and more.
					</p>
				</div>
				
				<!-- Stats Cards -->
				<div class="grid md:grid-cols-1 gap-8 mb-16">
					<!-- Travel Stats -->
					<TravelStats />
					
					<!-- Spotify Stats -->
					<SpotifyStats defaultTimeRange={defaultTimeRange} />
					
					<!-- Strava Stats -->
					<StravaStats />
					
					<!-- 18Birdies Stats -->
					<EighteenBirdiesStats />
					
					<!-- Goodreads Stats -->
					<GoodreadsStats defaultYear={year} />
					
				</div>
				
				<!-- Additional Stats Section -->
				<div class="mb-16">
					<h2 class="text-3xl font-bold text-gray-900 dark:text-white mb-8 text-center">Other Platforms</h2>
					
					<div class="grid md:grid-cols-2 gap-6">
						<!-- GitHub Stats -->
						<div class="p-6 bg-white rounded-lg border-l-4 border-gray-600 shadow-md dark:bg-gray-800 dark:border-gray-500">
							<div class="flex items-center mb-4">
								<svg class="w-8 h-8 text-gray-600 dark:text-gray-400 me-3" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24">
									<path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" />
								</svg>
								<h3 class="text-xl font-semibold text-gray-900 dark:text-white">GitHub</h3>
							</div>
							<p class="text-gray-500 dark:text-gray-400">Coming soon! GitHub contribution stats and repository information.</p>
						</div>
						
						<!-- LinkedIn Stats -->
						<div class="p-6 bg-white rounded-lg border-l-4 border-blue-600 shadow-md dark:bg-gray-800 dark:border-blue-500">
							<div class="flex items-center mb-4">
								<svg class="w-8 h-8 text-blue-600 dark:text-blue-400 me-3" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24">
									<path d="M20.5 2h-17A1.5 1.5 0 002 3.5v17A1.5 1.5 0 003.5 22h17a1.5 1.5 0 001.5-1.5v-17A1.5 1.5 0 0020.5 2zM8 19H5v-9h3zM6.5 8.25A1.75 1.75 0 118.3 6.5a1.78 1.78 0 01-1.8 1.75zM19 19h-3v-4.74c0-1.42-.6-1.93-1.38-1.93A1.74 1.74 0 0013 14.19a.66.66 0 000 .14V19h-3v-9h2.9v1.3a3.11 3.11 0 012.7-1.4c1.55 0 3.36.86 3.36 3.66z"></path>
								</svg>
								<h3 class="text-xl font-semibold text-gray-900 dark:text-white">LinkedIn</h3>
							</div>
							<p class="text-gray-500 dark:text-gray-400">Coming soon! Professional network and career statistics.</p>
						</div>
					</div>
				</div>
			</div>
		</section>
	</main>
</MainLayout>
